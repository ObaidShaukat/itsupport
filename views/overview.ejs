<%- include('partials/head') %>
<%#
  Section overview (/microsoft, /cloudflare, /inventory, /call-switch-one; src/routes/overview.js,
  src/lib/overview.js): one card per sub-section with an icon, a short description and 1-3 live
  numbers (a red LED when one needs attention). Click a card to open the sub-section.
%>
<header class="page-head reveal">
  <div>
    <%- include('partials/crumbs', { crumbs: [{ label: section.title }] }) %>
    <h1><%= section.title %></h1>
    <p class="muted"><%= section.intro %></p>
  </div>
</header>

<div class="ov-grid reveal">
  <% for (const c of section.cards) { %>
    <a href="<%= c.href %>" class="ov-card">
      <span class="ov-card-top">
        <span class="ov-icon" aria-hidden="true"><%- icon(c.icon) %></span>
        <span class="tile-arrow" aria-hidden="true"><%- icon('arrow-right') %></span>
      </span>
      <span class="ov-title"><%= c.title %></span>
      <span class="ov-desc"><%= c.description %></span>
      <% if (c.stats.length) { %>
        <span class="ov-stats">
          <% for (const s of c.stats) { %>
            <span class="ov-stat <%= s.alert ? 'is-alert' : '' %>">
              <span class="ov-num"><% if (s.alert) { %><span class="led led-urgent" aria-hidden="true"></span><% } %><span data-count="<%= s.value %>"><%= s.value %></span></span>
              <span class="ov-label"><%= s.label %></span>
            </span>
          <% } %>
        </span>
      <% } %>
    </a>
  <% } %>
</div>
<%- include('partials/foot') %>
