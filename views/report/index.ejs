<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Daily Report</h1>
    <p class="muted"><%= periodLabel %></p>
  </div>
  <div class="actions">
    <a href="/activity?date=<%= from %><%= view === 'me' ? `&user=${currentUser.id}` : view !== 'all' ? `&user=${view}` : '' %>" class="btn btn-ghost"><%- icon('clock') %><span>Activity log</span></a>
    <button type="button" class="btn" data-copy="text" <%= report.days.length ? '' : 'disabled' %>><%- icon('copy') %><span>Copy plain text</span></button>
    <button type="button" class="btn btn-primary" data-copy="html" <%= report.days.length ? '' : 'disabled' %>><%- icon('copy') %><span>Copy for email</span></button>
  </div>
</header>

<section class="card report-controls">
  <div class="report-nav">
    <a href="<%= prevHref %>" class="icon-btn" title="Previous <%= unit %>" aria-label="Previous <%= unit %>"><%- icon('left') %></a>
    <form method="get" action="/report" class="inline-form report-form">
      <label class="field">
        <span>From</span>
        <input type="date" name="from" value="<%= from %>" required>
      </label>
      <label class="field">
        <span>To <span class="muted">(for a range)</span></span>
        <input type="date" name="to" value="<%= to === from ? '' : to %>">
      </label>
      <label class="field">
        <span>View</span>
        <select name="view" data-autosubmit>
          <option value="me" <%= view === 'me' ? 'selected' : '' %>>My report</option>
          <option value="all" <%= view === 'all' ? 'selected' : '' %>>All team</option>
          <optgroup label="Someone else">
            <% for (const u of users) { if (u.id === currentUser.id) continue; %>
              <option value="<%= u.id %>" <%= view === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
            <% } %>
          </optgroup>
        </select>
      </label>
      <button type="submit" class="btn">Show</button>
    </form>
    <a href="<%= nextHref %>" class="icon-btn" title="Next <%= unit %>" aria-label="Next <%= unit %>"><%- icon('right') %></a>
  </div>
  <nav class="filters report-presets" aria-label="Quick dates">
    <% for (const p of presets) { %>
      <a href="<%= p.href %>" class="<%= p.active ? 'active' : '' %>"><%= p.label %></a>
    <% } %>
  </nav>
  <% if (notice) { %><p class="muted small"><%= notice %></p><% } %>
</section>

<section class="card report">
  <% if (!report.days.length) { %>
    <p class="empty"><%= view === 'me' ? 'You have no activity' : view === 'all' ? 'Nobody has any activity' : 'No activity' %> recorded <%= from === to ? 'on this day' : 'in this period' %>.</p>
  <% } else { %>
    <div class="report-preview-head">
      <p class="muted small"><%- icon('edit') %> Preview. Click any line to edit it before copying. Edits are not saved; reload to start again.</p>
    </div>
    <div class="report-preview" contenteditable="true" spellcheck="true" data-report-preview>
      <% for (const day of report.days) { %>
        <div class="report-day" data-report-day>
          <% if (report.multiDay) { %><h2 class="report-day-title" data-report-day-title><%= day.label %></h2><% } %>
          <% for (const u of day.users) { %>
            <div class="report-user" data-report-user>
              <h3 data-report-heading><%= u.heading %></h3>
              <ul>
                <% for (const line of u.lines) { %><li><%= line %></li><% } %>
              </ul>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>
  <p class="copy-status small" data-copy-status role="status" hidden></p>
</section>

<section class="card">
  <div class="card-head">
    <h2>Your logged work</h2>
    <a href="/log-work?back=<%= encodeURIComponent(backPath) %>" class="btn btn-small" data-log-work><%- icon('plus') %><span>Log work</span></a>
  </div>
  <% if (!manual.length) { %>
    <p class="empty">You haven't logged any manual work <%= from === to ? 'for this day' : 'in this period' %>.</p>
  <% } else { %>
    <ul class="rows">
      <% for (const m of manual) { %>
        <li class="row">
          <div class="row-main">
            <div class="pre-line"><%= m.summary %></div>
            <div class="muted small"><%= m.activity_date %><% if (m.client_name) { %> · <%= m.client_name %><% } %></div>
          </div>
          <div class="row-actions">
            <details class="edit">
              <summary class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></summary>
              <div class="edit-panel">
                <form method="post" action="/log-work/<%= m.id %>" class="form">
                  <%- csrfField %>
                  <input type="hidden" name="back" value="<%= backPath %>">
                  <label class="field">
                    <span>Client <span class="muted">(optional)</span></span>
                    <input type="text" name="client" value="<%= m.client_name || '' %>" list="log-work-clients" autocomplete="off" maxlength="200">
                  </label>
                  <label class="field">
                    <span>Description</span>
                    <textarea name="description" rows="3" maxlength="2000"><%= m.summary %></textarea>
                  </label>
                  <label class="field">
                    <span>Date</span>
                    <input type="date" name="date" value="<%= m.activity_date %>" required>
                  </label>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                  </div>
                </form>
              </div>
            </details>
            <form method="post" action="/log-work/<%= m.id %>/delete" class="inline" data-confirm="Delete this logged work?">
              <%- csrfField %>
              <input type="hidden" name="back" value="<%= backPath %>">
              <button type="submit" class="icon-btn icon-btn-danger" title="Delete" aria-label="Delete"><%- icon('trash') %></button>
            </form>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>

<%- include('../partials/foot') %>
