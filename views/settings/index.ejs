<%
  const SAMPLE_CLIENT = 'ASL Solicitors';
  const sample = (template, subjects) => {
    const t = String(template).replace(/\{client\}/g, SAMPLE_CLIENT).replace(/\{subjects\}/g, subjects).replace(/[.\s]+$/, '').trim();
    return t ? `${t.charAt(0).toUpperCase()}${t.slice(1)}.` : '';
  };
  const actionPreview = (a) => sample(a.template, a.phrase_type === 'config' ? 'Outlook profiles and mailboxes' : 'Outlook connectivity and mailbox');
  const issuePreview = (i) => `${sample('Resolved {subjects} issues for {client}.', i.problem_phrase)}  /  ${sample('Configured {subjects} for {client}.', i.config_phrase)}`;
%>
<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Settings</h1>
    <p class="muted">Wording used to build the Daily Report. Pick an action and an issue on comments, notes and Log work, and the report fills in these templates.</p>
  </div>
</header>

<section class="card" id="actions">
  <div class="card-head">
    <div>
      <h2>Report actions</h2>
      <p class="muted small">Templates use <code>{client}</code> and <code>{subjects}</code>. "Problem" actions use an issue's problem phrase; "Config" actions use its configuration phrase.</p>
    </div>
  </div>

  <details class="report-toggle settings-add">
    <summary><%- icon('plus') %> Add action</summary>
    <form method="post" action="/settings/actions" class="form" data-term-preview="action">
      <%- csrfField %>
      <div class="form-row">
        <label class="field"><span>Name</span><input type="text" name="name" required maxlength="100" placeholder="e.g. Repaired"></label>
        <label class="field">
          <span>Phrase type</span>
          <select name="phrase_type"><option value="problem">Problem</option><option value="config">Config</option></select>
        </label>
      </div>
      <label class="field"><span>Template</span><input type="text" name="template" required maxlength="255" placeholder="Repaired {subjects} for {client}."></label>
      <p class="term-preview">Preview: <span data-preview-output>—</span></p>
      <div><button type="submit" class="btn btn-primary">Add action</button></div>
    </form>
  </details>

  <% if (!actions.length) { %>
    <p class="empty">No actions yet. Run <code>npm run seed</code> to add the defaults.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table table-terms">
        <thead><tr><th>Name</th><th>Type</th><th>Template</th><th>Preview</th><th></th></tr></thead>
        <tbody>
          <% for (const a of actions) { %>
            <tr>
              <td><strong><%= a.name %></strong></td>
              <td><span class="chip <%= a.phrase_type === 'config' ? 'chip-category' : '' %>"><%= a.phrase_type === 'config' ? 'Config' : 'Problem' %></span></td>
              <td><code><%= a.template %></code></td>
              <td class="muted small"><%= actionPreview(a) %></td>
              <td class="row-actions">
                <details class="edit">
                  <summary class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></summary>
                  <div class="edit-panel">
                    <form method="post" action="/settings/actions/<%= a.id %>" class="form" data-term-preview="action">
                      <%- csrfField %>
                      <label class="field"><span>Name</span><input type="text" name="name" value="<%= a.name %>" required maxlength="100"></label>
                      <label class="field">
                        <span>Phrase type</span>
                        <select name="phrase_type">
                          <option value="problem" <%= a.phrase_type === 'problem' ? 'selected' : '' %>>Problem</option>
                          <option value="config" <%= a.phrase_type === 'config' ? 'selected' : '' %>>Config</option>
                        </select>
                      </label>
                      <label class="field"><span>Template</span><input type="text" name="template" value="<%= a.template %>" required maxlength="255"></label>
                      <p class="term-preview">Preview: <span data-preview-output><%= actionPreview(a) %></span></p>
                      <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                      </div>
                    </form>
                  </div>
                </details>
                <%- include('../partials/delete', { action: `/settings/actions/${a.id}/delete`, confirm: `Delete the action "${a.name}"? Entries that used it fall back to the default wording.` }) %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card" id="issues">
  <div class="card-head">
    <div>
      <h2>Report issues</h2>
      <p class="muted small">The problem phrase fills problem actions ("Resolved … issues"); the configuration phrase fills config actions ("Configured …"). Issues typed on a form are added here automatically.</p>
    </div>
  </div>

  <details class="report-toggle settings-add">
    <summary><%- icon('plus') %> Add issue</summary>
    <form method="post" action="/settings/issues" class="form" data-term-preview="issue">
      <%- csrfField %>
      <label class="field"><span>Name</span><input type="text" name="name" required maxlength="100" placeholder="e.g. Xero"></label>
      <div class="form-row">
        <label class="field"><span>Problem phrase</span><input type="text" name="problem_phrase" maxlength="255" placeholder="Xero login and access"></label>
        <label class="field"><span>Configuration phrase</span><input type="text" name="config_phrase" maxlength="255" placeholder="Xero user access"></label>
      </div>
      <p class="term-preview">Preview: <span data-preview-output>—</span></p>
      <div><button type="submit" class="btn btn-primary">Add issue</button></div>
    </form>
  </details>

  <%- include('../partials/search', { target: '#issue-list', placeholder: 'Search issues' }) %>
  <div id="issue-list">
    <% if (!issues.length) { %>
      <p class="empty">No issues yet. Run <code>npm run seed</code> to add the defaults.</p>
    <% } else { %>
      <p class="empty" data-filter-empty hidden>No issues match your search.</p>
      <div class="table-wrap">
        <table class="table table-terms">
          <thead><tr><th>Name</th><th>Problem phrase</th><th>Configuration phrase</th><th>Preview</th><th></th></tr></thead>
          <tbody>
            <% for (const i of issues) { %>
              <tr data-filter-item data-search="<%= i.name %> <%= i.problem_phrase %> <%= i.config_phrase %>">
                <td><strong><%= i.name %></strong></td>
                <td><%= i.problem_phrase %></td>
                <td><%= i.config_phrase %></td>
                <td class="muted small"><%= issuePreview(i) %></td>
                <td class="row-actions">
                  <details class="edit">
                    <summary class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></summary>
                    <div class="edit-panel">
                      <form method="post" action="/settings/issues/<%= i.id %>" class="form" data-term-preview="issue">
                        <%- csrfField %>
                        <label class="field"><span>Name</span><input type="text" name="name" value="<%= i.name %>" required maxlength="100"></label>
                        <label class="field"><span>Problem phrase</span><input type="text" name="problem_phrase" value="<%= i.problem_phrase %>" maxlength="255"></label>
                        <label class="field"><span>Configuration phrase</span><input type="text" name="config_phrase" value="<%= i.config_phrase %>" maxlength="255"></label>
                        <p class="term-preview">Preview: <span data-preview-output><%= issuePreview(i) %></span></p>
                        <div class="form-actions">
                          <button type="submit" class="btn btn-primary">Save</button>
                          <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                        </div>
                      </form>
                    </div>
                  </details>
                  <%- include('../partials/delete', { action: `/settings/issues/${i.id}/delete`, confirm: `Delete the issue "${i.name}"?` }) %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/foot') %>
