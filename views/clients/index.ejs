<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Clients</h1>
  </div>
  <div class="actions">
    <a href="/clients/new" class="btn btn-primary"><%- icon('plus') %><span>New client</span></a>
  </div>
</header>

<%- include('../partials/search', { target: '#client-list', placeholder: 'Search by name, contact, email or phone' }) %>

<section class="card" id="client-list">
  <% if (!clients.length) { %>
    <p class="empty">No clients yet.</p>
  <% } else { %>
    <p class="empty" data-filter-empty hidden>No clients match your search.</p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th class="w-25">Name</th>
            <th>Contact</th>
            <th class="w-25">Email</th>
            <th class="w-md">Phone</th>
            <th class="num w-md">Active tickets</th>
            <th class="num w-md">Open services</th>
          </tr>
        </thead>
        <tbody>
          <% for (const c of clients) { %>
            <tr data-filter-item data-search="<%= [c.name, c.contact_name, c.email, c.phone].filter(Boolean).join(' ') %>">
              <td><a href="/clients/<%= c.id %>"><strong><%= c.name %></strong></a></td>
              <td><%= c.contact_name || '' %></td>
              <td><% if (c.email) { %><a href="mailto:<%= c.email %>"><%= c.email %></a><% } %></td>
              <td class="nowrap"><%= c.phone || '' %></td>
              <td class="num"><%= Number(c.active_tickets) %></td>
              <td class="num"><%= Number(c.open_services) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/foot') %>
