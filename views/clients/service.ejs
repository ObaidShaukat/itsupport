<%- include('../partials/head') %>
<%#
  A client's assigned service as a journey (GET /client-services/:id): header with progress,
  the stage cards (tick a step to mark it done: same toggle as before), the notes log, the
  History and the client's other services.
%>
<% const page = `/client-services/${cs.id}`; %>
<header class="page-head reveal">
  <div>
    <p class="crumbs"><a href="/clients">Clients</a> / <a href="/clients/<%= cs.client_id %>#services"><%= cs.client_name %></a></p>
    <h1><%= cs.service_name %></h1>
    <div class="journey-progress">
      <span class="journey-progress-text"><strong><%= journey.done %> of <%= journey.total %></strong> steps done</span>
      <div class="progress progress-lg" role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="<%= journey.total %>" aria-valuenow="<%= journey.done %>"><span style="--w: <%= journey.percent %>%"></span></div>
      <%- include('../partials/status', { status: cs.status }) %>
    </div>
    <%- include('../partials/record-meta', { meta }) %>
  </div>
  <div class="actions">
    <a href="#notes" class="btn btn-secondary" data-focus-note><%- icon('plus') %><span>Add note</span></a>
    <% if (cs.status === 'closed') { %>
      <form method="post" action="/client-services/<%= cs.id %>/reopen" class="inline">
        <%- csrfField %>
        <input type="hidden" name="back" value="<%= page %>">
        <button type="submit" class="btn btn-secondary">Reopen</button>
      </form>
    <% } else { %>
      <form method="post" action="/client-services/<%= cs.id %>/close" class="inline">
        <%- csrfField %>
        <input type="hidden" name="back" value="<%= page %>">
        <button type="submit" class="btn <%= journey.total ? 'btn-secondary' : 'btn-primary' %>"><%- icon('check') %><span>Mark as closed</span></button>
      </form>
    <% } %>
    <%- include('../partials/delete', { action: `/client-services/${cs.id}/delete`, confirm: `Remove "${cs.service_name}" and its checklist from ${cs.client_name}?`, label: 'Remove this service from the client' }) %>
  </div>
</header>

<section class="panel journey-panel reveal" aria-labelledby="journey-title">
  <h2 id="journey-title" class="visually-hidden">Steps</h2>
  <% if (!journey.total) { %>
    <p class="empty">This service has no checklist. Mark it as closed when the work is done.</p>
  <% } else { %>
    <div class="journey-scroll">
      <%- include('../partials/journey', {
        journey,
        toggleUrl: (s) => `/client-services/${cs.id}/steps/${s.id}/toggle`,
        back: page,
      }) %>
    </div>
  <% } %>
</section>

<div class="grid-2 grid-wide-left">
  <section class="panel reveal" id="notes" aria-labelledby="notes-title">
    <div class="section-head">
      <h2 id="notes-title">Notes <% if (notes.length) { %><span class="muted small">(<%= notes.length %>)</span><% } %></h2>
    </div>
    <form method="post" action="/client-services/<%= cs.id %>/notes" class="form note-form">
      <%- csrfField %>
      <input type="hidden" name="back" value="<%= page %>#notes">
      <label class="field">
        <span class="visually-hidden">New note</span>
        <textarea name="body" rows="2" required maxlength="10000" placeholder="e.g. Laptop for Kay, serial ABC123" data-autogrow></textarea>
      </label>
      <div><button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Add note</span></button></div>
    </form>
    <% if (!notes.length) { %>
      <p class="empty small">No notes yet.</p>
    <% } else { %>
      <ul class="note-list">
        <% for (const note of notes) { %>
          <li class="note" id="note-<%= note.id %>">
            <div class="note-head">
              <span class="person"><%- avatar({ id: note.user_id, name: note.author }, 'sm') %><strong class="note-author"><%= note.author || 'Deleted user' %></strong></span>
              <span class="muted small"><%= fmtDate(note.created_at) %><% if (note.updated_at) { %> · edited <%= fmtDate(note.updated_at) %><% if (note.editor) { %> by <%= note.editor %><% } %><% } %></span>
              <div class="row-actions">
                <details class="edit edit-right">
                  <summary class="icon-btn" title="Edit note" aria-label="Edit note"><%- icon('edit') %></summary>
                  <div class="edit-panel">
                    <form method="post" action="/client-service-notes/<%= note.id %>" class="form">
                      <%- csrfField %>
                      <input type="hidden" name="back" value="<%= page %>#notes">
                      <label class="field">
                        <span>Note</span>
                        <textarea name="body" rows="4" required maxlength="10000"><%= note.body %></textarea>
                      </label>
                      <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                      </div>
                    </form>
                  </div>
                </details>
                <%- include('../partials/delete', { action: `/client-service-notes/${note.id}/delete`, confirm: 'Delete this note?', back: `${page}#notes`, label: 'Delete note' }) %>
              </div>
            </div>
            <p class="pre-line"><%= note.body %></p>
          </li>
        <% } %>
      </ul>
    <% } %>
    <%- include('../partials/history', { entries: history.slice().reverse() }) %>
  </section>

  <aside class="panel panel-dark reveal" aria-labelledby="others-title">
    <h2 id="others-title">Other services</h2>
    <% if (!others.length) { %>
      <p class="small">No other services assigned to <%= cs.client_name %>.</p>
    <% } else { %>
      <ul class="other-services">
        <% for (const o of others) { const pct = o.step_count ? Math.round((o.done_count / o.step_count) * 100) : 0; %>
          <li>
            <a href="/client-services/<%= o.id %>">
              <span class="other-name"><%= o.service_name %><% if (o.status === 'closed') { %> <span class="small">· closed</span><% } %></span>
              <span class="other-count small"><%= o.step_count ? `${o.done_count}/${o.step_count}` : 'No checklist' %></span>
              <span class="progress progress-light" aria-hidden="true"><span style="--w: <%= pct %>%"></span></span>
            </a>
          </li>
        <% } %>
      </ul>
    <% } %>
    <a href="/clients/<%= cs.client_id %>#services" class="btn btn-light btn-small">All of <%= cs.client_name %>'s services <%- icon('arrow-right') %></a>
  </aside>
</div>
<%- include('../partials/foot') %>
