<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/clients">Clients</a></p>
    <h1><%= client.name %></h1>
    <%- include('../partials/record-meta', { meta: clientMeta }) %>
  </div>
  <div class="actions">
    <a href="/clients/<%= client.id %>/edit" class="btn"><%- icon('edit') %><span>Edit</span></a>
    <%- include('../partials/delete', {
      action: `/clients/${client.id}/delete`,
      confirm: `Delete "${client.name}"? This also deletes their tickets and service checklists.`,
      text: 'Delete',
    }) %>
  </div>
</header>

<section class="card">
  <dl class="details">
    <div><dt>Contact</dt><dd><%= client.contact_name || '—' %></dd></div>
    <div><dt>Email</dt><dd><% if (client.email) { %><a href="mailto:<%= client.email %>"><%= client.email %></a><% } else { %>—<% } %></dd></div>
    <div><dt>Phone</dt><dd><%= client.phone || '—' %></dd></div>
    <div><dt>Added</dt><dd><%= fmtDate(client.created_at) %></dd></div>
  </dl>
  <% if (client.notes) { %>
    <h3>Notes</h3>
    <p class="pre-line"><%= client.notes %></p>
  <% } %>
</section>

<% if (gdap.length) { %><%- include('../partials/gdap-card', { gdap }) %><% } %>
<% if (locals.domains && domains.length) { %><%- include('../partials/cf-domains-card', { domains, clientId: client.id }) %><% } %>

<section class="section" id="services">
  <div class="section-head">
    <h2>Services</h2>
    <form method="post" action="/clients/<%= client.id %>/services" class="inline-form">
      <%- csrfField %>
      <label class="field">
        <span class="visually-hidden">Service to assign</span>
        <select name="service_id" required>
          <option value="">Choose a service…</option>
          <% for (const group of serviceGroups) { %>
            <optgroup label="<%= group.name %>">
              <% for (const s of group.services) { %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% } %>
            </optgroup>
          <% } %>
        </select>
      </label>
      <button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Assign</span></button>
    </form>
  </div>

  <% if (!clientServices.length) { %>
    <p class="empty card">No services assigned yet.</p>
  <% } %>
  <div class="cs-grid">
    <% for (const cs of clientServices) { const j = cs.journey; %>
      <a href="/client-services/<%= cs.id %>" class="card cs-card <%= cs.status === 'closed' ? 'is-closed' : '' %>" id="cs-<%= cs.id %>">
        <div class="card-head">
          <h3><%= cs.service_name %></h3>
          <%- include('../partials/status', { status: cs.status }) %>
        </div>
        <% if (j.total) { %>
          <div class="progress" role="progressbar" aria-label="<%= cs.service_name %> progress" aria-valuemin="0" aria-valuemax="<%= j.total %>" aria-valuenow="<%= j.done %>"><span style="--w: <%= j.percent %>%"></span></div>
          <p class="muted small"><%= j.done %> of <%= j.total %> steps done · <%= j.groups.length %> stage<%= j.groups.length === 1 ? '' : 's' %></p>
        <% } else { %>
          <p class="muted small">No checklist</p>
        <% } %>
        <p class="cs-card-foot small"><span class="muted">Assigned by <%= cs.assigned_by || 'Deleted user' %> · <%= fmtShort(cs.created_at) %><%= cs.notes.length ? ` · ${cs.notes.length} note${cs.notes.length === 1 ? '' : 's'}` : '' %></span><span class="tile-arrow" aria-hidden="true"><%- icon('arrow-right') %></span></p>
      </a>
    <% } %>
  </div>
</section>

<section class="section" id="tickets">
  <div class="section-head">
    <h2>Tickets</h2>
    <a href="/tickets/new?client_id=<%= client.id %>" class="btn btn-primary"><%- icon('plus') %><span>New ticket</span></a>
  </div>
  <div class="card" id="client-tickets" data-list>
    <%- include('../partials/ticket-filters', { controls: ticketControls, search: { placeholder: 'Search tickets', q: ticketState.q } }) %>
    <%- include('../partials/ticket-table', { tickets, controls: ticketControls, filtered: Boolean(ticketState.status || ticketState.priority) }) %>
  </div>
</section>

<section class="section" id="activity">
  <div class="card">
    <%- include('../partials/history', { entries: activity, label: 'Client activity', showSubject: true }) %>
    <% if (activity.length >= 100) { %><p class="muted small">Showing the latest 100 entries.</p><% } %>
  </div>
</section>
<%- include('../partials/foot') %>
