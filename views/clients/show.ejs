<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/clients">Clients</a></p>
    <h1><%= client.name %></h1>
    <%- include('../partials/record-meta', { meta: clientMeta }) %>
  </div>
  <div class="actions">
    <a href="/clients/<%= client.id %>/edit" class="btn"><%- icon('edit') %><span>Edit</span></a>
    <%- include('../partials/delete', {
      action: `/clients/${client.id}/delete`,
      confirm: `Delete "${client.name}"? This also deletes their tickets and service checklists.`,
      text: 'Delete',
    }) %>
  </div>
</header>

<section class="card">
  <dl class="details">
    <div><dt>Contact</dt><dd><%= client.contact_name || '—' %></dd></div>
    <div><dt>Email</dt><dd><% if (client.email) { %><a href="mailto:<%= client.email %>"><%= client.email %></a><% } else { %>—<% } %></dd></div>
    <div><dt>Phone</dt><dd><%= client.phone || '—' %></dd></div>
    <div><dt>Added</dt><dd><%= fmtDate(client.created_at) %></dd></div>
  </dl>
  <% if (client.notes) { %>
    <h3>Notes</h3>
    <p class="pre-line"><%= client.notes %></p>
  <% } %>
</section>

<section class="section" id="services">
  <div class="section-head">
    <h2>Services</h2>
    <form method="post" action="/clients/<%= client.id %>/services" class="inline-form">
      <%- csrfField %>
      <label class="field">
        <span class="visually-hidden">Service to assign</span>
        <select name="service_id" required>
          <option value="">Choose a service…</option>
          <% for (const group of serviceGroups) { %>
            <optgroup label="<%= group.name %>">
              <% for (const s of group.services) { %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% } %>
            </optgroup>
          <% } %>
        </select>
      </label>
      <button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Assign</span></button>
    </form>
  </div>

  <% if (!clientServices.length) { %>
    <p class="empty card">No services assigned yet.</p>
  <% } %>
  <div class="cs-grid">
    <% for (const cs of clientServices) { %>
      <article class="card cs-card <%= cs.status === 'closed' ? 'is-closed' : '' %>" id="cs-<%= cs.id %>">
        <div class="card-head">
          <div>
            <h3><%= cs.service_name %></h3>
            <%- include('../partials/record-meta', { meta: cs.meta }) %>
          </div>
          <%- include('../partials/status', { status: cs.status }) %>
        </div>

        <% if (cs.steps.length) { %>
          <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="<%= cs.steps.length %>" aria-valuenow="<%= cs.doneCount %>">
            <span style="width: <%= Math.round((cs.doneCount / cs.steps.length) * 100) %>%"></span>
          </div>
          <p class="muted small"><%= cs.doneCount %> of <%= cs.steps.length %> steps done</p>
          <ol class="checklist checklist-live">
            <% for (const step of cs.steps) { %>
              <li class="<%= step.done ? 'is-done' : '' %>">
                <form method="post" action="/client-services/<%= cs.id %>/steps/<%= step.id %>/toggle">
                  <%- csrfField %>
                  <button type="submit" class="check-btn" aria-pressed="<%= step.done ? 'true' : 'false' %>">
                    <span class="check-icon"><%- icon(step.done ? 'box-check' : 'box') %></span>
                    <span class="check-text">
                      <%= step.title %>
                      <% if (step.done) { %><span class="muted small check-meta"><%= step.done_by || 'Unknown user' %> · <%= fmtDate(step.done_at) %></span><% } %>
                    </span>
                  </button>
                </form>
              </li>
            <% } %>
          </ol>
        <% } else { %>
          <p class="no-checklist"><span class="chip">No checklist</span> <span class="muted small">Mark it as closed when the work is done.</span></p>
        <% } %>

        <div class="notes">
          <h4>Notes <% if (cs.notes.length) { %><span class="muted small">(<%= cs.notes.length %>)</span><% } %></h4>
          <form method="post" action="/client-services/<%= cs.id %>/notes" class="form note-form">
            <%- csrfField %>
            <label class="field">
              <span class="visually-hidden">New note (internal)</span>
              <textarea name="body" rows="2" maxlength="10000" placeholder="Internal note, e.g. Laptop for Kay, serial ABC123"></textarea>
            </label>
            <details class="report-toggle">
              <summary>Add Daily Report details</summary>
              <%- include('../partials/report-fields', { values: {} }) %>
            </details>
            <div><button type="submit" class="btn"><%- icon('plus') %><span>Add note</span></button></div>
          </form>
          <% if (cs.notes.length) { %>
            <ul class="note-list">
              <% for (const note of cs.notes) { %>
                <li class="note">
                  <div class="note-head">
                    <div class="muted small">
                      <strong class="note-author"><%= note.author || 'Deleted user' %></strong> · <%= fmtDate(note.created_at) %>
                      <% if (note.updated_at) { %><span class="note-edited">· edited <%= fmtDate(note.updated_at) %><% if (note.editor) { %> by <%= note.editor %><% } %></span><% } %>
                    </div>
                    <div class="row-actions">
                      <details class="edit">
                        <summary class="icon-btn" title="Edit note" aria-label="Edit note"><%- icon('edit') %></summary>
                        <div class="edit-panel">
                          <form method="post" action="/client-service-notes/<%= note.id %>" class="form">
                            <%- csrfField %>
                            <label class="field">
                              <span>Note <span class="muted">(internal)</span></span>
                              <textarea name="body" rows="4" maxlength="10000"><%= note.body %></textarea>
                            </label>
                            <%- include('../partials/report-fields', { values: { report_action: note.action_id, report_issue: note.issue_name, report_detail: note.report_detail } }) %>
                            <div class="form-actions">
                              <button type="submit" class="btn btn-primary">Save</button>
                              <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                            </div>
                          </form>
                        </div>
                      </details>
                      <%- include('../partials/delete', { action: `/client-service-notes/${note.id}/delete`, confirm: 'Delete this note?' }) %>
                    </div>
                  </div>
                  <% if (note.body) { %><p class="pre-line"><%= note.body %></p><% } %>
                  <%- include('../partials/report-tags', { item: note }) %>
                </li>
              <% } %>
            </ul>
          <% } %>
        </div>

        <%- include('../partials/history', { entries: cs.history.slice().reverse() }) %>

        <div class="card-foot">
          <% if (cs.status === 'closed') { %>
            <form method="post" action="/client-services/<%= cs.id %>/reopen" class="inline">
              <%- csrfField %>
              <button type="submit" class="btn">Reopen</button>
            </form>
          <% } else { %>
            <form method="post" action="/client-services/<%= cs.id %>/close" class="inline">
              <%- csrfField %>
              <button type="submit" class="btn <%= cs.steps.length ? 'btn-ghost' : 'btn-primary' %>"><%- icon('check') %><span>Mark as closed</span></button>
            </form>
          <% } %>
          <%- include('../partials/delete', { action: `/client-services/${cs.id}/delete`, confirm: `Remove "${cs.service_name}" and its checklist from this client?` }) %>
        </div>
      </article>
    <% } %>
  </div>
</section>

<section class="section" id="tickets">
  <div class="section-head">
    <h2>Tickets</h2>
    <a href="/tickets/new?client_id=<%= client.id %>" class="btn btn-primary"><%- icon('plus') %><span>New ticket</span></a>
  </div>
  <div class="card">
    <%- include('../partials/status-filter', { base: `/clients/${client.id}`, counts: null }) %>
    <%- include('../partials/ticket-table', { tickets, status }) %>
  </div>
</section>

<section class="section" id="activity">
  <div class="card">
    <%- include('../partials/history', { entries: activity, label: 'Client activity', showSubject: true }) %>
    <% if (activity.length >= 100) { %><p class="muted small">Showing the latest 100 entries.</p><% } %>
  </div>
</section>
<%- include('../partials/foot') %>
