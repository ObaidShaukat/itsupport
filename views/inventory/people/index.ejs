<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <h1>Inventory</h1>
    <p class="muted">Cleartwo's own people, equipment and accounts. Passwords are never stored here: use 1Password.</p>
  </div>
  <div class="actions">
    <a href="/inventory/export/people" class="btn"><%- icon('download') %><span>Export CSV</span></a>
    <% if (!former) { %><a href="/inventory/people/new" class="btn btn-primary"><%- icon('plus') %><span>Add person</span></a><% } %>
  </div>
</header>
<%- include('../_tabs') %>

<form method="get" class="card inv-filters">
  <label class="field">
    <span>Company</span>
    <select name="company">
      <option value="">All companies</option>
      <% for (const c of lists.companies) { %><option value="<%= c.id %>" <%= companyId === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Team</span>
    <select name="team">
      <option value="">All teams</option>
      <% for (const t of lists.teams) { %><option value="<%= t.id %>" <%= teamId === t.id ? 'selected' : '' %>><%= t.name %></option><% } %>
    </select>
  </label>
  <%- include('../_cf-filters', { filterFields, activeFilters }) %>
  <button type="submit" class="btn">Filter</button>
</form>

<%- include('../../partials/search', { target: '#people-list', placeholder: 'Search by name, email, team, role or any field' }) %>

<section class="card" id="people-list">
  <% if (!people.length) { %>
    <p class="empty"><%= former ? 'Nobody has left yet.' : 'No people yet. Add someone or import the spreadsheet.' %></p>
  <% } else { %>
    <p class="empty" data-filter-empty hidden>Nobody matches your search.</p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th class="w-20">Name</th><th class="w-md">Company</th><th class="w-md">Team</th><th>Role</th>
            <% if (former) { %><th class="w-sm">Left</th><th class="w-sm">Offboarding</th><% } else { %><th class="num w-num">Assets</th><th class="num w-num">Stock</th><th class="num w-num">Access</th><% } %>
            <% for (const f of listFields) { %><th><%= f.label %></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% for (const p of people) { %>
            <% const v = values.get(p.id) || {}; %>
            <tr data-filter-item data-search="<%= [p.name, p.email, p.company_name, p.team_name, p.role, p.phone, ...Object.values(v)].filter(Boolean).join(' ') %>">
              <td><a href="/inventory/people/<%= p.id %>"><strong><%= p.name %></strong></a><% if (p.email) { %><div class="muted small"><%= p.email %></div><% } %></td>
              <td><%= p.company_name || '' %></td>
              <td><%= p.team_name || '' %></td>
              <td><%= p.role || '' %></td>
              <% if (former) { %>
                <td class="nowrap"><%= fmtDay(p.leaving_date) || '—' %></td>
                <td><% if (Number(p.open_offboarding)) { %><span class="chip chip-warn"><%= p.open_offboarding %> to do</span><% } else { %><span class="muted small">Done</span><% } %></td>
              <% } else { %>
                <td class="num"><%= Number(p.asset_count) %></td>
                <td class="num"><%= Number(p.stock_count) %></td>
                <td class="num"><%= Number(p.access_count) %></td>
              <% } %>
              <% for (const f of listFields) { %><td><%= f.field_type === 'boolean' ? (v[f.id] === 'yes' ? 'Yes' : v[f.id] === 'no' ? 'No' : '') : (v[f.id] || '') %></td><% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../../partials/foot') %>
