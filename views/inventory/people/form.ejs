<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/inventory/people">Inventory</a><% if (person.id) { %> / <a href="/inventory/people/<%= person.id %>"><%= person.name %></a><% } %></p>
    <h1><%= person.id ? 'Edit person' : 'Add person' %></h1>
  </div>
</header>
<%- include('../_tabs') %>

<section class="card card-narrow">
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="<%= person.id ? `/inventory/people/${person.id}` : '/inventory/people' %>" class="form">
    <%- csrfField %>
    <div class="form-row">
      <label class="field"><span>Name *</span><input type="text" name="name" value="<%= person.name %>" required maxlength="150"></label>
      <label class="field"><span>Email</span><input type="email" name="email" value="<%= person.email || '' %>" maxlength="254"></label>
    </div>
    <div class="form-row">
      <label class="field">
        <span>Company</span>
        <input type="text" name="company" value="<%= person.company || '' %>" list="inv-companies" maxlength="100" placeholder="Pick or type a new one">
        <datalist id="inv-companies"><% for (const c of lists.companies) { %><option value="<%= c.name %>"><% } %></datalist>
      </label>
      <label class="field">
        <span>Team</span>
        <input type="text" name="team" value="<%= person.team || '' %>" list="inv-teams" maxlength="100" placeholder="Pick or type a new one">
        <datalist id="inv-teams"><% for (const t of lists.teams) { %><option value="<%= t.name %>"><% } %></datalist>
      </label>
    </div>
    <div class="form-row">
      <label class="field"><span>Role</span><input type="text" name="role" value="<%= person.role || '' %>" maxlength="150"></label>
      <label class="field"><span>Phone</span><input type="tel" name="phone" value="<%= person.phone || '' %>" maxlength="50"></label>
    </div>
    <label class="field"><span>Start date</span><input type="date" name="start_date" value="<%= person.start_date || '' %>"></label>
    <%- include('../_cf-inputs', { fields, values }) %>
    <label class="field"><span>Notes</span><textarea name="notes" rows="4" maxlength="5000"><%= person.notes || '' %></textarea></label>
    <p class="muted small"><%- icon('lock') %> Never put passwords or PINs here. Store them in 1Password.</p>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= person.id ? 'Save' : 'Add person' %></button>
      <a href="<%= person.id ? `/inventory/people/${person.id}` : '/inventory/people' %>" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</section>
<%- include('../../partials/foot') %>
