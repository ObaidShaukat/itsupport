<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/inventory/settings">Lists &amp; fields</a></p>
    <h1>Custom fields</h1>
    <p class="muted"><%- icon('lock') %> Fields for passwords, PINs or other credentials are blocked. Keep those in 1Password.</p>
  </div>
</header>
<%- include('../_tabs') %>

<nav class="filters" aria-label="Field groups">
  <% for (const [key, label] of Object.entries(CF_ENTITIES)) { %>
    <a href="/inventory/settings/fields?entity=<%= key %>" class="<%= entity === key ? 'active' : '' %>"><%= label %></a>
  <% } %>
</nav>

<div class="grid-2 grid-wide-left">
  <section class="card">
    <h2><%= CF_ENTITIES[entity] %> fields</h2>
    <% if (!fields.length) { %>
      <p class="empty">No custom fields yet.</p>
    <% } else { %>
      <p class="muted small">Drag <%- icon('grip') %> to change the order on forms.</p>
      <ul class="rows step-list" data-sortable-list data-order-url="/inventory/settings/fields/order" data-order-extra="entity=<%= entity %>">
        <% for (const f of fields) { %>
          <li class="row <%= f.hidden ? 'is-hidden-field' : '' %>" data-id="<%= f.id %>">
            <span class="drag-handle" title="Drag to reorder" aria-hidden="true"><%- icon('grip') %></span>
            <div class="row-main">
              <strong><%= f.label %></strong>
              <% if (f.hidden) { %><span class="chip">Hidden</span><% } %>
              <div class="muted small">
                <%= CF_TYPES[f.field_type] %><%= f.required ? ' · required' : '' %><%= f.show_in_list ? ' · shown in list' : '' %><%= f.category_name ? ` · ${f.category_name} only` : '' %>
                <% if (used[f.id]) { %> · <%= used[f.id] %> with a value<% } %>
                <% if (f.field_type === 'select' && f.optionList.length) { %> · <%= f.optionList.join(', ') %><% } %>
              </div>
            </div>
            <div class="row-actions">
              <a href="/inventory/settings/fields/<%= f.id %>/edit" class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></a>
              <form method="post" action="/inventory/settings/fields/<%= f.id %>/hide" class="inline">
                <%- csrfField %><button type="submit" class="btn btn-small btn-ghost"><%= f.hidden ? 'Show' : 'Hide' %></button>
              </form>
              <a href="/inventory/settings/fields/<%= f.id %>/delete" class="icon-btn icon-btn-danger" title="Delete" aria-label="Delete"><%- icon('trash') %></a>
            </div>
          </li>
        <% } %>
      </ul>
      <p class="reorder-status small" data-reorder-status role="status" hidden></p>
    <% } %>
  </section>

  <section class="card">
    <h2><%= edit ? `Edit "${edit.label}"` : 'Add a field' %></h2>
    <% const f = edit || { field_type: 'text', entity_type: entity }; %>
    <form method="post" action="<%= edit ? `/inventory/settings/fields/${edit.id}` : '/inventory/settings/fields' %>" class="form" data-field-form>
      <%- csrfField %>
      <% if (!edit) { %><input type="hidden" name="entity_type" value="<%= entity %>"><% } %>
      <label class="field"><span>Label</span><input type="text" name="label" value="<%= f.label || '' %>" required maxlength="100" data-credential-check></label>
      <p class="flash flash-error small" data-credential-warning hidden>Passwords, PINs and credentials must never be stored here. Use 1Password and tick "Credentials stored in 1Password" instead.</p>
      <label class="field">
        <span>Type</span>
        <select name="field_type" data-field-type>
          <% for (const [k, label] of Object.entries(CF_TYPES)) { %><option value="<%= k %>" <%= f.field_type === k ? 'selected' : '' %>><%= label %></option><% } %>
        </select>
      </label>
      <label class="field" data-options-field>
        <span>Dropdown options <span class="muted">(one per line)</span></span>
        <textarea name="options" rows="4" maxlength="5000"><%= f.options || '' %></textarea>
      </label>
      <% if (['asset', 'stock'].includes(entity)) { %>
        <label class="field">
          <span>Only for category <span class="muted">(optional)</span></span>
          <select name="category_id">
            <option value="">All categories</option>
            <% for (const c of lists.categories.filter((c) => c.kind === entity)) { %><option value="<%= c.id %>" <%= f.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
          </select>
        </label>
      <% } %>
      <label class="checkbox-field"><input type="checkbox" name="required" value="1" <%= f.required ? 'checked' : '' %>><span>Required</span></label>
      <label class="checkbox-field"><input type="checkbox" name="show_in_list" value="1" <%= f.show_in_list ? 'checked' : '' %>><span>Show in list view</span></label>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= edit ? 'Save field' : 'Add field' %></button>
        <% if (edit) { %><a href="/inventory/settings/fields?entity=<%= entity %>" class="btn btn-ghost">Cancel</a><% } %>
      </div>
    </form>
  </section>
</div>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1/Sortable.min.js"></script>
<%- include('../../partials/foot') %>
