<%- include('../../partials/head') %>
<header class="page-head">
  <div><h1>Inventory</h1><p class="muted">Editable lists and custom fields.</p></div>
  <div class="actions"><a href="/inventory/settings/fields" class="btn btn-primary"><%- icon('sliders') %><span>Custom fields</span></a></div>
</header>
<%- include('../_tabs') %>

<section class="card">
  <h2>Custom fields</h2>
  <p class="muted small">Extra fields on forms, detail pages, lists, filters and CSV exports, without code.</p>
  <ul class="rows rows-compact">
    <% for (const [key, label] of Object.entries({ person: 'People', asset: 'Assets', stock: 'Stock', access: 'Access', shared: 'Shared accounts' })) { %>
      <% const c = fieldCounts[key] || { n: 0, hidden: 0 }; %>
      <li class="row"><div class="row-main"><a href="/inventory/settings/fields?entity=<%= key %>"><%= label %></a><span class="muted small"><%= c.n %> field<%= c.n === 1 ? '' : 's' %><%= c.hidden ? ` (${c.hidden} hidden)` : '' %></span></div></li>
    <% } %>
  </ul>
</section>

<div class="category-grid">
  <% for (const [key, spec] of Object.entries(LISTS)) { %>
    <% const items = lists[key]; %>
    <section class="card" id="<%= key %>">
      <h2><%= spec.title %></h2>
      <ul class="rows rows-compact">
        <% for (const it of items) { %>
          <% const n = used[`${key}:${it.id}`] || 0; %>
          <li class="row">
            <div class="row-main">
              <span><%= it.name %><% if (key === 'categories') { %> <span class="chip <%= it.kind === 'stock' ? '' : 'chip-category' %>"><%= it.kind === 'stock' ? 'Stock' : 'Asset' %></span><% } %></span>
              <span class="muted small"><%= n ? `${n} in use` : '' %></span>
            </div>
            <div class="row-actions">
              <details class="edit">
                <summary class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></summary>
                <div class="edit-panel">
                  <form method="post" action="/inventory/settings/lists/<%= key %>/<%= it.id %>" class="form">
                    <%- csrfField %>
                    <label class="field"><span>Name</span><input type="text" name="name" value="<%= it.name %>" required maxlength="100"></label>
                    <% if (key === 'categories') { %>
                      <label class="field">
                        <span>Tracked as</span>
                        <select name="kind">
                          <option value="asset" <%= it.kind === 'asset' ? 'selected' : '' %>>Asset (one record per item)</option>
                          <option value="stock" <%= it.kind === 'stock' ? 'selected' : '' %>>Stock (by quantity)</option>
                        </select>
                      </label>
                    <% } %>
                    <div class="form-actions">
                      <button type="submit" class="btn btn-primary">Save</button>
                      <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                    </div>
                  </form>
                </div>
              </details>
              <%- include('../../partials/delete', { action: `/inventory/settings/lists/${key}/${it.id}/delete`, confirm: n ? `Delete ${it.name}? ${n} record${n === 1 ? ' uses' : 's use'} it and will be left without a ${spec.label}.` : `Delete ${it.name}?` }) %>
            </div>
          </li>
        <% } %>
      </ul>
      <form method="post" action="/inventory/settings/lists/<%= key %>" class="inline-form add-step">
        <%- csrfField %>
        <label class="field field-grow"><span class="visually-hidden">New <%= spec.label %></span><input type="text" name="name" required maxlength="100" placeholder="Add <%= spec.label %>"></label>
        <% if (key === 'categories') { %>
          <label class="field"><span class="visually-hidden">Tracked as</span><select name="kind"><option value="asset">Asset</option><option value="stock">Stock</option></select></label>
        <% } %>
        <button type="submit" class="btn"><%- icon('plus') %><span>Add</span></button>
      </form>
    </section>
  <% } %>
</div>
<%- include('../../partials/foot') %>
