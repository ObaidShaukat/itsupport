<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/inventory/import">Import</a></p>
    <h1>Import preview</h1>
    <p class="muted"><%= plan.fileName %>. Nothing has been saved yet.</p>
  </div>
</header>
<%- include('../_tabs') %>

<section class="stats import-stats">
  <div class="card stat"><span class="stat-icon"><%- icon('users') %></span><span class="stat-value"><%= summary.people %></span><span class="stat-label">People (<%= summary.left %> left)</span></div>
  <div class="card stat"><span class="stat-icon"><%- icon('monitor') %></span><span class="stat-value"><%= summary.assets %></span><span class="stat-label">Assets (<%= summary.assigned %> assigned, <%= summary.sold %> sold)</span></div>
  <div class="card stat"><span class="stat-icon"><%- icon('layers') %></span><span class="stat-value"><%= summary.stock %></span><span class="stat-label">Stock items (<%= summary.stockAssignments %> given out)</span></div>
  <div class="card stat"><span class="stat-icon"><%- icon('lock') %></span><span class="stat-value"><%= summary.access %></span><span class="stat-label">Access entries</span></div>
</section>

<form method="post" action="/inventory/import/confirm" class="form" id="import-form">
  <%- csrfField %>

  <% if (plan.warnings.length) { %>
    <section class="card">
      <h2>Check these (<%= plan.warnings.length %>)</h2>
      <p class="muted small">Nothing below was guessed silently. Fix these after importing, or correct the spreadsheet and upload again.</p>
      <ul class="import-warnings">
        <% for (const w of plan.warnings) { %><li><%= w %></li><% } %>
      </ul>
    </section>
  <% } %>

  <div class="grid-2">
    <section class="card">
      <h2><%- icon('lock') %> Skipped columns</h2>
      <ul class="rows rows-compact">
        <% for (const s of plan.skippedColumns) { %>
          <li class="row"><div class="row-main"><span><strong><%= s.sheet %></strong>: <%= s.header %></span><span class="muted small"><%= s.reason %></span></div></li>
        <% } %>
      </ul>
    </section>

    <section class="card">
      <h2>Other columns</h2>
      <% if (!plan.unknownColumns.length) { %>
        <p class="empty">Every other column has a place in the portal.</p>
      <% } else { %>
        <p class="muted small">These columns are not part of the standard import. Keep them as a custom field on people, or skip them.</p>
        <% for (const u of plan.unknownColumns) { %>
          <label class="field">
            <span><strong><%= u.sheet %></strong>: "<%= u.header %>" <span class="muted">(<%= u.filled %> value<%= u.filled === 1 ? '' : 's' %>)</span></span>
            <select name="map_<%= u.id.replace(/[^a-z0-9]/gi, '_') %>">
              <option value="skip">Skip this column</option>
              <option value="new">Create a new text field "<%= u.header %>"</option>
              <% for (const f of personFields) { %><option value="<%= f.id %>">Put in existing field "<%= f.label %>"</option><% } %>
            </select>
          </label>
        <% } %>
      <% } %>
    </section>
  </div>

  <section class="card">
    <details class="history" open>
      <summary>People <span class="count"><%= people.length %></span></summary>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Name</th><th>Email</th><th>Company</th><th>Team</th><th>Status</th><th>From</th></tr></thead>
          <tbody>
            <% for (const p of people) { %>
              <tr><td><strong><%= p.name %></strong></td><td class="small"><%= p.email %></td><td><%= p.company %></td><td><%= p.team %></td>
                <td><span class="chip <%= p.status === 'left' ? 'chip-warn' : 'chip-category' %>"><%= p.status === 'left' ? 'Left' : 'Active' %></span></td>
                <td class="muted small"><%= p.sources.join(', ') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="card">
    <details class="history">
      <summary>Assets <span class="count"><%= plan.assets.length %></span></summary>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Category</th><th>Brand / model</th><th>Serial</th><th>Device</th><th>Status</th><th>Person</th><th>From</th></tr></thead>
          <tbody>
            <% for (const a of plan.assets) { %>
              <tr><td><%= a.category %></td><td><%= [a.brand, a.model].filter(Boolean).join(' ') %></td><td class="nowrap"><%= a.serial || '—' %></td>
                <td class="nowrap small"><%= a.device_name %></td><td><%- include('../_status', { status: a.status }) %></td>
                <td><%= a.personKey ? name(a.personKey) : a.status === 'sold' ? `Sold to ${a.sold_to}` : a.previousPersonKey ? `(was ${name(a.previousPersonKey)})` : '' %></td>
                <td class="muted small"><%= a.source %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="card">
    <details class="history">
      <summary>Stock <span class="count"><%= stock.length %></span></summary>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Category</th><th>Brand / model</th><th class="num">Total</th><th class="num">Damaged</th><th>Given to</th></tr></thead>
          <tbody>
            <% for (const s of stock) { %>
              <tr><td><%= s.category %></td><td><%= [s.brand, s.model].filter(Boolean).join(' ') %></td><td class="num"><%= s.total %></td><td class="num"><%= s.damaged || '' %></td>
                <td class="small"><%= s.assignments.map((a) => `${name(a.personKey)}${a.qty > 1 ? ` (${a.qty})` : ''}`).join(', ') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="card">
    <details class="history">
      <summary>Access <span class="count"><%= plan.access.length %></span></summary>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Account</th><th>Person</th><th>Username / email</th><th>Status</th><th>Note</th></tr></thead>
          <tbody>
            <% for (const a of plan.access) { %>
              <tr><td><%= a.app %></td><td><%= name(a.personKey) %></td><td><%= a.username %></td>
                <td><span class="chip <%= a.status === 'active' ? 'chip-category' : '' %>"><%= a.status === 'active' ? 'Active' : 'Removed' %></span></td>
                <td class="muted small"><%= a.notes %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <div class="form-actions import-actions">
    <button type="submit" class="btn btn-primary">Confirm and import</button>
  </div>
</form>
<form method="post" action="/inventory/import/cancel" class="inline">
  <%- csrfField %><button type="submit" class="btn btn-ghost">Cancel import</button>
</form>
<%- include('../../partials/foot') %>
