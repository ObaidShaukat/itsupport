<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="<%= back %>">Back</a></p>
    <h1>Delete "<%= field.label %>" from <%= scope.name %>?</h1>
  </div>
</header>
<section class="card card-narrow">
  <% if (count) { %>
    <div class="flash flash-error" role="alert"><strong><%= count %> <%= count === 1 ? (scope.isEmployees ? 'employee has' : 'record has') : (scope.isEmployees ? 'employees have' : 'records have') %> data in it.</strong> That data is deleted too and cannot be brought back.</div>
  <% } else { %>
    <p>Nobody has data in it yet.</p>
  <% } %>
  <p class="muted">If you only want it out of the way, hide it instead (it can be shown again from Columns).</p>
  <form method="post" action="/inventory/fields/<%= field.id %>/delete" class="form-actions">
    <%- csrfField %>
    <input type="hidden" name="back" value="<%= back %>">
    <button type="submit" class="btn btn-danger"><%- icon('trash') %><span>Delete<%= count ? ` and ${count} value${count === 1 ? '' : 's'}` : '' %></span></button>
    <a href="<%= back %>" class="btn btn-ghost">Cancel</a>
  </form>
</section>
<%- include('../../partials/foot') %>
