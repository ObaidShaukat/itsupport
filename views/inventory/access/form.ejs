<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/inventory/access">Access</a> / <a href="/inventory/people/<%= item.person_id %>"><%= item.person_name %></a></p>
    <h1>Edit access</h1>
  </div>
</header>
<%- include('../_tabs') %>

<section class="card card-narrow">
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/inventory/access/<%= item.id %>" class="form">
    <%- csrfField %>
    <input type="hidden" name="back" value="/inventory/people/<%= item.person_id %>#access">
    <div class="form-row">
      <label class="field">
        <span>Account / app</span>
        <input type="text" name="app" value="<%= item.app || '' %>" list="inv-apps" required maxlength="100">
        <datalist id="inv-apps"><% for (const ap of lists.apps) { %><option value="<%= ap.name %>"><% } %></datalist>
      </label>
      <label class="field"><span>Username / email</span><input type="text" name="username" value="<%= item.username || '' %>" maxlength="254" autocomplete="off"></label>
    </div>
    <div class="form-row">
      <label class="field"><span>Granted</span><input type="date" name="granted_date" value="<%= item.granted_date || '' %>"></label>
      <label class="field"><span>Granted by</span><input type="text" name="granted_by" value="<%= item.granted_by || '' %>" maxlength="150"></label>
    </div>
    <div class="form-row">
      <label class="field">
        <span>Status</span>
        <select name="status">
          <option value="active" <%= item.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="removed" <%= item.status === 'removed' ? 'selected' : '' %>>Removed</option>
        </select>
      </label>
      <label class="field"><span>Removed on</span><input type="date" name="removed_date" value="<%= item.removed_date || '' %>"></label>
    </div>
    <label class="checkbox-field"><input type="checkbox" name="in_1password" value="1" <%= item.in_1password ? 'checked' : '' %>><span>Credentials stored in 1Password</span></label>
    <label class="field"><span>1Password item link <span class="muted">(optional)</span></span><input type="url" name="onepassword_link" value="<%= item.onepassword_link || '' %>" maxlength="500"></label>
    <%- include('../_cf-inputs', { fields, values }) %>
    <label class="field"><span>Notes</span><textarea name="notes" rows="3" maxlength="5000"><%= item.notes || '' %></textarea></label>
    <p class="muted small"><%- icon('lock') %> Never type a password here.</p>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/inventory/people/<%= item.person_id %>#access" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
  <form method="post" action="/inventory/access/<%= item.id %>/delete" class="inline add-step" data-confirm="Delete this access record completely? Usually it is better to mark it Removed.">
    <%- csrfField %><input type="hidden" name="back" value="/inventory/people/<%= item.person_id %>#access">
    <button type="submit" class="btn btn-danger"><%- icon('trash') %><span>Delete record</span></button>
  </form>
</section>
<%- include('../../partials/foot') %>
