<%- include('../../partials/head') %>
<header class="page-head">
  <div><h1>Inventory</h1><p class="muted"><%- icon('lock') %> Which accounts exist and who has them. Passwords and PINs are never stored: they live in 1Password.</p></div>
  <div class="actions">
    <a href="/inventory/export/access" class="btn"><%- icon('download') %><span>Export CSV</span></a>
    <a href="/inventory/access/shared/new" class="btn btn-primary"><%- icon('plus') %><span>Add shared account</span></a>
  </div>
</header>
<%- include('../_tabs') %>

<form method="get" class="card inv-filters">
  <label class="field">
    <span>Account / app</span>
    <select name="app">
      <option value="">All</option>
      <% for (const a of lists.apps) { %><option value="<%= a.id %>" <%= appFilter === a.id ? 'selected' : '' %>><%= a.name %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Person</span>
    <select name="person">
      <option value="">Anyone</option>
      <% for (const p of people) { %><option value="<%= p.id %>" <%= personFilter === p.id ? 'selected' : '' %>><%= p.name %><%= p.status === 'left' ? ' (left)' : '' %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Status</span>
    <select name="status">
      <option value="">Any</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="removed" <%= status === 'removed' ? 'selected' : '' %>>Removed</option>
    </select>
  </label>
  <%- include('../_cf-filters', { filterFields, activeFilters }) %>
  <button type="submit" class="btn">Filter</button>
</form>

<%- include('../../partials/search', { target: '#access-list', placeholder: 'Search by app, person or username' }) %>

<section class="card" id="access-list">
  <h2>People's access <span class="muted small">(<%= access.length %>)</span></h2>
  <% if (!access.length) { %>
    <p class="empty">No access recorded<%= appFilter || personFilter || status ? ' for these filters' : '' %>. Add accounts from a person's page.</p>
  <% } else { %>
    <p class="empty" data-filter-empty hidden>Nothing matches your search.</p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Account</th><th>Person</th><th>Username / email</th><th>Status</th><th>Granted</th><th>1Password</th>
            <% for (const f of listFields) { %><th><%= f.label %></th><% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const a of access) { %>
            <% const v = values.get(a.id) || {}; %>
            <tr data-filter-item data-search="<%= [a.app_name, a.person_name, a.username, a.granted_by, a.notes, ...Object.values(v)].filter(Boolean).join(' ') %>">
              <td><strong><%= a.app_name || 'Other' %></strong></td>
              <td><a href="/inventory/people/<%= a.person_id %>"><%= a.person_name %></a><%= a.person_status === 'left' ? ' (left)' : '' %></td>
              <td><%= a.username || '—' %></td>
              <td><span class="chip <%= a.status === 'active' ? 'chip-category' : '' %>"><%= a.status === 'active' ? 'Active' : 'Removed' %></span><% if (a.removed_date) { %><div class="muted small"><%= fmtDay(a.removed_date) %></div><% } %></td>
              <td class="nowrap small"><%= fmtDay(a.granted_date) %><%= a.granted_by ? ` · ${a.granted_by}` : '' %></td>
              <td><%= a.in_1password ? 'Yes' : 'No' %></td>
              <% for (const f of listFields) { %><td><%= f.field_type === 'boolean' ? (v[f.id] === 'yes' ? 'Yes' : v[f.id] === 'no' ? 'No' : '') : (v[f.id] || '') %></td><% } %>
              <td class="row-actions"><a href="/inventory/access/<%= a.id %>/edit" class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card" id="shared">
  <h2>Shared &amp; service accounts <span class="muted small">(<%= shared.length %>)</span></h2>
  <% if (!shared.length) { %>
    <p class="empty">No shared accounts yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Name</th><th>Account / app</th><th>Login</th><th>Purpose</th><th>Owner</th><th>Status</th><th>1Password</th>
            <% for (const f of sharedListFields) { %><th><%= f.label %></th><% } %><th></th></tr>
        </thead>
        <tbody>
          <% for (const s of shared) { %>
            <% const v = sharedValues.get(s.id) || {}; %>
            <tr id="shared-<%= s.id %>">
              <td><strong><%= s.name %></strong></td>
              <td><%= s.app_name || '' %></td>
              <td><%= s.account || '' %></td>
              <td><%= s.purpose || '' %></td>
              <td><% if (s.owner_person_id) { %><a href="/inventory/people/<%= s.owner_person_id %>"><%= s.owner_name %></a><% } %></td>
              <td><span class="chip <%= s.status === 'active' ? 'chip-category' : '' %>"><%= s.status === 'active' ? 'Active' : 'Removed' %></span></td>
              <td><% if (s.in_1password) { %>Yes<% if (s.onepassword_link) { %> · <a href="<%= s.onepassword_link %>" target="_blank" rel="noopener noreferrer">Open</a><% } %><% } else { %>No<% } %></td>
              <% for (const f of sharedListFields) { %><td><%= v[f.id] || '' %></td><% } %>
              <td class="row-actions">
                <a href="/inventory/access/shared/<%= s.id %>/edit" class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></a>
                <%- include('../../partials/delete', { action: `/inventory/access/shared/${s.id}/delete`, confirm: `Delete the shared account record "${s.name}"?` }) %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../../partials/foot') %>
