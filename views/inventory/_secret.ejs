<%#
  A password / PIN: masked, with reveal (eye) and copy buttons. The value is fetched from
  POST /inventory/secret only when asked (each reveal / copy is logged) and hidden again
  after 30 seconds (public/js/app.js). recordId, field, hasSecret.
%>
<% if (hasSecret) { %>
  <span class="secret" data-secret data-record="<%= recordId %>" data-field="<%= field.id %>" data-label="<%= field.label %>">
    <span class="secret-value" data-secret-value>••••••</span>
    <button type="button" class="secret-btn" data-secret-reveal title="Show <%= field.label %>" aria-label="Show <%= field.label %>"><%- icon('eye') %></button>
    <button type="button" class="secret-btn" data-secret-copy title="Copy <%= field.label %>" aria-label="Copy <%= field.label %>"><%- icon('copy') %></button>
  </span>
<% } else { %>
  <span class="muted">—</span>
<% } %>
