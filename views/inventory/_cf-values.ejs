<%# Read-only custom field values on detail pages. %>
<% const shown = fields.filter((f) => values[f.id] !== undefined && values[f.id] !== null && values[f.id] !== ''); %>
<% if (shown.length) { %>
  <dl class="details cf-details">
    <% for (const f of shown) { %>
      <div>
        <dt><%= f.label %></dt>
        <dd>
          <% if (f.field_type === 'link') { %><a href="<%= values[f.id] %>" target="_blank" rel="noopener noreferrer"><%= values[f.id] %></a>
          <% } else if (f.field_type === 'boolean') { %><%= values[f.id] === 'yes' ? 'Yes' : 'No' %>
          <% } else { %><span class="pre-line"><%= values[f.id] %></span><% } %>
        </dd>
      </div>
    <% } %>
  </dl>
<% } %>
