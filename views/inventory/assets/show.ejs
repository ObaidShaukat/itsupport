<%- include('../../partials/head') %>
<% const here = `/inventory/assets/${asset.id}`; %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/inventory/assets">Assets</a></p>
    <h1><%= asset.asset_tag %> <span class="muted"><%= [asset.brand, asset.model].filter(Boolean).join(' ') %></span></h1>
    <p><%- include('../_status', { status: asset.status }) %> <span class="muted small"><%= asset.category_name || 'Uncategorised' %></span></p>
  </div>
  <div class="actions">
    <a href="<%= here %>/edit" class="btn"><%- icon('edit') %><span>Edit</span></a>
    <%- include('../../partials/delete', { action: `${here}/delete`, confirm: `Delete ${asset.asset_tag} and its history? This cannot be undone. Usually it is better to mark it Disposed or Sold.`, text: 'Delete' }) %>
  </div>
</header>
<%- include('../_tabs') %>

<div class="grid-2 grid-wide-left">
  <section class="card">
    <h2>Details</h2>
    <dl class="details">
      <div><dt>Serial number</dt><dd><%= asset.serial_number || '—' %></dd></div>
      <div><dt>Device name</dt><dd><%= asset.device_name || '—' %></dd></div>
      <div><dt>Wi-Fi MAC</dt><dd><%= asset.wifi_mac || '—' %></dd></div>
      <div><dt>Ethernet MAC</dt><dd><%= asset.ethernet_mac || '—' %></dd></div>
      <div><dt>Purchase date</dt><dd><%= asset.purchase_date || '—' %></dd></div>
      <div><dt>Location</dt><dd><%= asset.location || '—' %></dd></div>
      <% if (asset.status === 'sold') { %>
        <div><dt>Sold to</dt><dd><%= asset.sold_to || '—' %></dd></div>
        <div><dt>Sold date</dt><dd><%= asset.sold_date || '—' %></dd></div>
      <% } %>
    </dl>
    <% if (asset.specifications) { %><h3>Specifications</h3><p class="pre-line"><%= asset.specifications %></p><% } %>
    <%- include('../_cf-values', { fields, values }) %>
    <% if (asset.notes) { %><h3>Notes</h3><p class="pre-line"><%= asset.notes %></p><% } %>
  </section>

  <section class="card">
    <h2>Assigned to</h2>
    <% if (asset.person_id) { %>
      <p><a href="/inventory/people/<%= asset.person_id %>"><strong><%= asset.person_name %></strong></a></p>
      <form method="post" action="<%= here %>/unassign" class="form">
        <%- csrfField %>
        <div class="form-row">
          <label class="field"><span>Returned on</span><input type="date" name="date" value="<%= today %>"></label>
          <label class="field">
            <span>Then mark as</span>
            <select name="status"><option value="spare">Spare</option><option value="repair">Repair</option><option value="damaged">Damaged</option></select>
          </label>
        </div>
        <div><button type="submit" class="btn">Unassign</button></div>
      </form>
    <% } else { %>
      <p class="muted">Not assigned<%= asset.status === 'sold' && asset.sold_to ? ` (sold to ${asset.sold_to})` : '' %>.</p>
    <% } %>
    <% if (!['sold', 'disposed'].includes(asset.status)) { %>
      <form method="post" action="<%= here %>/assign" class="form add-step">
        <%- csrfField %>
        <label class="field">
          <span><%= asset.person_id ? 'Reassign to' : 'Assign to' %></span>
          <select name="person_id" required>
            <option value="">Choose…</option>
            <% for (const p of people) { if (p.id === asset.person_id) continue; %><option value="<%= p.id %>"><%= p.name %></option><% } %>
          </select>
        </label>
        <label class="field"><span>From</span><input type="date" name="date" value="<%= today %>"></label>
        <div><button type="submit" class="btn btn-primary"><%= asset.person_id ? 'Reassign' : 'Assign' %></button></div>
      </form>
    <% } %>
  </section>
</div>

<div class="grid-2">
  <section class="card">
    <h2>Assignment history</h2>
    <% if (!history.length) { %><p class="empty">Never assigned.</p><% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Who</th><th>From</th><th>To</th><th>Notes</th></tr></thead>
          <tbody>
            <% for (const h of history) { %>
              <tr>
                <td><% if (h.person_id) { %><a href="/inventory/people/<%= h.person_id %>"><%= h.person_name %></a><% } else { %><%= h.person_name %><% } %></td>
                <td class="nowrap"><%= h.assigned_from || '—' %></td>
                <td class="nowrap"><%= h.assigned_until || (asset.person_id === h.person_id ? 'Now' : '—') %></td>
                <td class="muted small"><%= h.notes || '' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
  <section class="card">
    <h2>History</h2>
    <% if (!log.length) { %><p class="empty">Nothing logged yet.</p><% } else { %>
      <ol class="timeline">
        <% for (const t of log) { %><li><div><%= t.summary %></div><div class="muted small"><%= t.username || 'Deleted user' %> · <%= fmtDate(t.created_at) %></div></li><% } %>
      </ol>
    <% } %>
  </section>
</div>
<%- include('../../partials/foot') %>
