<%- include('../../partials/head') %>
<header class="page-head">
  <div><h1>Inventory</h1><p class="muted">One record per physical item, with who has it and its history.</p></div>
  <div class="actions">
    <a href="/inventory/export/assets" class="btn"><%- icon('download') %><span>Export CSV</span></a>
    <a href="/inventory/assets/new" class="btn btn-primary"><%- icon('plus') %><span>Add asset</span></a>
  </div>
</header>
<%- include('../_tabs') %>

<form method="get" class="card inv-filters">
  <label class="field">
    <span>Category</span>
    <select name="category">
      <option value="">All categories</option>
      <% for (const c of lists.categories.filter((c) => c.kind === 'asset')) { %><option value="<%= c.id %>" <%= categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Status</span>
    <select name="status">
      <option value="">Any status</option>
      <% for (const [k, label] of Object.entries(invAssetStatuses)) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= label %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Person</span>
    <select name="person">
      <option value="">Anyone</option>
      <% for (const p of people) { %><option value="<%= p.id %>" <%= personId === p.id ? 'selected' : '' %>><%= p.name %></option><% } %>
    </select>
  </label>
  <%- include('../_cf-filters', { filterFields, activeFilters }) %>
  <button type="submit" class="btn">Filter</button>
</form>

<%- include('../../partials/search', { target: '#asset-list', placeholder: 'Search by serial, device name, model, tag or person' }) %>

<section class="card" id="asset-list">
  <% if (!assets.length) { %>
    <p class="empty">No assets<%= categoryId || status || personId ? ' match these filters' : ' yet' %>.</p>
  <% } else { %>
    <p class="empty" data-filter-empty hidden>No assets match your search.</p>
    <p class="muted small"><%= assets.length %> asset<%= assets.length === 1 ? '' : 's' %></p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th class="w-id">Tag</th><th class="w-sm">Category</th><th>Brand / model</th><th class="w-md">Serial</th><th class="w-md">Device name</th><th class="w-sm">Status</th><th class="w-md">Assigned to</th>
            <% for (const f of listFields) { %><th><%= f.label %></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% for (const a of assets) { %>
            <% const v = values.get(a.id) || {}; %>
            <tr data-filter-item data-search="<%= [a.asset_tag, a.category_name, a.brand, a.model, a.serial_number, a.device_name, a.wifi_mac, a.ethernet_mac, a.person_name, a.location, a.sold_to, ...Object.values(v)].filter(Boolean).join(' ') %>">
              <td class="nowrap"><a href="/inventory/assets/<%= a.id %>"><strong><%= a.asset_tag %></strong></a></td>
              <td><%= a.category_name || '' %></td>
              <td><%= [a.brand, a.model].filter(Boolean).join(' ') %></td>
              <td class="nowrap"><%= a.serial_number || '' %></td>
              <td class="nowrap"><%= a.device_name || '' %></td>
              <td><%- include('../_status', { status: a.status }) %></td>
              <td><% if (a.person_id) { %><a href="/inventory/people/<%= a.person_id %>"><%= a.person_name %></a><% } else if (a.status === 'sold' && a.sold_to) { %><span class="muted">Sold to <%= a.sold_to %></span><% } %></td>
              <% for (const f of listFields) { %><td><%= f.field_type === 'boolean' ? (v[f.id] === 'yes' ? 'Yes' : v[f.id] === 'no' ? 'No' : '') : (v[f.id] || '') %></td><% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../../partials/foot') %>
