<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <h1>Stock categories</h1>
    <p class="muted">Each category can have its own extra fields. New categories show up in employee profiles (Equipment) and the reports straight away. Drag to reorder.</p>
  </div>
</header>
<%- include('_nav', { active: 'categories' }) %>

<div class="grid-2 grid-wide-left">
  <section class="card">
    <h2>Categories</h2>
    <ul class="rows step-list" data-sortable-list data-order-url="/inventory/stock/categories/order">
      <% for (const c of categories) { %>
        <li class="row" data-id="<%= c.id %>">
          <span class="drag-handle" title="Drag to reorder" aria-hidden="true"><%- icon('grip') %></span>
          <div class="row-main">
            <a href="/inventory/stock?category=<%= c.id %>"><strong><%= c.name %></strong></a>
            <div class="muted small">
              <%= counts[c.id] || 0 %> item<%= (counts[c.id] || 0) === 1 ? '' : 's' %>
              <% if (c.fields.length) { %> · <%= c.fields.map((f) => f.label).join(', ') %><% } %>
              <% if (c.group_by === 'platform') { %> · report: Windows / Apple<% } else if (c.group_by === 'field') { const gf = c.fields.find((f) => f.id === c.group_field_id); %> · report: by <%= gf ? gf.label : 'field' %><% } %>
            </div>
          </div>
          <div class="row-actions">
            <a href="/inventory/stock/categories/<%= c.id %>/fields" class="btn btn-small btn-ghost">Fields</a>
            <details class="edit">
              <summary class="icon-btn" title="Edit" aria-label="Edit <%= c.name %>"><%- icon('edit') %></summary>
              <div class="edit-panel">
                <form method="post" action="/inventory/stock/categories/<%= c.id %>" class="form">
                  <%- csrfField %>
                  <label class="field"><span>Name</span><input type="text" name="name" value="<%= c.name %>" required maxlength="100"></label>
                  <label class="field">
                    <span>Breakdown report groups by</span>
                    <select name="group_by">
                      <option value="none" <%= c.group_by === 'none' ? 'selected' : '' %>>Brand only</option>
                      <option value="platform" <%= c.group_by === 'platform' ? 'selected' : '' %>>Windows / Apple, then brand</option>
                      <% const dropdowns = c.fields.filter((f) => f.field_type === 'dropdown'); %>
                      <% if (dropdowns.length) { %><option value="field" <%= c.group_by === 'field' ? 'selected' : '' %>>A dropdown field, then brand</option><% } %>
                    </select>
                  </label>
                  <% if (dropdowns.length) { %>
                    <label class="field">
                      <span>Dropdown field</span>
                      <select name="group_field_id">
                        <% for (const f of dropdowns) { %><option value="<%= f.id %>" <%= c.group_field_id === f.id ? 'selected' : '' %>><%= f.label %></option><% } %>
                      </select>
                    </label>
                  <% } %>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                  </div>
                </form>
              </div>
            </details>
            <% if (!counts[c.id]) { %>
              <%- include('../../partials/delete', { action: `/inventory/stock/categories/${c.id}/delete`, confirm: `Delete the category "${c.name}" and its fields?`, label: `Delete ${c.name}` }) %>
            <% } %>
          </div>
        </li>
      <% } %>
    </ul>
    <p class="small" data-reorder-status role="status" hidden></p>
  </section>
  <section class="card">
    <h2>Add category</h2>
    <form method="post" action="/inventory/stock/categories" class="form">
      <%- csrfField %>
      <label class="field"><span>Name</span><input type="text" name="name" required maxlength="100" placeholder="e.g. Webcam"></label>
      <p class="muted small">Add its extra fields (e.g. Resolution) with "Fields" once it is created.</p>
      <div class="form-actions"><button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Add category</span></button></div>
    </form>
  </section>
</div>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1/Sortable.min.js"></script>
<%- include('../../partials/foot') %>
