<%- include('../../partials/head') %>
<header class="page-head">
  <div>
    <h1>Stock</h1>
    <p class="muted">Every item, one row each. Click a row to edit, assign or return it.</p>
  </div>
  <div class="actions">
    <% if (category) { %><a href="/inventory/stock/categories/<%= category.id %>/fields" class="btn"><%- icon('sliders') %><span>Columns</span></a><% } %>
    <a href="/inventory/stock/template.xlsx" class="btn" title="Excel template with categories, statuses and category fields"><%- icon('download') %><span>Template</span></a>
    <a href="/inventory/stock/import" class="btn"><%- icon('upload') %><span>Import</span></a>
    <a href="/inventory/stock/multiple<%= category ? `?category=${category.id}` : '' %>" class="btn"><%- icon('layers') %><span>Add multiple</span></a>
    <a href="/inventory/stock/new<%= category ? `?category=${category.id}` : '' %>" class="btn btn-primary"><%- icon('plus') %><span>Add item</span></a>
  </div>
</header>
<%- include('_nav', { active: 'items' }) %>

<form method="get" action="/inventory/stock" class="card inv-filters">
  <label class="field">
    <span>Category</span>
    <select name="category" data-autosubmit>
      <option value="">All categories</option>
      <% for (const c of categories) { %><option value="<%= c.id %>" <%= category && category.id === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Status</span>
    <select name="status" data-autosubmit>
      <option value="">Any status</option>
      <% for (const [k, label] of Object.entries(stockStatuses)) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= label %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Brand</span>
    <select name="brand" data-autosubmit>
      <option value="">Any brand</option>
      <% for (const b of brands) { %><option value="<%= b %>" <%= brand.toLowerCase() === b.toLowerCase() ? 'selected' : '' %>><%= b %></option><% } %>
    </select>
  </label>
  <label class="field">
    <span>Assigned</span>
    <select name="holder" data-autosubmit>
      <option value="">Assigned or not</option>
      <option value="assigned" <%= holder === 'assigned' ? 'selected' : '' %>>Assigned to someone</option>
      <option value="unassigned" <%= holder === 'unassigned' ? 'selected' : '' %>>Not assigned</option>
    </select>
  </label>
  <noscript><button type="submit" class="btn">Apply</button></noscript>
  <% if (category || status || brand || holder) { %><a href="/inventory/stock" class="btn btn-ghost btn-small">Clear</a><% } %>
</form>
<% if (!category) { %><p class="muted small">Choose a category to see its extra columns (e.g. Device name, Wi-Fi MAC for laptops).</p><% } %>

<%- include('../_grid', { columns, rows, orderUrl, csvName: `stock${category ? '-' + category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-') : ''}`, empty: 'No items match.' }) %>
<%- include('../../partials/foot') %>
