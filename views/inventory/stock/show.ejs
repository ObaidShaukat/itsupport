<%- include('../../partials/head') %>
<% const here = `/inventory/stock/${item.id}`; %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/inventory/stock">Stock</a></p>
    <h1><%= [item.brand, item.model].filter(Boolean).join(' ') %></h1>
    <p class="muted small"><%= item.category_name || 'Uncategorised' %> · <%= invConnections[item.connection] %><%= item.location ? ` · ${item.location}` : '' %></p>
  </div>
  <div class="actions">
    <a href="<%= here %>/edit" class="btn"><%- icon('edit') %><span>Edit</span></a>
    <%- include('../../partials/delete', { action: `${here}/delete`, confirm: `Delete this stock item? This cannot be undone.`, text: 'Delete' }) %>
  </div>
</header>
<%- include('../_tabs') %>

<section class="stats">
  <div class="card stat"><span class="stat-icon"><%- icon('layers') %></span><span class="stat-value"><%= item.total_qty %></span><span class="stat-label">Total</span></div>
  <div class="card stat"><span class="stat-icon"><%- icon('users') %></span><span class="stat-value"><%= item.assigned_qty %></span><span class="stat-label">Assigned</span></div>
  <div class="card stat"><span class="stat-icon"><%- icon('check-circle') %></span><span class="stat-value"><%= item.available_qty %></span><span class="stat-label">Available<%= item.damaged_qty ? ` (${item.damaged_qty} damaged)` : '' %></span></div>
</section>

<div class="grid-2 grid-wide-left">
  <section class="card">
    <h2>Who has it</h2>
    <% const active = assignments.filter((a) => !a.returned_at); %>
    <% if (!active.length) { %><p class="empty">Nobody has this item.</p><% } else { %>
      <ul class="rows">
        <% for (const a of active) { %>
          <li class="row">
            <div class="row-main"><a href="/inventory/people/<%= a.person_id %>"><strong><%= a.person_name %></strong></a> <span class="muted small">× <%= a.quantity %><%= a.assigned_at ? ` since ${a.assigned_at}` : '' %><%= a.notes && a.notes !== 'Imported' ? ` · ${a.notes}` : '' %></span></div>
            <form method="post" action="/inventory/stock/assignments/<%= a.id %>/return" class="inline">
              <%- csrfField %><input type="hidden" name="back" value="<%= here %>">
              <button type="submit" class="btn btn-small btn-ghost">Returned</button>
            </form>
          </li>
        <% } %>
      </ul>
    <% } %>
    <% const returned = assignments.filter((a) => a.returned_at); %>
    <% if (returned.length) { %>
      <details class="history"><summary>Returned <span class="count"><%= returned.length %></span></summary>
        <ul class="rows rows-compact">
          <% for (const a of returned) { %><li class="row"><div class="row-main"><%= a.person_name %> <span class="muted small">× <%= a.quantity %> · returned <%= a.returned_at %></span></div></li><% } %>
        </ul>
      </details>
    <% } %>
  </section>

  <section class="card">
    <h2>Give to someone</h2>
    <% if (!item.available_qty) { %><p class="empty">None available.</p><% } else { %>
      <form method="post" action="<%= here %>/assign" class="form">
        <%- csrfField %>
        <label class="field">
          <span>Person</span>
          <select name="person_id" required>
            <option value="">Choose…</option>
            <% for (const p of people) { %><option value="<%= p.id %>"><%= p.name %></option><% } %>
          </select>
        </label>
        <label class="field"><span>Quantity (max <%= item.available_qty %>)</span><input type="number" name="quantity" value="1" min="1" max="<%= item.available_qty %>"></label>
        <div><button type="submit" class="btn btn-primary">Give</button></div>
      </form>
    <% } %>
    <%- include('../_cf-values', { fields, values }) %>
    <% if (item.notes) { %><p class="pre-line small"><%= item.notes %></p><% } %>
  </section>
</div>

<section class="card">
  <h2>History</h2>
  <% if (!log.length) { %><p class="empty">Nothing logged yet.</p><% } else { %>
    <ol class="timeline">
      <% for (const t of log) { %><li><div><%= t.summary %></div><div class="muted small"><%= t.username || 'Deleted user' %> · <%= fmtDate(t.created_at) %></div></li><% } %>
    </ol>
  <% } %>
</section>
<%- include('../../partials/foot') %>
