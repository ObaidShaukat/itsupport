<%#
  How one field's value shows on a record page. field, v ({ value, hasSecret } or
  undefined), recordId. Empty values show "—", with "Click to add" on hover when the
  page allows editing (CSS on .inv-value).
%>
<% if (field.field_type === 'password' || field.field_type === 'pin') { %>
  <% if (v && v.hasSecret) { %>
    <%- include('_secret', { recordId, field, hasSecret: true }) %>
  <% } else { %>
    <span class="inv-empty"><span class="muted">—</span><span class="inv-add-hint">Click to add</span></span>
  <% } %>
<% } else if (field.field_type === 'access') { %>
  <%- include('_cell', { cell: { kind: 'access', value: v ? v.value : null, granted: Boolean(v && v.value === 'granted') } }) %>
<% } else if (!v || !v.value) { %>
  <span class="inv-empty"><span class="muted">—</span><span class="inv-add-hint">Click to add</span></span>
<% } else { %>
  <%- include('_cell', { cell: { kind: field.field_type, value: v.value } }) %>
<% } %>
