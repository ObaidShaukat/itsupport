<%- include('../partials/head') %>
<%#
  Call Switch One customers (sidebar Call Switch One -> Customers), like the CallSwitch One
  dashboard Customers page: synced daily at 06:30 UK from the API (read only) and "Sync
  now". Company is the customer name on the call charges.
%>
<%
  const qs = (over) => {
    const p = new URLSearchParams();
    const all = { ...filters, ...over };
    for (const k of ['q', 'status', 'store', 'sort', 'dir']) if (all[k]) p.set(k, all[k]);
    const s = p.toString();
    return `/call-switch-one/customers${s ? `?${s}` : ''}`;
  };
  const col = (key, label, cls = '') => {
    const active = filters.sort === key;
    const dir = active && filters.dir === 'asc' ? 'desc' : 'asc';
    return `<th class="${cls}" aria-sort="${active ? (filters.dir === 'asc' ? 'ascending' : 'descending') : 'none'}"><a href="${qs({ sort: key, dir })}" class="sort-link ${active ? 'is-sorted' : ''}">${label}<span class="sort-arrow" aria-hidden="true">${active ? (filters.dir === 'asc' ? '▲' : '▼') : '↕'}</span></a></th>`;
  };
  const last = sync.last;
  const filtered = filters.q || filters.status || filters.store;
%>
<header class="page-head">
  <div>
    <p class="crumbs">Call Switch One</p>
    <h1>Customers</h1>
    <p class="muted">Our customer accounts in CallSwitch One. The company is the name used on the call charges; link a portal client if you like.</p>
  </div>
  <div class="actions">
    <details class="edit edit-right">
      <summary class="btn btn-small btn-ghost"><%- icon('plus') %><span>Add by hand</span></summary>
      <div class="edit-panel">
        <form method="post" action="/call-switch-one/customers" class="form">
          <%- csrfField %>
          <label class="field"><span>CS1 ID</span><input type="text" name="identifier" required maxlength="191" placeholder="CS1-123456" list="cs1-unknown-ids" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
          <label class="field"><span>Company</span><input type="text" name="name" required maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
          <label class="field"><span>Portal client <span class="muted">(optional)</span></span>
            <select name="client_id" data-combobox>
              <option value="">Not linked</option>
              <% for (const cl of clients) { %><option value="<%= cl.id %>"><%= cl.name %></option><% } %>
            </select>
          </label>
          <p class="muted small">The daily sync takes over this customer when CallSwitch One lists the same CS1 ID.</p>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
            <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
          </div>
        </form>
        <datalist id="cs1-unknown-ids"><% for (const u of unknown) { %><option value="<%= u.identifier %>"></option><% } %></datalist>
      </div>
    </details>
    <form method="post" action="/call-switch-one/customers/sync" class="inline">
      <%- csrfField %>
      <button type="submit" class="btn btn-small btn-primary" <%= api.configured ? '' : 'disabled' %> title="<%= api.configured ? 'Read the customer list from CallSwitch One now' : api.message %>"><%- icon('refresh') %><span>Sync now</span></button>
    </form>
  </div>
</header>

<% if (!api.configured) { %>
  <div class="cs1-sync is-off" role="status"><%- icon('alert') %><span><strong>Sync not set up.</strong> <%= api.message %> Until then, customers can be added by hand.</span></div>
<% } %>
<% if (last || api.configured) { %>
<div class="cs1-sync <%= last && last.status === 'failed' ? 'is-failed' : '' %>" role="status">
  <% if (last) { %>
    <% if (last.status === 'failed') { %>
      <%- icon('alert') %><span><strong>Last sync failed</strong> <%= fmtDate(last.started_at) %><%= last.trigger_type === 'schedule' ? ' (daily)' : last.user_name ? ` (${last.user_name})` : '' %>: <%= last.error %><% if (sync.lastOkAt) { %> <span class="muted">Last good sync <%= fmtDate(sync.lastOkAt) %>.</span><% } %></span>
    <% } else if (last.status === 'running') { %>
      <%- icon('refresh') %><span><strong>Sync running</strong> since <%= fmtTime(last.started_at) %>…</span>
    <% } else { %>
      <%- icon('check') %><span><strong>Last sync</strong> <%= fmtDate(last.finished_at || last.started_at) %><%= last.trigger_type === 'schedule' ? ' (daily)' : last.user_name ? ` (${last.user_name})` : '' %>: <%= last.total %> customers from CallSwitch One, <%= last.added %> added, <%= last.updated %> updated, <%= last.removed %> marked removed<%= last.rematched ? `, ${last.rematched} billing line${last.rematched === 1 ? '' : 's'} re-matched` : '' %>. <span class="muted">Syncs daily at 06:30.</span></span>
    <% } %>
    <% if (last.endpoint || last.fields) { %>
      <details class="cs1-fields">
        <summary>Details of the last sync</summary>
        <dl class="cs1-sync-details">
          <dt>Endpoint</dt><dd><code>GET <%= last.endpoint || '—' %></code></dd>
          <dt>HTTP status</dt><dd><%= last.http_status || '—' %></dd>
          <dt>Records</dt><dd><%= last.records === null || last.records === undefined ? '—' : last.records %></dd>
          <dt>Fields returned</dt><dd><code><%= last.fields || '—' %></code></dd>
          <dt>Sample IDs</dt><dd><code><%= last.sample_ids || '—' %></code></dd>
          <% if (last.status === 'ok') { %><dt>Billing re-matched</dt><dd><%= last.rematched || 0 %> line<%= last.rematched === 1 ? '' : 's' %> in saved months now have a company</dd><% } %>
        </dl>
      </details>
    <% } %>
  <% } else if (api.configured) { %>
    <%- icon('clock') %><span>Not synced yet. It runs every day at 06:30, or use <strong>Sync now</strong>.</span>
  <% } %>
</div>
<% } %>

<section class="card">
  <form method="get" action="/call-switch-one/customers" class="cs1-filters">
    <input type="hidden" name="sort" value="<%= filters.sort %>"><input type="hidden" name="dir" value="<%= filters.dir %>">
    <label class="search cs1-search"><%- icon('search') %><input type="search" name="q" value="<%= filters.q %>" placeholder="Search company, ID, holder, email, client" aria-label="Search customers" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
    <select name="status" data-autosubmit aria-label="Filter by status">
      <option value="">All statuses</option>
      <% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% } %>
    </select>
    <select name="store" data-autosubmit aria-label="Filter by store">
      <option value="">All stores</option>
      <% for (const s of stores) { %><option value="<%= s %>" <%= filters.store === s ? 'selected' : '' %>><%= s %></option><% } %>
      <option value="-" <%= filters.store === '-' ? 'selected' : '' %>>No store</option>
    </select>
    <button type="submit" class="btn btn-small">Search</button>
    <% if (filtered) { %><a href="<%= qs({ q: '', status: '', store: '' }) %>" class="btn btn-small btn-ghost">Clear</a><% } %>
    <span class="muted small cs1-count"><%= customers.length %><%= filtered ? ` of ${total}` : '' %> customer<%= customers.length === 1 ? '' : 's' %><% if (unnamed) { %> · <span class="cs1-unknown-note"><%- icon('flag') %> <%= unnamed %> without a company</span><% } %></span>
  </form>
  <div class="table-wrap">
    <table class="table cs1-customers">
      <thead><tr>
        <%- col('registered', 'Registered', 'c-reg') %><%- col('status', 'Status', 'c-status') %><%- col('company', 'Company') %><%- col('holder', 'Account Holder', 'c-holder') %>
        <%- col('store', 'Store', 'c-store') %><%- col('id', 'ID', 'c-id') %><%- col('email', 'Email', 'c-email') %><%- col('users', 'Users', 'num c-users') %><%- col('numbers', 'Numbers', 'num c-numbers') %>
        <%- col('client', 'Linked portal client', 'c-client') %><th class="cs1-cust-actions"><span class="visually-hidden">Actions</span></th>
      </tr></thead>
      <tbody>
        <% for (const c of customers) { const synced = c.source === 'api'; %>
          <tr class="<%= c.removed_at ? 'is-removed' : '' %> <%= c.company ? '' : 'is-unknown' %>">
            <td><%= regDate(c.registered_on) || '—' %></td>
            <td><span class="status-pill is-<%= c.tone %>"><%= c.statusText %></span></td>
            <td title="<%= c.company || `Unknown (${c.identifier})` %>"><% if (c.company) { %><strong><%= c.company %></strong><% } else { %><span class="cs1-unknown-note"><%- icon('flag') %> Unknown (<%= c.identifier %>)</span><% } %></td>
            <td><%= c.account_holder || '' %></td>
            <td><%= c.store || '' %></td>
            <td><code><%= c.identifier %></code></td>
            <td><% if (c.email) { %><a href="mailto:<%= c.email %>"><%= c.email %></a><% } %></td>
            <td class="num"><%= c.users_count === null ? '' : c.users_count %></td>
            <td class="num"><%= c.numbers_count === null ? '' : c.numbers_count %></td>
            <td><% if (c.client_id) { %><a href="/clients/<%= c.client_id %>"><%= c.client_name %></a><% } else { %><span class="muted">—</span><% } %></td>
            <td class="cs1-row-actions">
              <details class="edit edit-right">
                <summary class="icon-btn" title="Edit" aria-label="Edit <%= c.identifier %>"><%- icon('edit') %></summary>
                <div class="edit-panel">
                  <form method="post" action="/call-switch-one/customers/<%= c.id %>" class="form">
                    <%- csrfField %>
                    <input type="hidden" name="back" value="<%= qs({}) %>">
                    <% if (synced) { %>
                      <p class="muted small"><strong><%= c.identifier %></strong> is synced from CallSwitch One<%= c.synced_at ? ` (last ${fmtShort(c.synced_at)})` : '' %>: change its details there.</p>
                    <% } else { %>
                      <label class="field"><span>CS1 ID</span><input type="text" name="identifier" value="<%= c.identifier %>" required maxlength="191" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
                    <% } %>
                    <% if (!synced || !c.company) { %>
                      <label class="field"><span>Company</span><input type="text" name="name" value="<%= c.company || '' %>" required maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
                    <% } %>
                    <label class="field"><span>Portal client <span class="muted">(optional)</span></span>
                      <select name="client_id" data-combobox>
                        <option value="">Not linked</option>
                        <% for (const cl of clients) { %><option value="<%= cl.id %>" <%= cl.id === c.client_id ? 'selected' : '' %>><%= cl.name %></option><% } %>
                      </select>
                    </label>
                    <div class="form-actions">
                      <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                      <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                    </div>
                  </form>
                </div>
              </details>
              <% if (!synced || c.removed_at) { %>
                <%- include('../partials/delete', { action: `/call-switch-one/customers/${c.id}/delete`, confirm: `Delete ${c.company || c.identifier}? Months already sent keep the name they used.`, label: `Delete ${c.identifier}` }) %>
              <% } %>
            </td>
          </tr>
        <% } %>
        <% if (!customers.length) { %><tr><td colspan="11" class="empty"><%= total ? 'No customers match.' : (api.configured ? 'No customers yet: use Sync now.' : 'No customers yet. Set up the sync, or add them by hand.') %></td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<% if (unknown.length) { %>
  <section class="card">
    <h2>In uploads but not a customer <span class="muted small">(<%= unknown.length %>)</span></h2>
    <p class="muted small">These CS1 IDs are in a CDR file but CallSwitch One did not list them. They show as "Unknown (ID)" on the call charges until they have a company.</p>
    <ul class="cs1-unknown-list">
      <% for (const u of unknown) { %>
        <li>
          <form method="post" action="/call-switch-one/customers" class="cs1-addname">
            <%- csrfField %>
            <input type="hidden" name="identifier" value="<%= u.identifier %>">
            <code title="Last seen <%= monthLabel(u.last_month) %>"><%= u.identifier %></code>
            <input type="text" name="name" placeholder="Add company" maxlength="200" required aria-label="Company for <%= u.identifier %>" autocomplete="off" data-1p-ignore data-lpignore="true">
            <button type="submit" class="icon-btn" title="Save company" aria-label="Save company"><%- icon('check') %></button>
          </form>
        </li>
      <% } %>
    </ul>
  </section>
<% } %>
<%- include('../partials/foot') %>
