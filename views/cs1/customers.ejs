<%- include('../partials/head') %>
<%#
  Call Switch One customers (sidebar Call Switch One -> Customers). Two sources:
  "Refresh from CallSwitch" (the dashboard list pasted from the person's own logged-in browser:
  CS1 IDs and every detail) and the daily API sync (06:30 + Sync now: Company and new / removed
  customers only). Company is the customer name on the call charges.
%>
<%
  const qs = (over) => {
    const p = new URLSearchParams();
    const all = { ...filters, ...over };
    for (const k of ['q', 'status', 'store', 'sort', 'dir', 'demo']) if (all[k]) p.set(k, all[k]);
    const s = p.toString();
    return `/call-switch-one/customers${s ? `?${s}` : ''}`;
  };
  const col = (key, label, cls = '') => {
    const active = filters.sort === key;
    const dir = active && filters.dir === 'asc' ? 'desc' : 'asc';
    return `<th class="${cls}" aria-sort="${active ? (filters.dir === 'asc' ? 'ascending' : 'descending') : 'none'}"><a href="${qs({ sort: key, dir })}" class="sort-link ${active ? 'is-sorted' : ''}">${label}<span class="sort-arrow" aria-hidden="true">${active ? (filters.dir === 'asc' ? '▲' : '▼') : '↕'}</span></a></th>`;
  };
  const dash = '—';
  const last = sync.last;
  const refresh = sync.refresh;
  const filtered = filters.q || filters.status || filters.store;
  const by = (run) => (run.trigger_type === 'schedule' ? ' (daily)' : run.user_name ? ` by ${run.user_name}` : '');
%>
<header class="page-head">
  <div>
    <p class="crumbs">Call Switch One</p>
    <h1>Customers</h1>
    <p class="muted">Our customer accounts in CallSwitch One. The company is the name used on the call charges; link a portal client if you like.</p>
  </div>
  <div class="actions">
    <details class="edit edit-right">
      <summary class="btn btn-small btn-ghost"><%- icon('plus') %><span>Add by hand</span></summary>
      <div class="edit-panel">
        <form method="post" action="/call-switch-one/customers" class="form">
          <%- csrfField %>
          <label class="field"><span>CS1 ID</span><input type="text" name="identifier" required maxlength="191" placeholder="CS1-123456" list="cs1-unknown-ids" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
          <label class="field"><span>Company</span><input type="text" name="name" required maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
          <label class="field"><span>Portal client <span class="muted">(optional)</span></span>
            <select name="client_id" data-combobox>
              <option value="">Not linked</option>
              <% for (const cl of clients) { %><option value="<%= cl.id %>"><%= cl.name %></option><% } %>
            </select>
          </label>
          <p class="muted small">Saved as a Manual customer. Refresh from CallSwitch takes it over when CallSwitch lists the same CS1 ID.</p>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
            <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
          </div>
        </form>
        <datalist id="cs1-unknown-ids"><% for (const u of unknown) { %><option value="<%= u.identifier %>"></option><% } %></datalist>
      </div>
    </details>
    <form method="post" action="/call-switch-one/customers/sync" class="inline">
      <%- csrfField %>
      <button type="submit" class="btn btn-small" <%= api.configured ? '' : 'disabled' %> title="<%= api.configured ? 'Check the CallSwitch One API for company names and new or removed customers (at most once every 5 minutes)' : api.message %>"><%- icon('refresh') %><span>Sync now</span></button>
    </form>
    <a href="<%= dashboardUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-small btn-primary" data-cs1-refresh-open title="Opens the CallSwitch customer list in a new tab (you must be logged in to CallSwitch)"><%- icon('external') %><span>Refresh from CallSwitch</span></a>
  </div>
</header>

<%# Top line: counts, the last refresh (dashboard list) and the last API sync with their results. %>
<div class="cs1-topline">
  <p class="cs1-topline-counts"><strong><%= listed %> customer<%= listed === 1 ? '' : 's' %></strong><% if (needsId) { %> · <a href="<%= qs({ status: 'Missing CS1 ID' }) %>" class="cs1-unknown-note"><%- icon('flag') %> <%= needsId %> missing CS1 ID</a><% } else { %> · <span class="muted">0 missing CS1 ID</span><% } %></p>
  <p class="cs1-topline-run">
    <%- icon('external') %><span><strong>Last refresh:</strong>
    <% if (refresh) { %>
      <%= fmtDate(refresh.finished_at || refresh.started_at) %><%= by(refresh) %>: <%= refresh.total %> customers from CallSwitch, <%= refresh.added %> new, <%= refresh.updated %> updated<%= refresh.rematched ? `, ${refresh.rematched} billing line${refresh.rematched === 1 ? '' : 's'} named` : '' %>.
    <% } else { %>
      <span class="muted">never. Click Refresh from CallSwitch to load the CS1 IDs, users and numbers.</span>
    <% } %></span>
  </p>
  <p class="cs1-topline-run <%= last && last.status === 'failed' ? 'is-failed' : '' %>">
    <%- icon(last && last.status === 'failed' ? 'alert' : 'refresh') %><span><strong>Last sync:</strong>
    <% if (!api.configured) { %>
      <span class="muted">not set up. <%= api.message %></span>
    <% } else if (!last) { %>
      <span class="muted">never. It runs every day at 06:30, or use Sync now.</span>
    <% } else if (last.status === 'failed') { %>
      failed <%= fmtDate(last.started_at) %><%= by(last) %>: <%= last.error %><% if (sync.lastOkAt) { %> <span class="muted">Last good sync <%= fmtDate(sync.lastOkAt) %>.</span><% } %>
    <% } else if (last.status === 'running') { %>
      running since <%= fmtTime(last.started_at) %>…
    <% } else { %>
      <%= fmtDate(last.finished_at || last.started_at) %><%= by(last) %>: <%= last.total %> from the API, <%= last.added %> new, <%= last.updated %> company name<%= last.updated === 1 ? '' : 's' %> updated, <%= last.removed %> removed. <span class="muted">Daily at 06:30.</span>
    <% } %></span>
    <% if (last && (last.endpoint || last.fields)) { %>
      <details class="cs1-fields">
        <summary>Details</summary>
        <dl class="cs1-sync-details">
          <dt>Endpoint</dt><dd><code>GET <%= last.endpoint || dash %></code></dd>
          <dt>HTTP status</dt><dd><%= last.http_status || dash %></dd>
          <dt>Records</dt><dd><%= last.records === null || last.records === undefined ? dash : last.records %></dd>
          <dt>Fields returned</dt><dd><code><%= last.fields || dash %></code></dd>
          <% if (last.status === 'ok') { %><dt>Billing re-matched</dt><dd><%= last.rematched || 0 %> line<%= last.rematched === 1 ? '' : 's' %></dd><% } %>
        </dl>
      </details>
    <% } %>
  </p>
</div>

<details class="card cs1-refresh" id="refresh" data-cs1-refresh>
  <summary><%- icon('external') %> <strong>Refresh from CallSwitch</strong> <span class="muted small">CS1 IDs, companies, account holders, users and numbers from the CallSwitch dashboard</span></summary>
  <p><a href="<%= dashboardUrl %>" target="_blank" rel="noopener noreferrer">Open the CallSwitch customer list</a> in a new tab. If you're logged in to CallSwitch, copy everything on that page (<kbd>Ctrl</kbd>+<kbd>A</kbd>, <kbd>Ctrl</kbd>+<kbd>C</kbd>) and paste it below, or save it with <kbd>Ctrl</kbd>+<kbd>S</kbd> and upload the file.</p>
  <p class="muted small">You'll see a preview before anything is saved. Your CallSwitch login is never sent to or kept by the portal, and the pasted text is not stored.</p>
  <form method="post" action="/call-switch-one/customers/refresh" enctype="multipart/form-data" class="form">
    <%- csrfField %>
    <label class="field">
      <span>Paste the page here</span>
      <textarea name="json" rows="6" class="cs1-paste" data-spell="off" placeholder='{"status_code":200,"result":[ ... ]}' spellcheck="false" autocomplete="off" data-1p-ignore data-lpignore="true"></textarea>
    </label>
    <label class="field"><span>Or upload the saved page <span class="muted">(.json or .txt)</span></span><input type="file" name="file" accept=".json,.txt,application/json,text/plain"></label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%- icon('eye') %><span>Preview</span></button>
    </div>
  </form>
</details>

<section class="card">
  <form method="get" action="/call-switch-one/customers" class="cs1-filters">
    <input type="hidden" name="sort" value="<%= filters.sort %>"><input type="hidden" name="dir" value="<%= filters.dir %>"><% if (filters.demo) { %><input type="hidden" name="demo" value="1"><% } %>
    <label class="search cs1-search"><%- icon('search') %><input type="search" name="q" value="<%= filters.q %>" placeholder="Search" aria-label="Search customers" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
    <select name="status" data-autosubmit aria-label="Filter by status">
      <option value="">All statuses</option>
      <% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% } %>
    </select>
    <select name="store" data-autosubmit aria-label="Filter by store">
      <option value="">All stores</option>
      <% for (const s of stores) { %><option value="<%= s %>" <%= filters.store === s ? 'selected' : '' %>><%= s %></option><% } %>
      <option value="-" <%= filters.store === '-' ? 'selected' : '' %>>No store</option>
    </select>
    <button type="submit" class="btn btn-small">Search</button>
    <% if (filtered) { %><a href="<%= qs({ q: '', status: '', store: '' }) %>" class="btn btn-small btn-ghost">Clear</a><% } %>
    <% if (demoCount) { %><a href="<%= qs({ demo: filters.demo ? '' : '1' }) %>" class="btn btn-small btn-ghost"><%= filters.demo ? 'Hide' : 'Show' %> demo accounts (<%= demoCount %>)</a><% } %>
    <span class="muted small cs1-count"><%= customers.length %><%= filtered ? ` of ${total}` : '' %> shown</span>
  </form>
  <div class="table-wrap">
    <table class="table cs1-customers">
      <thead><tr>
        <%- col('registered', 'Registered', 'c-reg') %><%- col('status', 'Status', 'c-status') %><%- col('company', 'Company') %><%- col('holder', 'Account Holder', 'c-holder') %>
        <%- col('store', 'Store', 'c-store') %><%- col('id', 'CS1 ID', 'c-id') %><%- col('email', 'Email', 'c-email') %><%- col('phone', 'Phone', 'c-phone') %>
        <%- col('users', 'Users', 'num c-users') %><%- col('numbers', 'Numbers', 'num c-numbers') %><%- col('client', 'Linked portal client', 'c-client') %>
        <th class="cs1-cust-actions">Actions</th>
      </tr></thead>
      <tbody>
        <% for (const c of customers) { const synced = c.source === 'api'; %>
          <tr class="<%= c.removed_at ? 'is-removed' : '' %> <%= c.company ? '' : 'is-unknown' %>">
            <td><%= regDate(c.registered_on) || dash %></td>
            <td><span class="status-pill is-<%= c.tone %>" title="<%= c.ceasedText ? `Ceased ${c.ceasedText}` : c.statusText === 'New' ? 'New, CS1 ID missing' : c.removed_at ? 'No longer returned by CallSwitch' : '' %>"><%= c.statusText %><%= c.ceasedText ? ` ${c.ceasedText}` : '' %></span></td>
            <td title="<%= c.company || `Unknown (${c.identifier || 'no CS1 ID'})` %>"><% if (c.company) { %><strong><%= c.company %></strong><% if (c.is_demo) { %> <span class="chip">Demo</span><% } %><% } else { %><span class="cs1-unknown-note"><%- icon('flag') %> Unknown (<%= c.identifier || 'no CS1 ID' %>)</span><% } %></td>
            <td><%= c.account_holder || dash %></td>
            <td><%= c.store || dash %></td>
            <td><% if (c.identifier) { %><code><%= c.identifier %></code><% } else { %><span class="cs1-unknown-note" title="New, CS1 ID missing: use Refresh from CallSwitch (or Edit)"><%- icon('flag') %> Missing</span><% } %></td>
            <td><% if (c.email) { %><a href="mailto:<%= c.email %>"><%= c.email %></a><% } else { %><%= dash %><% } %></td>
            <td><%= c.phone || dash %></td>
            <td class="num"><%= c.users_count === null || c.users_count === undefined ? dash : c.users_count %></td>
            <td class="num"><%= c.numbers_count === null || c.numbers_count === undefined ? dash : c.numbers_count %></td>
            <td><% if (c.client_id) { %><a href="/clients/<%= c.client_id %>"><%= c.client_name %></a><% } else { %><span class="muted"><%= dash %></span><% } %></td>
            <td class="cs1-row-actions">
              <details class="edit edit-right">
                <summary class="icon-btn" title="Edit" aria-label="Edit <%= c.company || c.identifier || 'customer' %>"><%- icon('edit') %></summary>
                <div class="edit-panel">
                  <form method="post" action="/call-switch-one/customers/<%= c.id %>" class="form">
                    <%- csrfField %>
                    <input type="hidden" name="back" value="<%= qs({}) %>">
                    <% if (synced && !c.identifier) { %>
                      <p class="muted small"><strong><%= c.company || 'This customer' %></strong> has no CS1 ID yet. Use Refresh from CallSwitch, or type it here.</p>
                      <label class="field"><span>CS1 ID</span><input type="text" name="identifier" value="" placeholder="CS1-123456" maxlength="40" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
                    <% } else if (synced) { %>
                      <p class="muted small"><strong><%= c.identifier %></strong> comes from CallSwitch<%= c.refreshed_at ? ` (refreshed ${fmtShort(c.refreshed_at)})` : '' %>: change its details there.</p>
                    <% } else { %>
                      <label class="field"><span>CS1 ID</span><input type="text" name="identifier" value="<%= c.identifier %>" required maxlength="191" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
                    <% } %>
                    <% if (!synced || !c.company) { %>
                      <label class="field"><span>Company</span><input type="text" name="name" value="<%= c.company || '' %>" required maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
                    <% } %>
                    <label class="field"><span>Portal client <span class="muted">(optional)</span></span>
                      <select name="client_id" data-combobox>
                        <option value="">Not linked</option>
                        <% for (const cl of clients) { %><option value="<%= cl.id %>" <%= cl.id === c.client_id ? 'selected' : '' %>><%= cl.name %></option><% } %>
                      </select>
                    </label>
                    <div class="form-actions">
                      <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                      <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                    </div>
                  </form>
                </div>
              </details>
              <% if (!synced || c.removed_at) { %>
                <%- include('../partials/delete', { action: `/call-switch-one/customers/${c.id}/delete`, confirm: `Delete ${c.company || c.identifier || 'this customer'}? Months already sent keep the name they used.`, label: `Delete ${c.company || c.identifier || 'customer'}` }) %>
              <% } %>
            </td>
          </tr>
        <% } %>
        <% if (!customers.length) { %><tr><td colspan="12" class="empty"><%= total ? 'No customers match.' : 'No customers yet. Click Refresh from CallSwitch.' %></td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<% if (unknown.length) { %>
  <details class="card cs1-unknown">
    <summary><strong>Unknown CS1 IDs in uploads</strong> <span class="count-badge"><%= unknown.length %></span> <span class="muted small">in CDR files but matching no CallSwitch customer</span></summary>
    <p class="muted small">They show as "Unknown (ID)" on the call charges. Name one here to save it as a Manual customer; saved billing months pick the name up straight away.</p>
    <ul class="cs1-unknown-list">
      <% for (const u of unknown) { %>
        <li>
          <form method="post" action="/call-switch-one/customers" class="cs1-addname">
            <%- csrfField %>
            <input type="hidden" name="identifier" value="<%= u.identifier %>">
            <code title="Last seen <%= monthLabel(u.last_month) %>"><%= u.identifier %></code>
            <input type="text" name="name" placeholder="Add company" maxlength="200" required aria-label="Company for <%= u.identifier %>" autocomplete="off" data-1p-ignore data-lpignore="true">
            <button type="submit" class="icon-btn" title="Save company" aria-label="Save company"><%- icon('check') %></button>
          </form>
        </li>
      <% } %>
    </ul>
  </details>
<% } %>
<%- include('../partials/foot') %>
