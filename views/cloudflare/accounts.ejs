<%- include('../partials/head') %>
<%#
  Cloudflare > Accounts: one Cloudflare account per customer, with its domain and problem
  counts, when the token last saw it and whether it still can. Accounts are not linked to
  clients (a domain can be linked to a client on its own page).
%>
<header class="page-head reveal">
  <div>
    <%- include('../partials/crumbs', { crumbs: [{ label: 'Cloudflare', href: '/cloudflare' }, { label: 'Accounts' }] }) %>
    <h1>Accounts</h1>
    <p class="muted">The Cloudflare accounts the token can see (one per customer).</p>
  </div>
  <div class="actions">
    <form method="post" action="/cloudflare/check" class="inline" data-busy-label="Checking…">
      <%- csrfField %><input type="hidden" name="back" value="/cloudflare/accounts">
      <button type="submit" class="btn btn-small btn-primary" <%= config.configured ? '' : 'disabled' %>><%- icon('refresh') %><span>Check now</span></button>
    </form>
  </div>
</header>

<%- include('_status-banner', { config, check }) %>

<section class="panel reveal" id="cf-accounts">
  <% if (!accounts.length) { %>
    <p class="empty"><%= config.configured ? 'No accounts yet: click Check now.' : 'No accounts yet.' %></p>
  <% } else { %>
    <%- include('../partials/search', { target: '#cf-accounts', placeholder: 'Search accounts' }) %>
    <p class="empty" data-filter-empty hidden>No accounts match your search.</p>
    <div class="table-wrap">
      <table class="table cf-accounts-table">
        <thead>
          <tr><th>Cloudflare account</th><th class="w-num right">Domains</th><th class="w-num right">Problems</th><th class="w-15">Last seen</th><th class="w-sm">Access</th></tr>
        </thead>
        <tbody>
          <% for (const a of accounts) { %>
            <tr data-filter-item data-search="<%= a.name %>">
              <td title="<%= a.account_id %>"><a href="/cloudflare/domains?account=<%= a.id %>"><strong><%= a.name %></strong></a></td>
              <td class="right"><%= a.domain_count %></td>
              <td class="right"><% if (a.problems) { %><a href="/cloudflare/domains?account=<%= a.id %>&status=problems" class="cf-problems"><span class="led led-urgent" aria-hidden="true"></span><%= a.problems %></a><% } else { %><span class="muted">0</span><% } %></td>
              <td class="muted" title="<%= a.last_seen ? fmtDate(a.last_seen) : '' %>"><%= a.last_seen ? fmtAgo(a.last_seen) : '—' %></td>
              <td><% if (a.access_lost) { %><span class="status-pill is-bad" title="Since <%= fmtDate(a.access_lost_at) %>">Lost</span><% } else { %><span class="status-pill is-ok">OK</span><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/foot') %>
