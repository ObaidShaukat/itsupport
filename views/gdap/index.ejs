<%- include('../partials/head') %>
<%
  const last = sync.last;
  const failed = last && last.status === 'failed';
  const back = `/microsoft/partner${filter !== 'all' ? `?f=${filter}` : ''}`;
%>
<header class="page-head">
  <div>
    <%- include('../partials/crumbs', { crumbs: [{ label: 'Microsoft', href: '/microsoft' }, { label: 'Microsoft Partner' }] }) %>
    <h1>Microsoft Partner</h1>
    <p class="muted">GDAP (granular delegated admin) relationships with customers, read from Microsoft Partner Center (read only). End dates, roles and alerts.</p>
  </div>
  <div class="actions">
    <a href="/microsoft/partner/settings" class="btn btn-small btn-ghost"><%- icon('sliders') %><span>Settings</span></a>
    <form method="post" action="/microsoft/partner/sync" class="inline" data-busy-label="Syncing…">
      <%- csrfField %>
      <button type="submit" class="btn btn-small btn-primary" <%= config.configured ? '' : 'disabled' %>><%- icon('down') %><span>Sync now</span></button>
    </form>
  </div>
</header>

<% if (!config.configured) { %>
  <div class="flash flash-error gdap-banner" role="alert">
    <strong><%= config.message.split(":")[0] %>.</strong> <%= config.message.split(":").slice(1).join(":").trim() %>
    See the README (Microsoft Partner) for the app registration and its read-only permission.
  </div>
<% } else if (failed) { %>
  <div class="flash flash-error gdap-banner" role="alert">
    <strong>The last GDAP sync failed</strong> (<%= fmtDate(last.started_at) %>): <%= last.error %>
    <% if (sync.lastOk) { %><br><span class="small">Showing data from the last good sync, <%= fmtDate(sync.lastOk.finished_at) %>.</span><% } %>
  </div>
<% } %>

<div class="gdap-sync muted small">
  <% if (sync.lastOk) { %>
    <%- icon('check-circle') %> Last synced <strong title="<%= fmtDate(sync.lastOk.finished_at) %>"><%= fmtDate(sync.lastOk.finished_at) %></strong> (<%= fmtAgo(sync.lastOk.finished_at) %>) · <%= sync.lastOk.relationship_count %> relationship<%= sync.lastOk.relationship_count === 1 ? '' : 's' %> · syncs daily at 07:00
  <% } else if (last && last.status === 'running') { %>
    A sync is running (started <%= fmtAgo(last.started_at) %>).
  <% } else { %>
    Not synced yet<%= config.configured ? ': click Sync now.' : '.' %>
  <% } %>
</div>

<%# Instant ([data-list] in app.js) except "Multiple relationships", which is a page of its own (grouped by customer). %>
<div <%- grouped ? '' : 'data-list' %>>
<div class="gdap-cards">
  <a href="/microsoft/partner?f=active" class="gdap-card gdap-card-ok <%= filter === 'active' ? 'is-active' : '' %>" <%- grouped ? '' : 'data-list-set="f:active"' %>><span class="gdap-card-value"><%= summary.active %></span><span class="gdap-card-label">Active</span></a>
  <a href="/microsoft/partner?f=expiring30" class="gdap-card gdap-card-warn <%= filter === 'expiring30' ? 'is-active' : '' %>" <%- grouped ? '' : 'data-list-set="f:expiring30"' %>><span class="gdap-card-value"><%= summary.soon30 %></span><span class="gdap-card-label">Expiring ≤ 30 days</span></a>
  <a href="/microsoft/partner?f=expiring30" class="gdap-card gdap-card-bad" <%- grouped ? '' : 'data-list-set="f:expiring30"' %>><span class="gdap-card-value"><%= summary.soon7 %></span><span class="gdap-card-label">Expiring ≤ 7 days</span></a>
  <a href="/microsoft/partner?f=expired" class="gdap-card gdap-card-expired <%= filter === 'expired' ? 'is-active' : '' %>" <%- grouped ? '' : 'data-list-set="f:expired"' %>><span class="gdap-card-value"><%= summary.expired %></span><span class="gdap-card-label">Expired</span></a>
</div>

<section class="card">
  <div class="ticket-filters">
    <nav class="filters" aria-label="Filter GDAP relationships" <%- grouped ? '' : 'data-list-group="f"' %>>
      <% for (const [key, f] of Object.entries(filters)) { const instant = !grouped && key !== 'multiple'; %>
        <a href="/microsoft/partner<%= key === 'all' ? '' : `?f=${key}` %>" class="<%= filter === key ? 'active' : '' %>" <% if (instant) { %>data-list-value="<%= key %>" <%= key === 'all' ? 'data-list-default' : '' %><% } %>><%= f.label %> <span class="count"><%= counts[key] %></span></a>
      <% } %>
    </nav>
    <% if (grouped) { %>
      <%- include('../partials/search', { target: '#gdap-rows', placeholder: 'Search customer, client, relationship or role' }) %>
    <% } else { %>
      <label class="search-field">
        <%- icon('search') %>
        <span class="visually-hidden">Search customer, client, relationship, status or role</span>
        <input type="search" name="q" placeholder="Search" autocomplete="off" data-1p-ignore data-lpignore="true" data-list-search>
      </label>
    <% } %>
  </div>
  <div>
  <% if (supersededCount) { %>
    <div class="gdap-bulk">
      <span class="muted small"><%= supersededCount %> expired relationship<%= supersededCount === 1 ? '' : 's' %> where the customer already has an active one.</span>
      <form method="post" action="/microsoft/partner/hide-superseded" class="inline" data-confirm="Hide <%= supersededCount %> superseded relationship<%= supersededCount === 1 ? '' : 's' %>? They stop showing and never alert. You can unhide them under Hidden." data-confirm-ok="Hide all superseded">
        <%- csrfField %>
        <input type="hidden" name="back" value="<%= back %>">
        <button type="submit" class="btn btn-small btn-ghost"><%- icon('eye-off') %><span>Hide all superseded</span></button>
      </form>
    </div>
  <% } %>

  <div class="table-wrap">
    <table class="table gdap-table">
      <thead>
        <tr>
          <th class="gd-hide"><span class="visually-hidden">Hide or show</span></th>
          <th class="gd-customer">Customer</th>
          <th class="gd-client">Linked client</th>
          <th>Relationship name</th>
          <th class="gd-roles">Roles</th>
          <th class="gd-status">Status</th>
          <th class="gd-end">End date</th>
          <th class="gd-days">Days left</th>
          <th class="gd-extend">Auto-extend</th>
          <th class="gd-open"><span class="visually-hidden">Open in Partner Center</span></th>
        </tr>
      </thead>
      <tbody id="gdap-rows">
        <% let prevKey = null; %>
        <% for (const r of rows) { const groupStart = grouped && prevKey !== null && prevKey !== r.customerKey; prevKey = r.customerKey; %>
          <tr id="gdap-<%= r.id %>" class="gdap-row gdap-row-<%= r.band %> <%= groupStart ? 'gdap-group-start' : '' %> <%= r.hidden ? 'is-hidden' : '' %>" <% if (grouped) { %>data-filter-item data-search="<%= [r.customer_name, r.client_name, r.display_name, r.customer_tenant_id, ...r.roleList.map((x) => x.name)].filter(Boolean).join(' ') %>"<% } else { %>data-list-item data-search="<%= r.search %>" data-tags="<%= r.tags %>" data-rank="<%= r.rank %>" <%= r.visible ? '' : 'hidden' %><% } %>>
            <td class="gdap-hide-cell">
              <form method="post" action="/microsoft/partner/<%= r.id %>/hide" class="inline">
                <%- csrfField %>
                <input type="hidden" name="hide" value="<%= r.hidden ? '0' : '1' %>">
                <input type="hidden" name="back" value="<%= back %>">
                <button type="submit" class="icon-btn gdap-eye <%= r.hidden ? 'is-hidden' : '' %>" title="<%= r.hidden ? 'Unhide' : 'Hide' %> this relationship" aria-label="<%= r.hidden ? 'Unhide' : 'Hide' %> <%= r.display_name || 'relationship' %>"><%- icon(r.hidden ? 'eye-off' : 'eye') %></button>
              </form>
            </td>
            <td title="<%= r.customer_name || '' %><%= r.customer_tenant_id ? ` (${r.customer_tenant_id})` : '' %>"><% if (r.superseded) { %><span class="gdap-tag" title="Expired, and this customer has an active relationship">Superseded</span> <% } %><strong><%= r.customer_name || 'Unknown customer' %></strong></td>
            <td class="gdap-link-cell">
              <% if (r.client_id) { %><a href="/clients/<%= r.client_id %>" title="<%= r.client_name %>"><%= r.client_name %></a><% } else { %><span class="muted">Not linked</span><% } %>
              <details class="edit">
                <summary class="icon-btn gdap-link-edit" title="Link to client" aria-label="Link <%= r.customer_name || 'customer' %> to a client"><%- icon('link') %></summary>
                <div class="edit-panel">
                  <form method="post" action="/microsoft/partner/<%= r.id %>/link" class="form">
                    <%- csrfField %>
                    <input type="hidden" name="back" value="<%= back %>#gdap-<%= r.id %>">
                    <label class="field">
                      <span>Link <%= r.customer_name || 'customer' %> to client</span>
                      <select name="client_id" data-combobox>
                        <option value="auto">Match automatically by name</option>
                        <option value="" <%= !r.client_id && r.link_manual ? 'selected' : '' %>>Not linked</option>
                        <% for (const c of clients) { %>
                          <option value="<%= c.id %>" <%= r.client_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                        <% } %>
                      </select>
                    </label>
                    <p class="muted small"><%= r.link_manual ? 'Linked by hand.' : 'Matched automatically by name (Ltd / Limited and punctuation ignored).' %></p>
                    <div class="form-actions">
                      <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                      <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                    </div>
                  </form>
                </div>
              </details>
            </td>
            <td title="<%= r.display_name || '' %><%= r.durationText ? ` · ${r.durationText}` : '' %>"><%= r.display_name || '–' %></td>
            <td class="gdap-roles-cell" title="<%= r.roleList.map((x) => x.name).join(', ') || 'No roles' %>"><%- include('../partials/gdap-roles', { roles: r.roleList, max: 3 }) %></td>
            <td><span class="gdap-status gdap-status-<%= r.statusKey %>"><%= r.statusLabel %></span></td>
            <td title="<%= r.end_at ? fmtDate(r.end_at) : '' %>"><%= r.end_at ? fmtDay(r.end_at) : '–' %></td>
            <td><span class="gdap-days gdap-days-<%= r.band %>"><%= r.removed ? '–' : r.daysLabel %></span></td>
            <td><%= r.autoExtendText %></td>
            <td>
              <% if (r.partnerUrl) { %><a href="<%= r.partnerUrl %>" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Open <%= r.customer_name || 'customer' %> in Partner Center" aria-label="Open in Partner Center"><%- icon('external') %></a><% } %>
            </td>
          </tr>
        <% } %>
        <% if (grouped) { %><tr data-filter-empty hidden><td colspan="10" class="empty">No relationships match your search.</td></tr><% } %>
        <% if (!rows.length) { %>
          <tr><td colspan="10" class="empty"><%= sync.lastOk ? 'No relationships in this view.' : 'No GDAP relationships yet. They appear after the first sync.' %></td></tr>
        <% } else if (!grouped) { %>
          <tr data-list-empty <%= rows.some((r) => r.visible) ? 'hidden' : '' %>><td colspan="10" class="empty">No relationships match.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  </div>
</section>
</div>
<%- include('../partials/foot') %>
