<div class="media-caption">
  <div class="media-text">
    <strong class="media-title"><%= item.title || item.original_name %></strong>
    <% if (item.description) { %><p class="media-desc pre-line"><%= item.description %></p><% } %>
    <div class="muted small">
      <%= item.title ? `${item.original_name} · ` : '' %><%= fmtBytes(item.size_bytes) %>
      · <%= item.uploaded_by || 'Deleted user' %> · <%= fmtDate(item.created_at) %>
    </div>
  </div>
  <% if (mode === 'tutorial') { %>
    <div class="row-actions">
      <details class="edit">
        <summary class="icon-btn" title="Edit tutorial" aria-label="Edit tutorial"><%- icon('edit') %></summary>
        <div class="edit-panel">
          <form method="post" action="/tutorials/<%= item.id %>" enctype="multipart/form-data" class="form">
            <%- csrfField %>
            <label class="field">
              <span>Title</span>
              <input type="text" name="title" value="<%= item.title %>" required maxlength="255">
            </label>
            <label class="field">
              <span>Description</span>
              <textarea name="description" rows="3" maxlength="5000"><%= item.description || '' %></textarea>
            </label>
            <label class="field">
              <span>Replace file <span class="muted">(optional)</span></span>
              <input type="file" name="file">
            </label>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save</button>
              <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
            </div>
          </form>
        </div>
      </details>
      <%- include('delete', { action: `/tutorials/${item.id}/delete`, confirm: `Delete "${item.title}"?` }) %>
    </div>
  <% } else if (mode === 'attachment') { %>
    <div class="row-actions">
      <%- include('delete', { action: `/articles/attachments/${item.id}/delete`, confirm: `Remove "${item.original_name}"?` }) %>
    </div>
  <% } else if (mode === 'inline') { %>
    <div class="row-actions kb-file-actions">
      <details class="edit edit-right">
        <summary class="icon-btn" title="Rename" aria-label="Rename <%= item.original_name %>"><%- icon('pen') %></summary>
        <div class="edit-panel">
          <form method="post" action="/articles/attachments/<%= item.id %>/rename" class="form" data-kb-file-form>
            <%- csrfField %>
            <input type="hidden" name="back" value="<%= locals.back || '' %>">
            <label class="field"><span>File name</span><input type="text" name="name" value="<%= item.original_name %>" required maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true"></label>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
              <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
            </div>
          </form>
        </div>
      </details>
      <form method="post" action="/articles/attachments/<%= item.id %>/delete" class="inline" data-confirm="Delete &quot;<%= item.original_name %>&quot;? This cannot be undone." data-kb-file-form>
        <%- csrfField %>
        <input type="hidden" name="back" value="<%= locals.back || '' %>">
        <button type="submit" class="icon-btn icon-btn-danger" title="Delete" aria-label="Delete <%= item.original_name %>"><%- icon('trash') %></button>
      </form>
    </div>
  <% } %>
</div>
