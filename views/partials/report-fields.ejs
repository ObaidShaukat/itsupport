<%
  // Optional Daily Report fields. values: { report_action, report_issue, report_detail }.
  const v = locals.values || {};
  const actionId = v.report_action ? Number(v.report_action) : null;
%>
<fieldset class="report-fields">
  <legend>For the Daily Report <span class="muted">(optional)</span></legend>
  <div class="report-fields-row">
    <label class="field">
      <span>Action</span>
      <select name="report_action">
        <option value="">No action</option>
        <% for (const a of (locals.reportActions || [])) { %>
          <option value="<%= a.id %>" <%= a.id === actionId ? 'selected' : '' %>><%= a.name %></option>
        <% } %>
      </select>
    </label>
    <label class="field">
      <span>Issue</span>
      <input type="text" name="report_issue" value="<%= v.report_issue || '' %>" list="report-issues" maxlength="100" autocomplete="off" placeholder="Search, or type a new one">
    </label>
  </div>
  <label class="field">
    <span>Detail for report</span>
    <input type="text" name="report_detail" value="<%= v.report_detail || '' %>" maxlength="255" placeholder="e.g. rebuilt user profile, new starter Kay">
  </label>
</fieldset>
