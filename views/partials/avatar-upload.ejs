<%#
  Profile picture: choose a file, crop it in the popup (views/partials/crop-dialog.ejs,
  public/js/app.js) and Save, which uploads only the cropped 512 x 512 JPG. Without
  JavaScript the file is uploaded as chosen and the server uses its centre square.
  person: { id, name, avatar_file }; action: form URL (e.g. /profile/avatar); Remove
  posts to action + '/delete'. The server stores a 256 x 256 WebP.
%>
<div class="avatar-upload" data-avatar-upload>
  <div class="avatar-upload-current">
    <%- avatar(person, 'lg') %>
    <div class="muted small">JPG, PNG or WebP. Phone photos are fine: you crop the picture before it is saved.</div>
  </div>
  <form method="post" action="<%= action %>" enctype="multipart/form-data" class="form" data-avatar-form data-back="<%= action.startsWith('/profile') ? '/profile#picture' : '/users' %>">
    <%- csrfField %>
    <label class="field">
      <span>Choose a picture</span>
      <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required data-avatar-file>
    </label>
    <p class="field-error small" data-avatar-error hidden></p>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" data-avatar-submit><%- icon('upload') %><span>Save picture</span></button>
      <% if (person.avatar_file) { %>
        <button type="submit" class="btn btn-ghost" formaction="<%= action %>/delete" formenctype="application/x-www-form-urlencoded" formnovalidate>Remove picture</button>
      <% } %>
      <% if (locals.cancel) { %><button type="button" class="btn btn-ghost" data-cancel>Cancel</button><% } %>
    </div>
  </form>
</div>
