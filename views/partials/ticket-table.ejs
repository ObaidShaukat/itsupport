<% if (!tickets.length) { %>
  <p class="empty">No tickets<%= status ? ' with this status' : '' %>.</p>
<% } else { %>
  <p class="empty" data-filter-empty hidden>No tickets match your search.</p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <% if (locals.showClient) { %><th>Client</th><% } %>
          <th>Status</th>
          <th>Created by</th>
          <th>Updated</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const t of tickets) { %>
          <tr data-filter-item data-search="#<%= t.id %> <%= t.title %> <%= t.client_name || '' %> <%= ticketStatuses[t.status] %> <%= t.created_by || '' %>">
            <td class="muted"><%= t.id %></td>
            <td><a href="/tickets/<%= t.id %>"><%= t.title %></a></td>
            <% if (locals.showClient) { %><td><a href="/clients/<%= t.client_id %>"><%= t.client_name %></a></td><% } %>
            <td><%- include('status', { status: t.status }) %></td>
            <td class="nowrap"><%= t.created_by || 'Deleted user' %><div class="muted small"><%= fmtDate(t.created_at) %></div></td>
            <td class="muted nowrap"><%= fmtDate(t.updated_at) %></td>
            <td class="row-actions">
              <%- include('delete', {
                action: `/tickets/${t.id}/delete`,
                confirm: `Delete ticket '${t.title}'? This cannot be undone.`,
                back: locals.currentPath,
                label: `Delete ticket #${t.id}`,
              }) %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
