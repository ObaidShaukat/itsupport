<%#
  tickets: rows from listTickets(); controls.columns: sortable headers;
  filtered: true when a status/priority filter is applied. Instant ([data-list] in app.js): every
  row carries data-search / data-tags / data-rank / data-sort-* (instantTickets() in
  src/lib/ticket-list.js) and starts hidden when the address's filters leave it out.
  Fixed column widths, one line per cell (full text in the tooltip), priority as a
  flag at the start of the row, people as avatar + first name, delete in its own narrow last
  column (shown on row hover). Created by (cell-created) is hidden below 1280px.
%>
<% if (!tickets.length) { %>
  <p class="empty">No tickets yet.</p>
<% } else { %>
  <p class="empty" data-list-empty <%= tickets.some((t) => t.visible !== false) ? 'hidden' : '' %>>No tickets match these filters.</p>
  <div class="table-wrap">
    <table class="table table-tickets">
      <colgroup>
        <col class="col-flag"><col class="col-id"><col><col class="col-client"><col class="col-status">
        <col class="col-person col-created"><col class="col-person"><col class="col-updated"><col class="col-actions">
      </colgroup>
      <thead>
        <tr>
          <% for (const col of controls.columns) { %>
            <th aria-sort="<%= col.active ? (col.dir === 'asc' ? 'ascending' : 'descending') : 'none' %>" class="<%= col.key === 'updated' ? 'right' : col.key === 'created_by' ? 'cell-created' : '' %>">
              <% if (col.key === 'priority') { %>
                <a href="<%= col.href %>" class="sort-link sort-flag <%= col.active ? 'is-sorted' : '' %>" title="Sort by priority" aria-label="Sort by priority" data-list-sort="<%= col.key %>" data-list-dir="<%= col.first %>" <%- col.active ? 'data-list-current="' + col.dir + '"' : '' %>><span class="led led-sort" aria-hidden="true"></span></a>
              <% } else { %>
                <a href="<%= col.href %>" class="sort-link <%= col.active ? 'is-sorted' : '' %>" data-list-sort="<%= col.key %>" data-list-dir="<%= col.first %>" <%- col.active ? 'data-list-current="' + col.dir + '"' : '' %>><%= col.label %><span class="sort-arrow" aria-hidden="true"><%= col.active ? (col.dir === 'asc' ? '▲' : '▼') : '↕' %></span></a>
              <% } %>
            </th>
          <% } %>
          <th class="cell-actions"><span class="visually-hidden">Delete</span></th>
        </tr>
      </thead>
      <tbody>
        <% for (const t of tickets) { %>
          <tr class="ticket-row ticket-row-<%= t.priority %>" data-list-item data-search="<%= t.search %>" data-tags="<%= t.tags %>" data-rank="<%= t.rank %>" <% for (const [k, v] of Object.entries(t.sortValues || {})) { %>data-sort-<%= k.replace(/_/g, '-') %>="<%= v %>" <% } %><%= t.visible === false ? 'hidden' : '' %>>
            <td class="cell-flag"><%- include('priority', { priority: t.priority, dotOnly: true }) %></td>
            <td class="muted"><%= t.id %></td>
            <td title="<%= t.title %>">
              <a href="/tickets/<%= t.id %>"><%= t.title %></a>
              <% if (t.next_reminder_at) { %>
                <a href="/tickets/<%= t.id %>#reminders" class="row-reminder" title="Next reminder: <%= fmtDate(t.next_reminder_at) %>" aria-label="Next reminder: <%= fmtDate(t.next_reminder_at) %>"><%- icon('bell') %></a>
              <% } %>
              <% if (Number(t.attachment_count)) { %>
                <a href="/tickets/<%= t.id %>#attachments" class="row-files" title="<%= t.attachment_count %> attachment<%= Number(t.attachment_count) === 1 ? '' : 's' %>" aria-label="<%= t.attachment_count %> attachments"><%- icon('paperclip') %><span><%= t.attachment_count %></span></a>
              <% } %>
            </td>
            <td title="<%= t.client_name %>"><a href="/clients/<%= t.client_id %>"><%= t.client_name %></a></td>
            <td><%- include('status', { status: t.status }) %></td>
            <td class="cell-created" title="<%= t.created_by || 'Deleted user' %>"><span class="person"><%- avatar({ id: t.created_by_id, name: t.created_by }, 'xs') %><%= firstName(t.created_by) || 'Deleted user' %></span></td>
            <td title="<%= t.updated_by || '' %>"><% if (t.updated_by) { %><span class="person"><%- avatar({ id: t.updated_by_id, name: t.updated_by }, 'xs') %><%= firstName(t.updated_by) %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td class="right muted" title="<%= fmtDate(t.updated_at) %>"><%= fmtShort(t.updated_at) %></td>
            <td class="row-actions cell-actions">
              <%- include('delete', {
                action: `/tickets/${t.id}/delete`,
                confirm: `Delete ticket '${t.title}'? This cannot be undone.`,
                back: locals.currentPath,
                label: `Delete ticket #${t.id}`,
              }) %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (controls.resetSortHref) { %><p class="small"><a href="<%= controls.resetSortHref %>">Back to the default order</a> <span class="muted">(urgent first, then most recently updated)</span></p><% } %>
<% } %>
