  </main>
</div>
<% if (locals.currentUser) { %>
<datalist id="log-work-clients">
  <% for (const name of (locals.logWorkClients || [])) { %><option value="<%= name %>"><% } %>
</datalist>
<dialog class="dialog" id="log-work-dialog" aria-labelledby="log-work-title">
  <form method="post" action="/log-work" class="form">
    <%- locals.csrfField %>
    <input type="hidden" name="back" value="<%= locals.currentPath || '/' %>">
    <div class="dialog-head">
      <h2 id="log-work-title">Log work</h2>
      <button type="button" class="icon-btn" data-dialog-close aria-label="Close"><%- icon('x') %></button>
    </div>
    <label class="field">
      <span>Client <span class="muted">(optional)</span></span>
      <input type="text" name="client" list="log-work-clients" autocomplete="off" maxlength="200" placeholder="Search clients…" data-combobox>
    </label>
    <label class="field">
      <span>What did you do?</span>
      <textarea name="description" rows="4" required maxlength="2000" placeholder="e.g. Replaced the office printer toner and tested printing."></textarea>
    </label>
    <label class="field">
      <span>Date</span>
      <input type="date" name="date" value="<%= locals.today %>" required>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
    </div>
  </form>
</dialog>
<%# Quick-action rail "Add reminder": pick an open ticket, then its Reminders panel opens. %>
<dialog class="dialog" id="quick-reminder-dialog" aria-labelledby="quick-reminder-title">
  <form method="get" action="/tickets/remind" class="form">
    <div class="dialog-head">
      <h2 id="quick-reminder-title">Add reminder</h2>
      <button type="button" class="icon-btn" data-dialog-close aria-label="Close"><%- icon('x') %></button>
    </div>
    <label class="field">
      <span>Which ticket?</span>
      <select name="ticket" required data-combobox>
        <option value="">Choose a ticket…</option>
        <% for (const t of (locals.quickTickets || [])) { %><option value="<%= t.id %>">#<%= t.id %> <%= t.title %> · <%= t.client_name %></option><% } %>
      </select>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%- icon('bell') %><span>Add reminder</span></button>
      <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
    </div>
  </form>
</dialog>
<%- include('crop-dialog') %>
<% } %>
<div class="toasts" data-toasts aria-live="polite"><% if (locals.flash && flash.type === 'saved') { %><div class="toast toast-saved" role="status" data-autohide><span class="toast-icon toast-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M7.5 12.5l3 3 6-6.5"></path></svg></span><span><%= flash.message %></span></div><% } %></div>
<dialog class="dialog dialog-confirm" id="confirm-dialog" aria-labelledby="confirm-message">
  <p id="confirm-message" class="confirm-message"></p>
  <div class="form-actions">
    <button type="button" class="btn btn-ghost" data-confirm-cancel>Cancel</button>
    <button type="button" class="btn btn-danger-solid" data-confirm-ok>Delete</button>
  </div>
</dialog>
<script src="/js/app.js"></script>
</body>
</html>
