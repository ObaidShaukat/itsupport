<%#
  One task row. task: row from src/lib/tasks.js; href: link that opens it;
  back: where to return after ticking or starring.
%>
<li class="task <%= task.status === 'done' ? 'is-done' : '' %> <%= Number(task.overdue) ? 'is-overdue' : '' %> <%= locals.selected ? 'is-selected' : '' %>">
  <form method="post" action="/tasks/<%= task.id %>/toggle" class="inline task-toggle-form">
    <%- csrfField %>
    <input type="hidden" name="back" value="<%= back %>">
    <button type="submit" class="task-check" aria-pressed="<%= task.status === 'done' ? 'true' : 'false' %>" aria-label="<%= task.status === 'done' ? 'Mark as not done' : 'Mark as done' %>">
      <%- icon(task.status === 'done' ? 'check-circle' : 'circle') %>
    </button>
  </form>
  <a href="<%= href %>" class="task-main">
    <span class="task-title"><%= task.title %></span>
    <span class="task-meta">
      <% if (task.due_at) { %><span class="task-due"><%- icon('calendar') %><%= Number(task.overdue) ? 'Overdue · ' : '' %><%= fmtDate(task.due_at) %></span><% } %>
      <% if (task.remind_at && task.status !== 'done') { %><span><%- icon('bell') %><%= fmtDate(task.remind_at) %></span><% } %>
      <% if (task.client_name) { %><span><%- icon('briefcase') %><%= task.client_name %></span><% } %>
      <% if (task.ticket_id) { %><span><%- icon('message') %>#<%= task.ticket_id %><% if (task.ticket_title) { %> <%= task.ticket_title %><% } %></span><% } %>
      <span><%- icon('users') %><%= task.assigned_name || 'Unassigned' %></span>
      <% if (task.status === 'done' && task.completed_at) { %><span>Done <%= fmtDate(task.completed_at) %></span><% } %>
    </span>
  </a>
  <form method="post" action="/tasks/<%= task.id %>/star" class="inline">
    <%- csrfField %>
    <input type="hidden" name="back" value="<%= back %>">
    <button type="submit" class="task-star <%= task.important ? 'is-on' : '' %>" aria-pressed="<%= task.important ? 'true' : 'false' %>" aria-label="<%= task.important ? 'Remove importance' : 'Mark as important' %>" title="Important"><%- icon('star') %></button>
  </form>
</li>
