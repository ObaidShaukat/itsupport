<%#
  Reminders panel on the ticket page. reminders: { pending, done } from ticketReminders()
  (each with recipients and their state); ticket; users: people a reminder can be for.
  Each recipient marks it done or snoozes it for themselves; the creator can mark it done
  for everyone.
%>
<% const back = `/tickets/${ticket.id}#reminders`; %>
<div class="card-head">
  <h2><%- icon('bell') %> Reminders <span class="muted small">(<%= reminders.pending.length %> pending)</span></h2>
</div>

<details class="report-toggle reminder-add" <%= reminders.pending.length ? '' : 'open' %>>
  <summary><%- icon('plus') %> Add reminder</summary>
  <form method="post" action="/reminders" class="form" data-reminder-form>
    <%- csrfField %>
    <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
    <input type="hidden" name="back" value="<%= back %>">
    <%- include('reminder-fields', { reminder: null, users, defaultInput: reminders.defaultInput }) %>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
      <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
    </div>
  </form>
</details>

<% if (!reminders.pending.length) { %>
  <p class="empty">No pending reminders.</p>
<% } else { %>
  <ul class="reminder-list">
    <% for (const r of reminders.pending) {
      const mine = r.recipients.find((x) => x.user_id === currentUser.id);
      const isCreator = r.created_by === currentUser.id;
      const doneCount = r.recipients.filter((x) => x.done_at).length; %>
      <li class="reminder <%= r.is_due ? 'is-due' : '' %>">
        <div class="reminder-main">
          <div class="reminder-when">
            <%- icon('clock') %> <strong><%= fmtDate(r.remind_at) %></strong>
            <% if (r.is_due) { %><span class="chip chip-due">Due</span><% } %>
            <% if (r.recipients.length > 1) { %><span class="chip"><%= doneCount %> of <%= r.recipients.length %> done</span><% } %>
          </div>
          <% if (r.note) { %><p class="pre-line reminder-note"><%= r.note %></p><% } %>
          <ul class="recipient-list">
            <% for (const p of r.recipients) { %>
              <li class="recipient <%= p.done_at ? 'is-done' : '' %>" title="<%= p.done_at ? `Done ${fmtDate(p.done_at)}` : p.snoozed_until ? `Snoozed until ${fmtDate(p.snoozed_until)}` : 'Not done yet' %>">
                <%- avatar({ id: p.user_id, name: p.name }, 'xs') %>
                <span><%= p.name %></span>
                <% if (p.done_at) { %><span class="recipient-state"><%- icon('check') %> done</span><% } else if (p.snoozed_until) { %><span class="recipient-state muted">snoozed to <%= fmtTime(p.snoozed_until) %></span><% } %>
              </li>
            <% } %>
          </ul>
          <div class="muted small">Added by <%= r.created_name || 'Deleted user' %><% if (r.updated_name && r.updated_at > r.created_at) { %> · updated by <%= r.updated_name %><% } %></div>
        </div>
        <div class="reminder-actions">
          <% if (mine && !mine.done_at) { %>
            <form method="post" action="/reminders/<%= r.id %>/done" class="inline">
              <%- csrfField %>
              <input type="hidden" name="back" value="<%= back %>">
              <button type="submit" class="btn btn-small"><%- icon('check') %><span><%= r.recipients.length > 1 ? 'Done (me)' : 'Done' %></span></button>
            </form>
          <% } %>
          <% if (isCreator && (r.recipients.length > 1 || !mine)) { %>
            <form method="post" action="/reminders/<%= r.id %>/done" class="inline" data-confirm="Mark this reminder done for everyone?" data-confirm-ok="Done for everyone">
              <%- csrfField %>
              <input type="hidden" name="back" value="<%= back %>">
              <input type="hidden" name="everyone" value="1">
              <button type="submit" class="btn btn-small btn-ghost"><%- icon('check-circle') %><span>Done for everyone</span></button>
            </form>
          <% } %>
          <details class="edit edit-right">
            <summary class="btn btn-small btn-ghost"><%- icon('user-plus') %><span>Add people</span></summary>
            <div class="edit-panel">
              <form method="post" action="/reminders/<%= r.id %>/recipients" class="form" data-reminder-form>
                <%- csrfField %>
                <input type="hidden" name="back" value="<%= back %>">
                <%- include('reminder-people', { chosen: r.recipientIds, users }) %>
                <p class="muted small">New people get it at the due time; if that has passed<%= r.status === 'done' ? ' (or it is done)' : '' %>, they are emailed now.</p>
                <div class="form-actions">
                  <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                  <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                </div>
              </form>
            </div>
          </details>
          <details class="edit edit-right">
            <summary class="btn btn-small btn-ghost"><%- icon('edit') %><span>Edit</span></summary>
            <div class="edit-panel">
              <form method="post" action="/reminders/<%= r.id %>" class="form" data-reminder-form>
                <%- csrfField %>
                <input type="hidden" name="back" value="<%= back %>">
                <%- include('reminder-fields', { reminder: r, users, defaultInput: null }) %>
                <div class="form-actions">
                  <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                  <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                </div>
              </form>
            </div>
          </details>
          <%- include('delete', { action: `/reminders/${r.id}/delete`, confirm: 'Delete this reminder for everyone? This cannot be undone.', back, label: 'Delete reminder' }) %>
        </div>
      </li>
    <% } %>
  </ul>
<% } %>

<% if (reminders.done.length) { %>
  <details class="report-toggle reminder-done-list">
    <summary>Done (<%= reminders.done.length %>)</summary>
    <ul class="reminder-list">
      <% for (const r of reminders.done) { %>
        <li class="reminder is-done">
          <div class="reminder-main">
            <div class="reminder-when"><%- icon('check-circle') %> <span><%= fmtDate(r.remind_at) %></span></div>
            <% if (r.note) { %><p class="pre-line reminder-note"><%= r.note %></p><% } %>
            <div class="muted small">
              <%= r.recipients.map((p) => `${p.name}${p.done_at ? ` (done ${fmtDate(p.done_at)})` : ''}`).join(', ') || 'Nobody' %> · complete on <%= fmtDate(r.done_at) %>
            </div>
          </div>
          <div class="reminder-actions">
            <details class="edit edit-right">
              <summary class="btn btn-small btn-ghost"><%- icon('user-plus') %><span>Add people</span></summary>
              <div class="edit-panel">
                <form method="post" action="/reminders/<%= r.id %>/recipients" class="form" data-reminder-form>
                  <%- csrfField %>
                  <input type="hidden" name="back" value="<%= back %>">
                  <%- include('reminder-people', { chosen: r.recipientIds, users }) %>
                  <p class="muted small">New people get it at the due time; if that has passed<%= r.status === 'done' ? ' (or it is done)' : '' %>, they are emailed now.</p>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                    <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                  </div>
                </form>
              </div>
            </details>
            <%- include('delete', { action: `/reminders/${r.id}/delete`, confirm: 'Delete this reminder? This cannot be undone.', back, label: 'Delete reminder' }) %>
          </div>
        </li>
      <% } %>
    </ul>
  </details>
<% } %>
