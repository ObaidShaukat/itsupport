<% if (meta && (meta.createdAt || meta.updatedAt)) { %>
  <p class="record-meta">
    <% if (meta.createdAt) { %>
      <span>Created<%= meta.createdBy ? ` by ${meta.createdBy}` : '' %> on <%= fmtDate(meta.createdAt) %></span>
    <% } %>
    <% if (meta.updatedAt) { %>
      <span>Last updated by <%= meta.updatedBy %> on <%= fmtDate(meta.updatedAt) %></span>
    <% } %>
  </p>
<% } %>
