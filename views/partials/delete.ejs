<form method="post" action="<%= action %>" class="inline" data-confirm="<%= confirm %>">
  <%- csrfField %>
  <% if (locals.text) { %>
    <button type="submit" class="btn btn-danger"><%- icon('trash') %><span><%= text %></span></button>
  <% } else { %>
    <button type="submit" class="icon-btn icon-btn-danger" title="Delete" aria-label="Delete"><%- icon('trash') %></button>
  <% } %>
</form>
