<%# Priority as the pulsing LED dot (the only colour in the portal) with its name. dotOnly: the
    name is for screen readers only (cards, tight table cells). %>
<span class="priority priority-<%= priority %> <%= locals.dotOnly ? 'is-dot-only' : '' %>" title="<%= ticketPriorities[priority] || priority %> priority"><span class="led led-<%= priority %>" aria-hidden="true"></span><span class="<%= locals.dotOnly ? 'visually-hidden' : 'priority-label' %>"><%= ticketPriorities[priority] || priority %><%= locals.dotOnly ? ' priority' : '' %></span></span>
