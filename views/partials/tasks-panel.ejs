<%#
  Tasks panel for ticket and client pages. tasks: linked tasks; link: { ticket_id?, client_id? }
  pre-filled on "Add task".
%>
<%
  const open = tasks.filter((t) => t.status !== 'done');
  const backTo = `${(locals.currentPath || '/').split('#')[0]}#tasks`;
%>
<div class="card-head">
  <h2>Tasks <span class="muted small">(<%= open.length %> open)</span></h2>
  <a href="/tasks?<%= link.ticket_id ? `ticket=${link.ticket_id}` : `client=${link.client_id}` %>&user=all&view=all" class="link-more">Open in Tasks <%- icon('arrow-right') %></a>
</div>
<details class="report-toggle task-add" <%= tasks.length ? '' : 'open' %>>
  <summary><%- icon('plus') %> Add task</summary>
  <form method="post" action="/tasks" class="form">
    <%- csrfField %>
    <input type="hidden" name="back" value="<%= backTo %>">
    <% if (link.ticket_id) { %><input type="hidden" name="ticket_id" value="<%= link.ticket_id %>"><% } %>
    <% if (link.client_id) { %><input type="hidden" name="client_id" value="<%= link.client_id %>"><% } %>
    <label class="field">
      <span>Task</span>
      <input type="text" name="title" required maxlength="255" placeholder="e.g. Order replacement laptop charger">
    </label>
    <div class="form-row">
      <label class="field"><span>Due</span><input type="datetime-local" name="due_at"></label>
      <label class="field"><span>Remind me</span><input type="datetime-local" name="remind_at"></label>
    </div>
    <div><button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Add task</span></button></div>
  </form>
</details>
<% if (!tasks.length) { %>
  <p class="empty">No tasks yet.</p>
<% } else { %>
  <ul class="task-list task-list-compact">
    <% for (const task of tasks) { %>
      <%- include('task-item', { task, href: `/tasks?task=${task.id}&user=all&view=${task.status === 'done' ? 'completed' : 'all'}`, back: backTo }) %>
    <% } %>
  </ul>
<% } %>
