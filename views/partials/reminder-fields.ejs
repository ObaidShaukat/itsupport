<%#
  Reminder form fields (add and edit). reminder: { note, recipientIds, input } or null
  (new); defaultInput: "YYYY-MM-DDTHH:MM" for a new reminder (tomorrow 09:00 UK, with the
  "Tomorrow morning" pick shown as chosen); users: [{ id, name }]. Editing is pre-filled
  with the saved note, date, time and people. The date (dd/mm/yyyy) and time (HH:MM,
  24-hour) are plain text fields that work without JS; app.js adds the calendar, the
  time list, the quick picks and inline validation ([data-reminder-when]).
%>
<%
  const r = locals.reminder || {};
  const isNew = !locals.reminder;
  const chosen = r.recipientIds && r.recipientIds.length ? r.recipientIds : [currentUser.id];
  const input = r.input || (isNew ? locals.defaultInput : '') || '';
  const [ymd = '', hm = ''] = input.split('T');
  const [yy, mm, dd] = ymd.split('-');
  const dateValue = ymd ? `${dd}/${mm}/${yy}` : '';
  const uid = `rw-${r.id || 'new'}`;
%>
<label class="field">
  <span>Note</span>
  <textarea name="note" rows="2" maxlength="500" placeholder="e.g. Chase the supplier for the replacement part"><%= r.note || '' %></textarea>
</label>
<%- include('reminder-people', { chosen, users }) %>
<div class="field" data-reminder-when>
  <span id="<%= uid %>-label">When <span class="muted">(UK time)</span></span>
  <div class="reminder-picks" role="group" aria-label="Quick picks">
    <button type="button" class="chip" data-pick="1h">In 1 hour</button>
    <button type="button" class="chip" data-pick="afternoon">This afternoon (15:00)</button>
    <button type="button" class="chip" data-pick="tomorrow" <%= isNew ? 'data-default-pick' : '' %>>Tomorrow morning (09:00)</button>
    <button type="button" class="chip" data-pick="monday">Next Monday (09:00)</button>
    <button type="button" class="chip" data-pick="custom">Custom</button>
  </div>
  <div class="when-inputs">
    <div class="when-date" data-date-field>
      <span class="when-icon"><%- icon('calendar') %></span>
      <input type="text" name="remind_date" value="<%= dateValue %>" placeholder="dd/mm/yyyy" inputmode="numeric" maxlength="10" autocomplete="off"
             aria-label="Date (dd/mm/yyyy)" aria-describedby="<%= uid %>-error" pattern="\d{1,2}/\d{1,2}/\d{4}" required>
      <button type="button" class="when-open" data-date-open aria-label="Open calendar" aria-expanded="false" hidden><%- icon('calendar') %></button>
      <div class="date-pop" data-date-pop role="dialog" aria-label="Choose a date" hidden></div>
    </div>
    <div class="when-time" data-time-field>
      <span class="when-icon"><%- icon('clock') %></span>
      <input type="text" name="remind_time" value="<%= hm %>" placeholder="HH:MM" inputmode="numeric" maxlength="5" autocomplete="off"
             aria-label="Time (24-hour, HH:MM)" aria-describedby="<%= uid %>-error" pattern="\d{1,2}:\d{2}" required>
      <ul class="time-list" data-time-list role="listbox" aria-label="Times" hidden></ul>
    </div>
  </div>
  <p class="field-error small" id="<%= uid %>-error" data-when-error role="alert" hidden></p>
</div>
