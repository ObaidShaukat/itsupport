<%#
  Reminder form fields (add and edit). reminder: { note, recipientIds, input } or null;
  users: [{ id, name }]. "For" is one or more people (default: me). Quick picks fill the
  UK date/time field (public/js/app.js).
%>
<% const r = locals.reminder || {}; const chosen = r.recipientIds && r.recipientIds.length ? r.recipientIds : [currentUser.id]; %>
<label class="field">
  <span>Note</span>
  <textarea name="note" rows="2" maxlength="500" placeholder="e.g. Chase the supplier for the replacement part"><%= r.note || '' %></textarea>
</label>
<fieldset class="field reminder-for">
  <legend>For</legend>
  <input type="hidden" name="for_present" value="1">
  <div class="user-checks" role="group">
    <% for (const u of users) { %>
      <label class="user-check">
        <input type="checkbox" name="for_user_ids" value="<%= u.id %>" <%= chosen.includes(u.id) ? 'checked' : '' %>>
        <%- avatar({ id: u.id, name: u.name }, 'xs') %><span><%= u.name %><%= u.id === currentUser.id ? ' (me)' : '' %></span>
      </label>
    <% } %>
  </div>
</fieldset>
<div class="field" data-reminder-when>
  <span>When <span class="muted">(UK time)</span></span>
  <div class="reminder-picks" role="group" aria-label="Quick picks">
    <button type="button" class="chip" data-pick="1h">In 1 hour</button>
    <button type="button" class="chip" data-pick="afternoon">This afternoon (15:00)</button>
    <button type="button" class="chip" data-pick="tomorrow">Tomorrow morning (09:00)</button>
    <button type="button" class="chip" data-pick="monday">Next Monday (09:00)</button>
    <button type="button" class="chip" data-pick="custom">Custom</button>
  </div>
  <input type="datetime-local" name="remind_at" value="<%= r.input || '' %>" required aria-label="Reminder date and time">
</div>
