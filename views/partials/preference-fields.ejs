<%#
  Notifications (any combination of popup / email / desktop) and date format.
  prefs: { notify_channels, date_format }; reminderChannels: labels (src/lib/notify.js);
  dateFormats: app.locals.
%>
<% const ticked = String(prefs.notify_channels || 'popup,email,desktop').split(','); %>
<fieldset class="field choice-group">
  <legend>Notifications</legend>
  <% for (const [key, label] of Object.entries(reminderChannels)) { %>
    <label class="choice">
      <input type="checkbox" name="notify_channels" value="<%= key %>" <%= ticked.includes(key) ? 'checked' : '' %>>
      <span><%= label %></span>
    </label>
  <% } %>
  <small class="muted">How reminders, @mentions and "added to a reminder" reach you. Desktop notifications also need to be turned on in each browser (My profile).</small>
</fieldset>
<fieldset class="field choice-group">
  <legend>Date format</legend>
  <% for (const [key, label] of Object.entries(dateFormats)) { %>
    <label class="choice">
      <input type="radio" name="date_format" value="<%= key %>" <%= (prefs.date_format || 'd_mon_yyyy') === key ? 'checked' : '' %>>
      <span><%= label %></span>
    </label>
  <% } %>
  <small class="muted">Times are always 24-hour UK time.</small>
</fieldset>
