<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <% if (locals.csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
  <% if (locals.currentUser && locals.push && push.enabled) { %><meta name="push-key" content="<%= push.publicKey %>" data-wanted="<%= push.wanted ? '1' : '0' %>"><% } %>
  <title><%= locals.title ? title + ' · ' : '' %>Cleartwo IT Support</title>
  <% if (fonts.needPoppins) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap">
  <% } %>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('icons') %>
<% if (locals.currentUser) { %>
<div class="shell <%= locals.navCollapsed ? 'nav-collapsed' : '' %>" data-shell>
  <input type="checkbox" id="nav-toggle" class="nav-toggle">
  <aside class="sidebar">
    <div class="sidebar-top">
      <a href="/" class="brand">
        <% if (locals.hasLogo) { %>
          <img src="/logo.png" alt="Cleartwo" class="brand-logo">
        <% } else { %>
          <span class="brand-name">Cleartwo</span>
        <% } %>
        <span class="brand-sub">IT Support</span>
        <img src="/favicon.svg" alt="Cleartwo" class="brand-mark">
      </a>
      <button type="button" class="nav-collapse" data-nav-collapse aria-pressed="<%= locals.navCollapsed ? 'true' : 'false' %>" title="<%= locals.navCollapsed ? 'Expand menu' : 'Collapse menu' %>" aria-label="<%= locals.navCollapsed ? 'Expand menu' : 'Collapse menu' %>"><%- icon('left') %></button>
      <label for="nav-toggle" class="nav-button" aria-label="Toggle menu"><%- icon('menu') %></label>
    </div>
    <nav class="nav" aria-label="Main">
      <% const path = (locals.currentPath || '').split('?')[0]; %>
      <% for (const item of navItems) { %>
        <% if (item.group) {
          // Collapsible group (Inventory, Call Switch One): the group of the current page is
          // open and its sub-item highlighted; others remember open / closed (app.js).
          const children = item.key === 'inventory' ? (locals.navInvTabs || []) : (item.children || []);
          const here = locals.nav === item.key;
          const subId = `nav-sub-${item.key}`; %>
          <div class="nav-group <%= here ? 'is-open is-current' : '' %>" data-nav-group="<%= item.key %>">
            <button type="button" class="nav-group-head <%= here ? 'active' : '' %>" data-nav-group-toggle aria-expanded="<%= here ? 'true' : 'false' %>" aria-controls="<%= subId %>" title="<%= item.label %>">
              <%- icon(item.icon) %><span class="nav-group-label"><%= item.label %></span><span class="nav-chevron" aria-hidden="true"><%- icon('right') %></span>
            </button>
            <div class="nav-sub-outer" id="<%= subId %>">
              <div class="nav-sub">
                <span class="nav-flyout-title"><%= item.label %></span>
                <% for (const c of children) {
                  const active = path === c.href || path.startsWith(`${c.match || c.href}/`); %>
                  <a href="<%= c.href %>" class="<%= here && active ? 'active' : '' %>" title="<%= c.label %>" <%- here && active ? 'aria-current="page"' : '' %>><span><%= c.label %></span></a>
                <% } %>
                <% if (!children.length) { %><a href="<%= item.href %>"><span>Open</span></a><% } %>
              </div>
            </div>
          </div>
        <% } else { %>
          <a href="<%= item.href %>" class="<%= locals.nav === item.key ? 'active' : '' %>" title="<%= item.label %>"><%- icon(item.icon) %><span><%= item.label %></span></a>
        <% } %>
      <% } %>
      <div class="nav-foot">
        <a href="/profile" class="whoami <%= locals.nav === 'profile' ? 'active' : '' %>" title="My profile"><%- avatar(currentUser, 'sm') %><span><%= currentUser.name || currentUser.username %></span></a>
        <form method="post" action="/logout">
          <%- locals.csrfField %>
          <button type="submit" class="nav-signout" title="Sign out"><%- icon('logout') %><span>Sign out</span></button>
        </form>
      </div>
    </nav>
  </aside>
  <main class="main">
    <div class="topbar">
      <div class="bell" data-bell>
        <button type="button" class="icon-btn bell-button" aria-haspopup="true" aria-expanded="false" aria-label="Reminders" title="Reminders" data-bell-toggle>
          <%- icon('bell') %><span class="bell-count" data-bell-count hidden>0</span>
        </button>
        <div class="bell-panel card" data-bell-panel hidden>
          <div class="bell-head"><strong>Notifications</strong></div>
          <div class="bell-list" data-bell-list><p class="empty small">Loading…</p></div>
        </div>
      </div>
      <a href="/report" class="topbar-link"><%- icon('calendar') %><span>Today's report</span></a>
      <a href="/profile" class="topbar-link topbar-profile" title="My profile"><%- avatar(currentUser, 'sm') %><span><%= currentUser.name %></span></a>
      <a href="/log-work?back=<%= encodeURIComponent(locals.currentPath || '/') %>" class="btn btn-primary" data-log-work><%- icon('pen') %><span>Log work</span></a>
    </div>
<% } else { %>
<div class="shell shell-bare">
  <main class="main">
<% } %>
    <% if (locals.currentUser && locals.push && push.enabled && push.wanted) { %>
      <div class="push-banner" data-push-banner role="region" aria-label="Desktop notifications" hidden>
        <span class="push-banner-icon" aria-hidden="true"><%- icon('bell') %></span>
        <span class="push-banner-text"><strong>Enable desktop notifications</strong> for reminders, @mentions and reminders you are added to, even when this tab is in the background.</span>
        <button type="button" class="btn btn-primary btn-small" data-push-enable>Enable</button>
        <button type="button" class="icon-btn" data-push-dismiss title="Not now" aria-label="Not now"><%- icon('x') %></button>
      </div>
    <% } %>
    <% if (locals.flash && flash.type !== 'saved') { %>
      <div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>
