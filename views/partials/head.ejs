<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <% if (locals.csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
  <% if (locals.currentUser && locals.spellVersion) { %><meta name="spell-version" content="<%= spellVersion %>"><% } %>
  <% if (locals.currentUser && locals.push && push.enabled) { %><meta name="push-key" content="<%= push.publicKey %>" data-wanted="<%= push.wanted ? '1' : '0' %>"><% } %>
  <title><%= locals.title ? title + ' · ' : '' %>Cleartwo IT Support</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<%#
  The shell: the page sits on the grey ground with one large rounded surface. Top bar = logo,
  pill navigation (groups open a dropdown: [data-menu]), search, notifications bell and the
  avatar menu; the quick-action rail on the left (a bottom bar on phones).
%>
<body class="<%= locals.currentUser ? 'is-app' : 'is-bare' %>">
<a href="#main" class="skip-link">Skip to content</a>
<%- include('icons') %>
<% if (locals.currentUser) { %>
<% const path = (locals.currentPath || '').split('?')[0]; %>
<div class="app" data-shell>
  <header class="topbar">
    <%# Only the round icon turns (8s a turn, faster on hover); "Cleartwo" is text. logo.png has
        the name in it, so the top bar uses the round mark (logo.jpg, else favicon.svg). %>
    <a href="/" class="brand" aria-label="Cleartwo IT Support: dashboard">
      <span class="brand-spin" aria-hidden="true"><span class="brand-spin-fast"><img src="<%= locals.hasLogo ? '/favicon.svg' : (locals.logoMark || '/favicon.svg') %>" alt="" class="brand-mark"></span></span>
      <span class="brand-name">Cleartwo</span>
    </a>

    <nav class="pillnav" aria-label="Main">
      <ul class="pillnav-track">
        <% for (const item of navItems) {
          const here = locals.nav === item.key; %>
          <% if (item.group) {
            const children = item.key === 'inventory' ? (locals.navInvTabs || []) : (item.children || []); %>
            <li class="pillnav-group <%= item.secondary ? 'is-secondary' : '' %>" data-menu>
              <button type="button" class="pill-item <%= here ? 'is-active' : '' %>" data-menu-toggle aria-haspopup="true" aria-expanded="false" <%- here ? 'aria-current="page"' : '' %>>
                <span><%= item.label %></span><span class="pill-caret" aria-hidden="true"><%- icon('down') %></span>
              </button>
              <div class="menu" data-menu-panel hidden>
                <% for (const c of children) {
                  const active = path === c.href || path.startsWith(`${c.match || c.href}/`); %>
                  <a href="<%= c.href %>" class="menu-item <%= here && active ? 'is-active' : '' %>" <%- here && active ? 'aria-current="page"' : '' %>><%= c.label %></a>
                <% } %>
                <% if (!children.length) { %><a href="<%= item.href %>" class="menu-item">Open <%= item.label %></a><% } %>
              </div>
            </li>
          <% } else { %>
            <li class="<%= item.secondary ? 'is-secondary' : '' %>"><a href="<%= item.href %>" class="pill-item <%= here ? 'is-active' : '' %>" <%- here ? 'aria-current="page"' : '' %>><%= item.label %></a></li>
          <% } %>
        <% } %>
        <%# "More": the secondary items, shown instead of them on screens 1024-1439px wide (CSS). %>
        <% const extra = navItems.filter((i) => i.secondary); const extraHere = extra.some((i) => locals.nav === i.key); %>
        <% if (extra.length) { %>
          <li class="pillnav-group pillnav-more" data-menu>
            <button type="button" class="pill-item <%= extraHere ? 'is-active' : '' %>" data-menu-toggle aria-haspopup="true" aria-expanded="false">
              <span>More</span><span class="pill-caret" aria-hidden="true"><%- icon('down') %></span>
            </button>
            <div class="menu" data-menu-panel hidden>
              <% for (const item of extra) { %>
                <% if (item.group) { %>
                  <span class="menu-label"><%= item.label %></span>
                  <% for (const c of (item.key === 'inventory' ? (locals.navInvTabs || []) : (item.children || []))) {
                    const active = locals.nav === item.key && (path === c.href || path.startsWith(`${c.match || c.href}/`)); %>
                    <a href="<%= c.href %>" class="menu-item menu-item-sub <%= active ? 'is-active' : '' %>"><%= c.label %></a>
                  <% } %>
                <% } else { %>
                  <a href="<%= item.href %>" class="menu-item <%= locals.nav === item.key ? 'is-active' : '' %>"><%= item.label %></a>
                <% } %>
              <% } %>
            </div>
          </li>
        <% } %>
      </ul>
    </nav>

    <div class="topbar-tools">
      <div class="tool" data-menu data-search>
        <button type="button" class="round-btn" data-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="Search tickets" title="Search tickets"><%- icon('search') %></button>
        <div class="menu menu-right search-pop" data-menu-panel hidden>
          <form method="get" action="/tickets" role="search" class="search-pop-form">
            <label class="visually-hidden" for="global-search">Search tickets</label>
            <input type="search" id="global-search" name="q" placeholder="Search" autocomplete="off" data-1p-ignore data-lpignore="true">
            <input type="hidden" name="view" value="list">
          </form>
        </div>
      </div>
      <div class="bell tool" data-bell>
        <button type="button" class="round-btn bell-button" aria-haspopup="true" aria-expanded="false" aria-label="Notifications" title="Notifications" data-bell-toggle>
          <%- icon('bell') %><span class="bell-count" data-bell-count hidden>0</span>
        </button>
        <div class="bell-panel card" data-bell-panel hidden>
          <div class="bell-head"><strong>Notifications</strong></div>
          <div class="bell-list" data-bell-list><div class="skeleton-list" aria-label="Loading"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton skeleton-short"></span></div></div>
        </div>
      </div>
      <div class="tool user-menu" data-menu>
        <button type="button" class="avatar-btn" data-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="Account menu for <%= currentUser.name %>" title="<%= currentUser.name %>">
          <%- avatar(currentUser, 'md') %>
        </button>
        <div class="menu menu-right" data-menu-panel hidden>
          <div class="menu-who">
            <%- avatar(currentUser, 'md') %>
            <div><strong><%= currentUser.name || currentUser.username %></strong><% if (currentUser.job_title) { %><span class="muted small"><%= currentUser.job_title %></span><% } %></div>
          </div>
          <a href="/profile" class="menu-item <%= locals.nav === 'profile' ? 'is-active' : '' %>"><%- icon('users') %> My profile</a>
          <a href="/users" class="menu-item <%= locals.nav === 'users' ? 'is-active' : '' %>"><%- icon('users') %> Users</a>
          <a href="/activity" class="menu-item"><%- icon('clock') %> Activity log</a>
          <a href="/settings/dictionary" class="menu-item <%= locals.nav === 'dictionary' ? 'is-active' : '' %>"><%- icon('book') %> Dictionary</a>
          <form method="post" action="/logout" class="menu-form">
            <%- locals.csrfField %>
            <button type="submit" class="menu-item"><%- icon('logout') %> Sign out</button>
          </form>
        </div>
      </div>
    </div>
  </header>

  <aside class="rail" aria-label="Quick actions">
    <a href="/log-work?back=<%= encodeURIComponent(locals.currentPath || '/') %>" class="rail-btn rail-primary" data-log-work data-tip="Log work" aria-label="Log work"><%- icon('pen') %></a>
    <a href="/tickets/new" class="rail-btn" data-tip="New ticket" aria-label="New ticket"><%- icon('plus') %></a>
    <button type="button" class="rail-btn" data-quick-reminder data-tip="Add reminder" aria-label="Add reminder"><%- icon('bell') %></button>
    <a href="/articles/new" class="rail-btn" data-tip="New article" aria-label="New article"><%- icon('book') %></a>
    <a href="/report" class="rail-btn" data-tip="Daily report" aria-label="Daily report"><%- icon('calendar') %></a>
  </aside>

  <main class="main surface" id="main">
<% } else { %>
<div class="app app-bare">
  <main class="main" id="main">
<% } %>
    <% if (locals.currentUser && locals.push && push.enabled && push.wanted) { %>
      <div class="push-banner" data-push-banner role="region" aria-label="Desktop notifications" hidden>
        <span class="push-banner-icon" aria-hidden="true"><%- icon('bell') %></span>
        <span class="push-banner-text"><strong>Enable desktop notifications</strong> for reminders, @mentions and reminders you are added to, even when this tab is in the background.</span>
        <button type="button" class="btn btn-primary btn-small" data-push-enable>Enable</button>
        <button type="button" class="icon-btn" data-push-dismiss title="Not now" aria-label="Not now"><%- icon('x') %></button>
      </div>
    <% } %>
    <% if (locals.flash && flash.type !== 'saved') { %>
      <div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>
