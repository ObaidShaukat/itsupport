<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Tickets</h1>
  </div>
  <div class="actions">
    <a href="/tickets/new" class="btn btn-primary"><%- icon('plus') %><span>New ticket</span></a>
  </div>
</header>

<%- include('../partials/search', { target: '#ticket-list', placeholder: 'Search by number, title, client, priority or user' }) %>

<section class="card" id="ticket-list">
  <%- include('../partials/ticket-filters', { controls }) %>
  <%- include('../partials/ticket-table', { tickets, controls, filtered: Boolean(state.status || state.priority) }) %>
</section>
<%- include('../partials/foot') %>
