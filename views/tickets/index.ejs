<%- include('../partials/head') %>
<%#
  Tickets: List (the default; the user's last choice is remembered) or Board (drag a card to
  another column to change its status). One filter row: priority pills, client, person
  (assigned to) and search. Instant: every ticket is on the page and [data-list] in app.js
  filters, counts and sorts in the browser (no request per key; the address keeps the
  filters). Board / List is a normal link (it is remembered for the user).
%>
<% const filtered = Boolean(state.status || state.priority || state.client || state.person || state.q); %>
<div data-list>
<header class="page-head reveal">
  <div>
    <h1>Tickets</h1>
    <p class="muted"><span data-list-shown><%= tickets.filter((t) => t.visible !== false).length %></span> of <%= tickets.length %> ticket<%= tickets.length === 1 ? '' : 's' %></p>
  </div>
  <div class="actions">
    <nav class="segmented" aria-label="View">
      <a href="<%= controls.href({ view: 'list' }) %>" class="<%= state.view === 'list' ? 'is-active' : '' %>" <%- state.view === 'list' ? 'aria-current="page"' : '' %> data-keep-query><%- icon('menu') %><span>List</span></a>
      <a href="<%= controls.href({ view: 'board' }) %>" class="<%= state.view === 'board' ? 'is-active' : '' %>" <%- state.view === 'board' ? 'aria-current="page"' : '' %> data-keep-query><%- icon('layers') %><span>Board</span></a>
    </nav>
    <a href="/tickets/new" class="btn btn-primary"><%- icon('plus') %><span>New ticket</span></a>
  </div>
</header>

<section class="panel reveal" id="ticket-list">
  <form method="get" action="/tickets" class="filter-row" data-filter-form>
    <input type="hidden" name="view" value="<%= state.view %>">
    <nav class="filters filters-priority" aria-label="Filter by priority" data-list-group="priority">
      <% for (const f of controls.priorityFilters) { %>
        <a href="<%= f.href %>" class="<%= f.active ? 'active' : '' %>" <%= f.key ? '' : 'title="Any priority"' %> data-list-value="<%= f.key || '' %>" <%= f.key ? '' : 'data-list-default' %>>
          <% if (f.key) { %><span class="led led-<%= f.key %>" aria-hidden="true"></span><% } %><%= f.label %> <span class="count"><%= f.count %></span>
        </a>
      <% } %>
    </nav>
    <label class="filter-field">
      <span class="visually-hidden">Client</span>
      <select name="client" data-list-select="client" data-combobox>
        <option value="">All clients</option>
        <% for (const c of clients) { %><option value="<%= c.id %>" <%= Number(state.client) === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
      </select>
    </label>
    <label class="filter-field">
      <span class="visually-hidden">Assigned to</span>
      <select name="person" data-list-select="person">
        <option value="">Anyone</option>
        <option value="none" <%= state.person === 'none' ? 'selected' : '' %>>Not assigned</option>
        <% for (const p of people) { %><option value="<%= p.id %>" <%= Number(state.person) === p.id ? 'selected' : '' %>><%= p.name %></option><% } %>
      </select>
    </label>
    <label class="search-field filter-search">
      <%- icon('search') %>
      <span class="visually-hidden">Search tickets: number, title, client or people</span>
      <input type="search" name="q" value="<%= state.q %>" placeholder="Search" autocomplete="off" data-1p-ignore data-lpignore="true" data-list-search>
    </label>
    <a href="/tickets?view=<%= state.view %>" class="btn btn-ghost btn-small" data-list-clear <%= filtered || state.sort ? '' : 'hidden' %>>Clear filters</a>
  </form>

  <% if (state.view === 'board') { %>
    <%- include('../partials/ticket-board', {
      columns: board, draggable: true,
      moreHref: (status) => controls.href({ view: 'list', status }),
    }) %>
  <% } else { %>
    <nav class="filters" aria-label="Filter by status" data-list-group="status">
      <% for (const f of controls.statusFilters) { %>
        <a href="<%= f.href %>" class="<%= f.active ? 'active' : '' %>" data-list-value="<%= f.key || '' %>" <%= f.key ? '' : 'data-list-default' %>><%= f.label %> <span class="count"><%= f.count %></span></a>
      <% } %>
    </nav>
    <%- include('../partials/ticket-table', { tickets, controls, filtered }) %>
  <% } %>
</section>
</div>
<%- include('../partials/foot') %>
