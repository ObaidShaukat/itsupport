<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Tickets</h1>
  </div>
  <div class="actions">
    <a href="/tickets/new" class="btn btn-primary"><%- icon('plus') %><span>New ticket</span></a>
  </div>
</header>

<%- include('../partials/search', { target: '#ticket-list', placeholder: 'Search by number, title or client' }) %>

<section class="card" id="ticket-list">
  <%- include('../partials/status-filter', { base: '/tickets', counts }) %>
  <%- include('../partials/ticket-table', { tickets, status, showClient: true }) %>
</section>
<%- include('../partials/foot') %>
