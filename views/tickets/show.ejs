<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <p class="crumbs"><a href="/tickets">Tickets</a> / <a href="/clients/<%= ticket.client_id %>"><%= ticket.client_name %></a></p>
    <h1><span class="muted">#<%= ticket.id %></span> <%= ticket.title %></h1>
    <%- include('../partials/record-meta', { meta }) %>
  </div>
  <div class="actions">
    <%- include('../partials/priority', { priority: ticket.priority }) %>
    <%- include('../partials/status', { status: ticket.status }) %>
    <details class="edit edit-right">
      <summary class="btn"><%- icon('edit') %><span>Edit</span></summary>
      <div class="edit-panel">
        <form method="post" action="/tickets/<%= ticket.id %>" class="form">
          <%- csrfField %>
          <label class="field">
            <span>Title</span>
            <input type="text" name="title" value="<%= ticket.title %>" required maxlength="255">
          </label>
          <label class="field">
            <span>Description</span>
            <textarea name="description" rows="5" maxlength="10000"><%= ticket.description || '' %></textarea>
          </label>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
          </div>
        </form>
      </div>
    </details>
    <%- include('../partials/delete', {
      action: `/tickets/${ticket.id}/delete`,
      confirm: `Delete ticket '${ticket.title}'? This cannot be undone.`,
      text: 'Delete',
    }) %>
  </div>
</header>

<div class="grid-2 grid-wide-left">
  <div>
    <section class="card">
      <h2>Description</h2>
      <% if (ticket.description) { %>
        <p class="pre-line"><%= ticket.description %></p>
      <% } else { %>
        <p class="empty">No description.</p>
      <% } %>
    </section>

    <section class="card" id="reminders">
      <%- include('../partials/reminders-panel', { reminders, ticket, users }) %>
    </section>

    <section class="card" id="comments">
      <h2>Comments</h2>
      <% if (!comments.length) { %>
        <p class="empty">No comments yet.</p>
      <% } else { %>
        <ul class="comments">
          <% for (const c of comments) { %>
            <li class="comment">
              <div class="comment-meta"><%- avatar({ id: c.user_id, name: c.username }, 'sm') %><strong><%= c.username || 'Deleted user' %></strong> <span class="muted small"><%= fmtDate(c.created_at) %></span></div>
              <p class="pre-line"><%= c.body %></p>
            </li>
          <% } %>
        </ul>
      <% } %>
      <form method="post" action="/tickets/<%= ticket.id %>/comments" class="form">
        <%- csrfField %>
        <label class="field">
          <span>Add a comment</span>
          <textarea name="body" rows="4" required maxlength="10000"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Post comment</button>
      </form>
    </section>
  </div>

  <div>
    <section class="card">
      <h2>Status</h2>
      <form method="post" action="/tickets/<%= ticket.id %>/status" class="form">
        <%- csrfField %>
        <div class="status-options">
          <% for (const [key, label] of Object.entries(ticketStatuses)) { %>
            <label class="status-option">
              <input type="radio" name="status" value="<%= key %>" <%= ticket.status === key ? 'checked' : '' %>>
              <span class="badge badge-<%= key %>"><%= label %></span>
            </label>
          <% } %>
        </div>
        <button type="submit" class="btn btn-primary">Update status</button>
      </form>
    </section>

    <section class="card">
      <h2>Priority</h2>
      <form method="post" action="/tickets/<%= ticket.id %>/priority" class="form">
        <%- csrfField %>
        <div class="status-options priority-options">
          <% for (const key of ['urgent', 'high', 'normal', 'low']) { %>
            <label class="status-option">
              <input type="radio" name="priority" value="<%= key %>" <%= ticket.priority === key ? 'checked' : '' %>>
              <%- include('../partials/priority', { priority: key }) %>
            </label>
          <% } %>
        </div>
        <button type="submit" class="btn btn-primary">Update priority</button>
      </form>
    </section>

    <section class="card">
      <h2>Status &amp; priority history</h2>
      <ul class="timeline">
        <% for (const h of history) { %>
          <li>
            <div>
              <% if (h.new_priority) { %>
                Priority <%= ticketPriorities[h.old_priority] || '' %> <%- icon('arrow-right') %> <strong><%= ticketPriorities[h.new_priority] %></strong>
              <% } else if (h.old_status) { %>
                <%= ticketStatuses[h.old_status] %> <%- icon('arrow-right') %> <strong><%= ticketStatuses[h.new_status] %></strong>
              <% } else { %>
                Created as <strong><%= ticketStatuses[h.new_status] %></strong>
              <% } %>
            </div>
            <div class="muted small"><%= h.username || 'Deleted user' %> · <%= fmtDate(h.created_at) %></div>
          </li>
        <% } %>
      </ul>
    </section>

    <section class="card">
      <%- include('../partials/history', { entries: activity.slice().reverse(), open: true }) %>
    </section>
  </div>
</div>
<%- include('../partials/foot') %>
