<%- include('../partials/head') %>
<%
  const page = `/tickets/${ticket.id}`;
  const commentCount = comments.length;
  const iso = (d) => (d ? new Date(d).toISOString() : '');
  const when = (d) => `<time datetime="${iso(d)}" title="${fmtDate(d)}">${fmtAgo(d)}</time>`;
%>
<header class="tk-head">
  <div class="tk-head-main">
    <p class="crumbs"><a href="/tickets">Tickets</a> / <a href="/clients/<%= ticket.client_id %>"><%= ticket.client_name %></a></p>
    <h1 class="tk-title"><span class="tk-no">#<%= ticket.id %></span> <%= ticket.title %></h1>
    <div class="tk-controls">
      <a class="tk-client" href="/clients/<%= ticket.client_id %>" title="Open client"><%- icon('briefcase') %><span><%= ticket.client_name %></span></a>
      <form method="post" action="<%= page %>/status" class="tk-inline" data-autosubmit>
        <%- csrfField %>
        <label class="visually-hidden" for="tk-status">Status</label>
        <select id="tk-status" name="status" class="pill-select status-select is-<%= ticket.status %>">
          <% for (const [key, label] of Object.entries(ticketStatuses)) { %>
            <option value="<%= key %>" <%= ticket.status === key ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
        <noscript><button type="submit" class="btn btn-small">Save</button></noscript>
      </form>
      <form method="post" action="<%= page %>/priority" class="tk-inline" data-autosubmit>
        <%- csrfField %>
        <label class="visually-hidden" for="tk-priority">Priority</label>
        <select id="tk-priority" name="priority" class="pill-select priority-select is-<%= ticket.priority %>">
          <% for (const key of ['urgent', 'high', 'normal', 'low']) { %>
            <option value="<%= key %>" <%= ticket.priority === key ? 'selected' : '' %>><%= ticketPriorities[key] %> priority</option>
          <% } %>
        </select>
        <noscript><button type="submit" class="btn btn-small">Save</button></noscript>
      </form>
    </div>
    <p class="tk-sub">
      Opened by <%= ticket.created_by_name || 'Deleted user' %> <%- when(ticket.created_at) %>
      <% if (ticket.updated_at && ticket.updated_by_name) { %> · Updated by <%= ticket.updated_by_name %> <%- when(ticket.updated_at) %><% } %>
    </p>
  </div>
  <div class="actions">
    <details class="edit edit-right">
      <summary class="btn btn-small"><%- icon('edit') %><span>Edit</span></summary>
      <div class="edit-panel edit-panel-wide">
        <form method="post" action="<%= page %>" class="form">
          <%- csrfField %>
          <label class="field">
            <span>Title</span>
            <input type="text" name="title" value="<%= ticket.title %>" required maxlength="255" data-spell>
          </label>
          <label class="field">
            <span>Description</span>
            <textarea name="description" rows="6" maxlength="10000" data-autogrow><%= ticket.description || '' %></textarea>
          </label>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
            <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
          </div>
        </form>
      </div>
    </details>
    <form method="post" action="<%= page %>/delete" class="inline" data-confirm="Delete ticket '<%= ticket.title %>' with its comments and attachments? This cannot be undone.">
      <%- csrfField %>
      <button type="submit" class="btn btn-small btn-danger"><%- icon('trash') %><span>Delete</span></button>
    </form>
  </div>
</header>

<div class="tk-layout">
  <div class="tk-main">
    <section class="card tk-card" aria-labelledby="tk-desc-title">
      <h2 class="tk-section-title" id="tk-desc-title">Description</h2>
      <% if (ticket.description) { %>
        <div class="tk-description pre-line"><%= ticket.description %></div>
      <% } else { %>
        <p class="empty small">No description.</p>
      <% } %>
    </section>

    <section class="tk-timeline" id="timeline" aria-labelledby="tk-feed-title">
      <h2 class="tk-section-title" id="tk-feed-title">Activity <span class="muted">· <%= commentCount %> comment<%= commentCount === 1 ? '' : 's' %></span></h2>
      <ol class="tk-feed" id="comments">
        <% for (const entry of timeline) { %>
          <% if (entry.type === 'event') { const h = entry.item; %>
            <li class="tk-event">
              <span class="tk-event-icon" aria-hidden="true"><%- icon(h.new_priority ? 'flag' : h.old_status ? 'arrow-right' : 'plus') %></span>
              <span class="tk-event-text">
                <strong><%= h.username || 'Deleted user' %></strong>
                <% if (h.new_priority) { %>
                  changed priority <%= ticketPriorities[h.old_priority] || '' %> → <strong><%= ticketPriorities[h.new_priority] %></strong>
                <% } else if (h.old_status) { %>
                  changed status <%- include('../partials/status', { status: h.old_status }) %> → <%- include('../partials/status', { status: h.new_status }) %>
                <% } else { %>
                  opened the ticket
                <% } %>
                <span class="muted">· <%- when(h.created_at) %></span>
              </span>
            </li>
          <% } else { const c = entry.item; const mine = c.user_id === currentUser.id; %>
            <li class="tk-comment" id="comment-<%= c.id %>">
              <span class="tk-comment-avatar"><%- avatar({ id: c.user_id, name: c.username }, 'sm') %></span>
              <article class="tk-bubble">
                <header class="tk-bubble-head">
                  <strong><%= c.username || 'Deleted user' %></strong>
                  <span class="muted"><%- when(c.created_at) %><% if (c.updated_at) { %> · <span title="Edited <%= fmtDate(c.updated_at) %>">edited</span><% } %></span>
                  <% if (mine) { %>
                    <div class="tk-bubble-actions">
                      <details class="edit edit-right">
                        <summary class="icon-btn" title="Edit comment" aria-label="Edit comment"><%- icon('edit') %></summary>
                        <div class="edit-panel edit-panel-wide">
                          <form method="post" action="<%= page %>/comments/<%= c.id %>" class="form">
                            <%- csrfField %>
                            <input type="hidden" name="mention_ids" value="">
                            <div class="field">
                              <span>Comment</span>
                              <div class="mention-box" data-mention-box>
                                <div class="mention-backdrop" aria-hidden="true"></div>
                                <textarea name="body" rows="4" maxlength="10000" data-autogrow aria-label="Comment" placeholder="Type @ to mention someone"><%= c.body %></textarea>
                              </div>
                            </div>
                            <template data-mention-users>
                              <% for (const u of mentionable) { %><li role="option" data-id="<%= u.id %>" data-name="<%= u.name %>"><%- avatar({ id: u.id, name: u.name }, 'xs') %><span><%= u.name %></span></li><% } %>
                            </template>
                            <div class="form-actions">
                              <button type="submit" class="btn btn-primary"><%- icon('check') %><span>Save</span></button>
                              <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                            </div>
                          </form>
                        </div>
                      </details>
                      <form method="post" action="<%= page %>/comments/<%= c.id %>/delete" class="inline" data-confirm="Delete this comment<%= c.files.length ? ' and its attachments' : '' %>? This cannot be undone.">
                        <%- csrfField %>
                        <button type="submit" class="icon-btn icon-btn-danger" title="Delete comment" aria-label="Delete comment"><%- icon('trash') %></button>
                      </form>
                    </div>
                  <% } %>
                </header>
                <% if (c.body) { %><div class="tk-bubble-body pre-line"><%- c.html %></div><% } %>
                <% if (c.files.length) { %><div class="tk-bubble-files"><%- include('../partials/attachment-list', { files: c.files, ticketId: ticket.id, back: `${page}#comment-${c.id}` }) %></div><% } %>
              </article>
            </li>
          <% } %>
        <% } %>
      </ol>

      <form method="post" action="<%= page %>/comments" enctype="multipart/form-data" class="tk-composer" id="composer" data-composer data-dropzone data-paste-files>
        <%- csrfField %>
        <input type="hidden" name="mention_ids" value="">
        <span class="tk-comment-avatar"><%- avatar({ id: currentUser.id, name: currentUser.name }, 'sm') %></span>
        <div class="tk-composer-box">
          <label for="tk-comment" class="visually-hidden">Add a comment</label>
          <div class="mention-box" data-mention-box>
            <div class="mention-backdrop" aria-hidden="true"></div>
            <textarea id="tk-comment" name="body" rows="2" maxlength="10000" autocomplete="off" data-autogrow
                      placeholder="Write a comment… type @ to mention someone, paste or drop files"></textarea>
          </div>
          <div class="tk-composer-bar">
            <%- include('../partials/file-drop', { id: 'tk-comment-files', label: 'Attach' }) %>
            <span class="muted small tk-composer-hint"><kbd>Ctrl</kbd>+<kbd>Enter</kbd> to post</span>
            <button type="submit" class="btn btn-primary btn-small"><%- icon('send') %><span>Post</span></button>
          </div>
          <p class="field-error small" data-composer-error role="alert" hidden>Write a comment or attach a file.</p>
          <div class="tk-drop-hint" aria-hidden="true"><%- icon('upload') %><span>Drop files to attach</span></div>
        </div>
        <template data-mention-users>
          <% for (const u of mentionable) { %>
            <li role="option" data-id="<%= u.id %>" data-name="<%= u.name %>"><%- avatar({ id: u.id, name: u.name }, 'xs') %><span><%= u.name %></span></li>
          <% } %>
        </template>
      </form>
    </section>
  </div>

  <aside class="tk-side" aria-label="Ticket details">
    <section class="card tk-card">
      <h2 class="tk-section-title">Details</h2>
      <dl class="tk-details">
        <dt>Client</dt><dd><a href="/clients/<%= ticket.client_id %>"><%= ticket.client_name %></a></dd>
        <dt>Status</dt><dd><%- include('../partials/status', { status: ticket.status }) %></dd>
        <dt>Priority</dt><dd><%- include('../partials/priority', { priority: ticket.priority }) %></dd>
        <dt>Assigned to</dt>
        <dd>
          <form method="post" action="<%= page %>/assign" class="tk-inline tk-assign" data-autosubmit>
            <%- csrfField %>
            <label class="visually-hidden" for="tk-assigned">Assigned to</label>
            <span class="tk-assign-avatar"><% if (ticket.assigned_to_name) { %><%- avatar({ id: ticket.assigned_to, name: ticket.assigned_to_name }, 'xs') %><% } %></span>
            <select id="tk-assigned" name="assigned_to" class="pill-select">
              <option value="" <%= ticket.assigned_to ? '' : 'selected' %>>Not assigned</option>
              <% for (const p of people) { %><option value="<%= p.id %>" <%= ticket.assigned_to === p.id ? 'selected' : '' %>><%= p.name %></option><% } %>
            </select>
            <noscript><button type="submit" class="btn btn-small">Save</button></noscript>
          </form>
        </dd>
        <dt>Created by</dt><dd><span class="person"><%- avatar({ id: ticket.created_by, name: ticket.created_by_name }, 'xs') %><%= ticket.created_by_name || 'Deleted user' %></span></dd>
        <dt>Created</dt><dd title="<%= fmtDate(ticket.created_at) %>"><%= fmtShort(ticket.created_at) %></dd>
        <dt>Updated by</dt><dd><% if (ticket.updated_by_name) { %><span class="person"><%- avatar({ id: ticket.updated_by, name: ticket.updated_by_name }, 'xs') %><%= ticket.updated_by_name %></span><% } else { %>–<% } %></dd>
        <dt>Updated</dt><dd title="<%= fmtDate(ticket.updated_at) %>"><%= fmtShort(ticket.updated_at) %></dd>
      </dl>
    </section>

    <section class="card tk-card tk-reminders is-inverted <%= reminderToday ? 'is-ringing' : '' %>" id="reminders">
      <%- include('../partials/reminders-panel', { reminders, ticket, users }) %>
    </section>

    <section class="card tk-card tk-attachments" id="attachments">
      <div class="card-head">
        <h2 class="tk-section-title"><%- icon('paperclip') %> Attachments <span class="muted small">(<%= files.length %>)</span></h2>
      </div>
      <form method="post" action="<%= page %>/attachments" enctype="multipart/form-data" class="tk-attach-form" data-dropzone data-attach-form>
        <%- csrfField %>
        <input type="hidden" name="back" value="<%= page %>#attachments">
        <div class="tk-dropzone">
          <%- icon('upload') %>
          <span>Drop files here or</span>
          <%- include('../partials/file-drop', { id: 'tk-ticket-files', label: 'Choose files' }) %>
        </div>
        <p class="muted small">Images, PDFs, Office documents, zip, logs, videos. Max 100 MB each.</p>
        <div class="form-actions" data-attach-actions hidden>
          <button type="submit" class="btn btn-primary btn-small"><%- icon('upload') %><span>Upload</span></button>
        </div>
      </form>
      <% if (files.length) { %>
        <%- include('../partials/attachment-list', { files, ticketId: ticket.id, back: `${page}#attachments`, showWho: true }) %>
      <% } else { %>
        <p class="empty small">No attachments yet.</p>
      <% } %>
    </section>

    <section class="card tk-card">
      <%- include('../partials/history', { entries: activity.slice().reverse(), open: false }) %>
    </section>
  </aside>
</div>
<%- include('../partials/lightbox') %>
<%- include('../partials/foot') %>
