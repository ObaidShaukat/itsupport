<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Services</h1>
    <p class="muted">Categories, services and the steps for each one.</p>
  </div>
</header>

<%- include('../partials/search', { target: '#service-list', placeholder: 'Search categories and services' }) %>

<section class="card">
  <h2>Add category</h2>
  <form method="post" action="/categories" class="inline-form">
    <%- csrfField %>
    <label class="field field-grow">
      <span>Category name</span>
      <input type="text" name="name" required maxlength="150">
    </label>
    <button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Add</span></button>
  </form>
</section>

<% if (!categories.length) { %>
  <p class="empty">No categories yet. Add one above, or run <code>npm run seed</code>.</p>
<% } %>

<div id="service-list">
  <p class="empty card" data-filter-empty hidden>No categories or services match your search.</p>
  <div class="category-grid">
    <% for (const category of categories) { %>
      <section class="card" id="category-<%= category.id %>" data-filter-group>
        <div class="card-head">
          <h2 data-filter-label><a href="/categories/<%= category.id %>"><%= category.name %></a></h2>
        </div>
        <% if (!category.services.length) { %>
          <p class="empty">No services yet.</p>
        <% } else { %>
          <ul class="rows rows-compact">
            <% for (const s of category.services) { %>
              <li class="row" data-filter-item data-search="<%= s.name %>">
                <div class="row-main">
                  <a href="/services/<%= s.id %>"><%= s.name %></a>
                  <span class="muted small"><%= Number(s.step_count) %> step<%= Number(s.step_count) === 1 ? '' : 's' %></span>
                </div>
              </li>
            <% } %>
          </ul>
        <% } %>
        <a href="/categories/<%= category.id %>" class="link-more">Manage category <%- icon('arrow-right') %></a>
      </section>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
