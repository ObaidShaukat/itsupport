<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Tasks</h1>
    <p class="muted"><%= views.find((v) => v.active).label %><%= userParam === 'all' ? ' · everyone' : userParam === 'me' ? ' · assigned to me' : '' %></p>
  </div>
</header>

<div class="tasks-layout <%= open ? 'has-panel' : '' %>">
  <nav class="task-views card" aria-label="Task views">
    <% for (const v of views) { %>
      <a href="<%= v.href %>" class="<%= v.active ? 'active' : '' %> task-view-<%= v.key %>">
        <span><%= v.label %></span><span class="count"><%= v.count %></span>
      </a>
    <% } %>
  </nav>

  <section class="task-main-col">
    <form method="get" action="/tasks" class="card task-filters">
      <input type="hidden" name="view" value="<%= view %>">
      <label class="field">
        <span>Assigned to</span>
        <select name="user">
          <option value="" <%= userParam === 'me' ? 'selected' : '' %>>Me</option>
          <option value="all" <%= userParam === 'all' ? 'selected' : '' %>>Everyone</option>
          <% for (const u of users) { %>
            <option value="<%= u.id %>" <%= userParam === u.id ? 'selected' : '' %>><%= u.username %></option>
          <% } %>
        </select>
      </label>
      <label class="field">
        <span>Client</span>
        <select name="client">
          <option value="">Any client</option>
          <% for (const c of clients) { %>
            <option value="<%= c.id %>" <%= filters.clientId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% } %>
        </select>
      </label>
      <label class="field">
        <span>Ticket</span>
        <select name="ticket">
          <option value="">Any ticket</option>
          <% for (const t of tickets) { %>
            <option value="<%= t.id %>" <%= filters.ticketId === t.id ? 'selected' : '' %>>#<%= t.id %> <%= t.title %></option>
          <% } %>
        </select>
      </label>
      <button type="submit" class="btn">Apply</button>
    </form>

    <form method="post" action="/tasks" class="quick-add">
      <%- csrfField %>
      <input type="hidden" name="back" value="<%= listPath %>">
      <input type="hidden" name="quick_view" value="<%= view %>">
      <% if (filters.clientId) { %><input type="hidden" name="client_id" value="<%= filters.clientId %>"><% } %>
      <% if (filters.ticketId) { %><input type="hidden" name="ticket_id" value="<%= filters.ticketId %>"><% } %>
      <span class="quick-add-icon" aria-hidden="true"><%- icon('plus') %></span>
      <label class="visually-hidden" for="quick-add-title">Add a task</label>
      <input type="text" id="quick-add-title" name="title" maxlength="255" required autocomplete="off"
        placeholder="Add a task<%= view === 'my-day' ? ' for today' : view === 'important' ? ' (important)' : '' %>, then press Enter">
    </form>

    <%- include('../partials/search', { target: '#task-list', placeholder: 'Search tasks' }) %>

    <div id="task-list" class="card">
      <% if (!tasks.length) { %>
        <p class="empty"><%= view === 'completed' ? 'No completed tasks yet.' : 'Nothing here. Add a task above.' %></p>
      <% } else { %>
        <p class="empty" data-filter-empty hidden>No tasks match your search.</p>
        <ul class="task-list">
          <% for (const task of tasks) { %>
            <%- include('../partials/task-item', { task, href: taskHref(task.id), back: listPath, selected: open && open.id === task.id }) %>
          <% } %>
        </ul>
      <% } %>
    </div>
  </section>

  <% if (open) { %>
    <aside class="task-panel card" aria-label="Task details" data-task-panel>
      <div class="card-head">
        <h2>Task details</h2>
        <a href="<%= closeHref %>" class="icon-btn" aria-label="Close" title="Close" data-panel-close><%- icon('x') %></a>
      </div>
      <form method="post" action="/tasks/<%= open.id %>" class="form">
        <%- csrfField %>
        <input type="hidden" name="back" value="<%= taskHref(open.id) %>">
        <label class="field">
          <span>Title</span>
          <input type="text" name="title" value="<%= open.title %>" required maxlength="255">
        </label>
        <label class="checkbox-field">
          <input type="checkbox" name="important" value="1" <%= open.important ? 'checked' : '' %>>
          <span>Important</span>
        </label>
        <div class="form-row">
          <label class="field"><span>Due</span><input type="datetime-local" name="due_at" value="<%= openInputs.due_at %>"></label>
          <label class="field"><span>Remind me</span><input type="datetime-local" name="remind_at" value="<%= openInputs.remind_at %>"></label>
        </div>
        <label class="field">
          <span>Assigned to</span>
          <select name="assigned_to">
            <option value="">Unassigned</option>
            <% for (const u of users) { %>
              <option value="<%= u.id %>" <%= open.assigned_to === u.id ? 'selected' : '' %>><%= u.username %></option>
            <% } %>
          </select>
        </label>
        <label class="field">
          <span>Client</span>
          <select name="client_id">
            <option value="">No client</option>
            <% for (const c of clients) { %>
              <option value="<%= c.id %>" <%= open.client_id === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% } %>
          </select>
        </label>
        <label class="field">
          <span>Ticket</span>
          <select name="ticket_id">
            <option value="">No ticket</option>
            <% for (const t of tickets) { %>
              <option value="<%= t.id %>" <%= open.ticket_id === t.id ? 'selected' : '' %>>#<%= t.id %> <%= t.title %><%= t.client_name ? ` (${t.client_name})` : '' %></option>
            <% } %>
          </select>
          <% if (open.ticket_id) { %><small><a href="/tickets/<%= open.ticket_id %>">Open ticket #<%= open.ticket_id %></a></small><% } %>
        </label>
        <label class="field">
          <span>Notes</span>
          <textarea name="notes" rows="5" maxlength="10000"><%= open.notes || '' %></textarea>
        </label>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save</button>
          <a href="<%= closeHref %>" class="btn btn-ghost">Close</a>
        </div>
      </form>
      <div class="task-panel-foot">
        <form method="post" action="/tasks/<%= open.id %>/toggle" class="inline">
          <%- csrfField %>
          <input type="hidden" name="back" value="<%= taskHref(open.id) %>">
          <button type="submit" class="btn"><%- icon(open.status === 'done' ? 'circle' : 'check-circle') %><span><%= open.status === 'done' ? 'Mark as not done' : 'Mark as done' %></span></button>
        </form>
        <%- include('../partials/delete', { action: `/tasks/${open.id}/delete`, confirm: `Delete the task '${open.title}'? This cannot be undone.`, back: closeHref, text: 'Delete' }) %>
      </div>
      <p class="record-meta">
        <span>Created by <%= open.created_name || 'Deleted user' %> on <%= fmtDate(open.created_at) %></span>
        <% if (open.updated_name) { %><span>Last updated by <%= open.updated_name %> on <%= fmtDate(open.updated_at) %></span><% } %>
      </p>
    </aside>
  <% } %>
</div>
<%- include('../partials/foot') %>
