<%- include('../partials/head') %>
<header class="page-head">
  <div>
    <h1>Users</h1>
    <p class="muted">People who can sign in to the portal. To change your own details, use <a href="/profile">My profile</a>.</p>
  </div>
</header>

<%- include('../partials/search', { target: '#user-list', placeholder: 'Search users' }) %>

<div class="grid-2 grid-wide-left">
  <section class="card" id="user-list">
    <h2>All users</h2>
    <p class="empty" data-filter-empty hidden>No users match your search.</p>
    <ul class="rows">
      <% for (const u of users) { %>
        <li class="row" data-filter-item data-search="<%= u.display_name || '' %> <%= u.username %> <%= u.role %>">
          <div class="row-main">
            <strong><%= u.display_name || u.username %></strong>
            <% if (u.id === currentUser.id) { %><span class="badge badge-you">You</span><% } %>
            <div class="muted small"><%= u.username %></div>
            <div class="muted small"><%= u.role %> · added <%= fmtDate(u.created_at) %><%= u.email_signature ? ' · has an email signature' : '' %></div>
          </div>
          <div class="row-actions">
            <details class="edit">
              <summary class="icon-btn" title="Edit" aria-label="Edit"><%- icon('edit') %></summary>
              <div class="edit-panel edit-panel-wide">
                <form method="post" action="/users/<%= u.id %>" class="form">
                  <%- csrfField %>
                  <h3 class="edit-section">Details</h3>
                  <label class="field">
                    <span>Display name</span>
                    <input type="text" name="display_name" value="<%= u.display_name || '' %>" maxlength="100" placeholder="<%= u.username %>">
                  </label>
                  <label class="field">
                    <span>Email / username</span>
                    <input type="text" name="username" value="<%= u.username %>" required maxlength="100">
                  </label>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                  </div>
                </form>
                <form method="post" action="/users/<%= u.id %>/password" class="form">
                  <%- csrfField %>
                  <h3 class="edit-section">Password</h3>
                  <label class="field">
                    <span>New password</span>
                    <input type="password" name="password" required minlength="8" autocomplete="new-password">
                  </label>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Reset password</button>
                    <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                  </div>
                </form>
                <form method="post" action="/users/<%= u.id %>/signature" class="form">
                  <%- csrfField %>
                  <h3 class="edit-section">Email signature</h3>
                  <%- include('../partials/signature-editor', { value: u.email_signature }) %>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save signature</button>
                    <button type="button" class="btn btn-ghost" data-cancel>Cancel</button>
                  </div>
                </form>
              </div>
            </details>
            <% if (u.id !== currentUser.id) { %>
              <%- include('../partials/delete', { action: `/users/${u.id}/delete`, confirm: `Delete user "${u.display_name || u.username}"?` }) %>
            <% } %>
          </div>
        </li>
      <% } %>
    </ul>
  </section>

  <section class="card">
    <h2>Add user</h2>
    <form method="post" action="/users" class="form">
      <%- csrfField %>
      <label class="field">
        <span>Email / username</span>
        <input type="text" name="username" required maxlength="100" autocomplete="off" placeholder="e.g. obaid@cleartwo.co.uk">
        <small class="muted">Used to sign in.</small>
      </label>
      <label class="field">
        <span>Display name</span>
        <input type="text" name="display_name" maxlength="100" autocomplete="off" placeholder="e.g. Obaid">
        <small class="muted">Shown on reports, tickets and history. Leave blank to show the username.</small>
      </label>
      <label class="field">
        <span>Password</span>
        <input type="password" name="password" required minlength="8" autocomplete="new-password">
        <small class="muted">At least 8 characters.</small>
      </label>
      <div class="field">
        <span>Email signature <span class="muted">(optional)</span></span>
        <%- include('../partials/signature-editor', { value: '' }) %>
        <small class="muted">Added to the bottom of Daily Reports this user emails.</small>
      </div>
      <button type="submit" class="btn btn-primary"><%- icon('plus') %><span>Add user</span></button>
    </form>
  </section>
</div>
<%- include('../partials/foot') %>
