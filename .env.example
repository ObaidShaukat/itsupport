# Copy to .env and fill in. Never commit .env.
PORT=5009

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=itsupport

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional. Set to true when served over HTTPS / behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# Email (SMTP). Port 587 uses STARTTLS. If any of these is missing, sending is turned
# off and the portal says so (reminders still pop up in the portal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Cleartwo IT Support
# Address of the portal, used for links in emails, e.g. https://support.cleartwo.co.uk
APP_URL=

# Inventory password and PIN fields are encrypted with this key (AES-256-GCM).
# 64 hexadecimal characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy (e.g. in 1Password). If it is lost or changed, saved passwords cannot be read.
ENCRYPTION_KEY=

# Optional. Where uploaded files are stored (default: ./uploads). Keep it outside public/.
UPLOAD_DIR=
