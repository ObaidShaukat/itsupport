# Copy to .env and fill in. Never commit .env.
PORT=5009

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=itsupport

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional. Set to true when served over HTTPS / behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# Email (SMTP). Port 587 uses STARTTLS. If any of these is missing, sending is turned
# off and the portal says so (reminders still pop up in the portal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Cleartwo IT Support
# Address of the portal, used for links in emails, e.g. https://support.cleartwo.co.uk
APP_URL=

# Inventory password and PIN fields are encrypted with this key (AES-256-GCM).
# 64 hexadecimal characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy (e.g. in 1Password). If it is lost or changed, saved passwords cannot be read.
ENCRYPTION_KEY=

# Desktop notifications (Web Push). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# and keep it: changing the keys means everyone has to turn desktop notifications on again.
# VAPID_SUBJECT is a contact address for the push services: mailto:it@cleartwo.co.uk
# Leave empty to turn desktop notifications off. Browsers only allow them over https (or localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# GDAP expiry monitoring (read only, Microsoft Graph app-only). An Entra ID app registration in
# the partner tenant with the APPLICATION permission DelegatedAdminRelationship.Read.All
# (admin consent granted) and a client secret. Leave empty to show "GDAP not configured".
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Call Switch One customer sync (read only, GET only). CS1_API_URL = the full https URL of
# the customer list endpoint from the CallSwitch One API docs (Customer Management /
# Storefronts). CS1_API_AUTH: bearer (default), basic (token = user:password) or a header
# name such as X-Api-Key. Check with: npm run cs1-fields
CS1_API_URL=
CS1_API_TOKEN=
CS1_API_AUTH=bearer

# Optional. Where uploaded files are stored (default: ./uploads). Keep it outside public/.
UPLOAD_DIR=
