# Copy to .env and fill in. Never commit .env.
PORT=5009

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=itsupport

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional. Set to true when served over HTTPS / behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false
